$Assign("x", $Num(10))	"x"
$Assign("y", $Num(1))	"y"
$Assign("z", $Num(4))	"z"
$Assign("y", $Num(2))	"y"
$Assign("z", $Add($Var("z"), $Var("y")))	"z"
$Assign("y", $Num(3))	"y"
$Assign("z", $Add($Var("z"), $Var("y")))	"z"
$Assign("x", $Add($Var("x"), $Num(100)))	"x"
$Assign("x", $Add($Var("x"), $Var("z")))	"x"