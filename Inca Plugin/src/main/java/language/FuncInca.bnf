{
  parserClass="language.parser.FuncIncaParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="FuncInca"
  psiImplClassSuffix="Impl"
  psiPackage="language.psi"
  psiImplPackage="language.psi.impl"

  elementTypeHolderClass="language.psi.FuncIncaTypes"
  elementTypeClass="language.psi.FuncIncaElementType"
  tokenTypeClass="intellij.sdk.language.psi.FuncIncaTokenType"

  tokens = [
    space = "regexp:\s+"                    // any possible whitespaces: [ \t\n\x0B\f\r]
    valid_id = "regexp:[a-zA-Z]\w*"         // starts with any letter, continues with word characters [a-zA-Z_0-9]
    string = "regexp:\".*\""                // any number of any characters between quotation marks
    scala_term = "regexp:`.*`"              // any Number of any characters between ticks ` and `
    number = "regexp:-?\d+"                 // positive or negative numbers with digits \d = [0-9], integer or long
    double = "regexp:-?\d+(\.\d+)?"
    line_comment = "regexp://.*"            // any number of any characters after // (. means any character)
    block_comment = "regexp:/\*(.|\n)*\*/"  // any number of any characters or line breaks after /* and before */
    ]

}

module ::= 'module' id import* module_content* {pin = 1}
import ::= 'import' id {pin = 1}
id ::=  valid_id
// !('if' | 'let' | 'in' | 'match' | 'fail' | 'Option' | 'None' | 'Some' | 'Set' | 'fold' | 'not' | 'module')
private module_content ::= fun_def | data_def

// definition of functions
fun_def ::= annotation* visibility? 'def' id '(' param_list ')' ':' type_annotation '=' exp {pin = 3}
private param_list ::= (param (',' param)*)?
param ::= id ':' type_annotation
annotation ::= '@main'
visibility ::= 'private'

// definition of datatypes
data_def ::= annotation* visibility? 'data' id '=' data_constructor ('|' data_constructor)* {pin = 3}
data_constructor ::= id '(' (type_annotation (',' type_annotation)*)? ')'

// expressions
exp ::= if_exp | let_exp | member_exp | infix_exp
if_exp ::= 'if' '(' exp ')' exp 'else' exp {pin = 1}
let_exp ::= 'let' (single_let | multiple_let) {pin = 1}
single_let ::= id (':' type_annotation)? '=' infix_exp ' in ' exp
multiple_let ::= '(' id (':' type_annotation)? (',' id (':' type_annotation)?)* ')' '=' infix_exp ' in ' exp
member_exp ::= atomic_exp ' not '? ' in ' infix_exp

private infix_exp ::= cast_exp | base_apply_method_exp | base_apply_infix_exp | match_exp | subinfix_exp
cast_exp ::= subinfix_exp '.as[' data ']'
base_apply_method_exp ::= subinfix_exp '.`' id '`' ( '(' (infix_exp (',' infix_exp)*)? ')' )?
base_apply_infix_exp ::= subinfix_exp op infix_exp
op ::= '+' | '-' | '*' | '/' | '%'
        | '&&' | '||' | '<' | '>' | '=='
        | '++'
match_exp ::=  subinfix_exp ' match ' '{' match_case* '}' {pin = 2}
match_case ::= 'case' pattern '=>' exp
private pattern ::= option_pattern | constructor_pattern
option_pattern ::= 'None' | 'Some'
constructor_pattern ::= id '(' (id (',' id)*)? ')'

private subinfix_exp ::= call-exp | lambda_exp | atomic_exp
call-exp ::= atomic_exp '(' (exp (',' exp)*)? ')'
lambda_exp ::= lambda_vars '=>' exp {pin = 2}
lambda_vars ::= '(' (id ':' type_annotation (',' id ':' type_annotation)*)? ')'

private atomic_exp ::= parens_exp | option_exp | comprehension_exp | const_set_exp | tuple_exp | fold_exp
               | base_apply_exp | base_lit_exp | var | base_apply_unary_exp
parens_exp ::= '(' exp ')'
option_exp ::= 'None' | 'Some' '(' (exp (',' exp)*)? ')'
comprehension_exp ::= '{' subinfix_exp '|' exp (',' exp)* '}'
const_set_exp ::= '{' (exp (',' exp)*)? '}'
tuple_exp ::= '(' exp ',' exp ')'
fold_exp ::= 'fold' ('[' type_annotation ']')? '(' exp ',' exp ',' exp ')'
base_apply_exp ::= scala_term '(' (exp (',' exp)*)? ')'
var ::= id
base_apply_unary_exp ::= '!' infix_exp

// type definitions
private type_annotation ::= fun_type | atomic_type
fun_type ::= atomic_type '=>' type_annotation
atomic_type ::= tuple | 'Any' | 'Nothing' | 'Unit' | option | set | scala_term | data
tuple ::= '(' (type_annotation (',' type_annotation)*)? ')'
option ::= 'Option' '[' type_annotation ']'
set ::= 'Set' '[' type_annotation ']'
data ::= id

// literals
private base_lit_exp ::= numeric_lit | boolean_lit | string_lit | scala_term
numeric_lit ::= number | double
boolean_lit ::= 'true' | 'false'
string_lit ::= string
