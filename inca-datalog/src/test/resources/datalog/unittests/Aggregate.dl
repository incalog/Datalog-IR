Node(String, Int).
Node("A", 3).
Node("A", 4).
Node("B", 10).
Node("B", 2).
Node("C", 5).

NodeSum(String, Int).
NodeSum(X, sum(n)) :- Node(X,n).

NodeMax(String, Int).
NodeMax(X, max(n)) :- Node(X,n).

NodeMin(String, Int).
NodeMin(X, min(n)) :- Node(X,n).

NodeCount(String, Int).
NodeCount(X, count(n)) :- Node(X,n).