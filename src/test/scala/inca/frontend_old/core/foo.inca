module Test_Cast

import syntax inca.analyzedLangs.Exp
import syntax inca.analyzedLangs.GoLang

scala import inca.analyzedData.Nat._

scala type Num = Nat

scala val sumAgg = {
   new inca.runtime.aggregate.Aggregation[Nat] {
     override val name: String = "sum"
     override def init: Nat = Zero
     override def join(v1: Nat, v2: Nat): Nat = v1.add(v2)
     override def unjoin(v1: Nat, v2: Nat): Nat = v1.sub(v2)
     override val isAssociative: Boolean = true
     override val isCommutative: Boolean = true
     override val hasUnjoin: Boolean = true
   }
}


// val x = 1
// val y = x


// import inca.analyzedData.Nat._
// type Num = Nat
// trait X extends Y { val a: Int }
// val sumAgg: ty = ???
// X <: Y
// X <: Y
// X <: Y



def 1_to_10(): `Num` = {
  yield `inca.analyzedData.Nat.Succ`(`inca.analyzedData.Nat.Zero`)
} union {
  val pred = 1_to_10()
  assert `pred.toInt < 10`
  yield `inca.analyzedData.Nat.Succ`(pred)
}

def sum_1_to_10(): `inca.analyzedData.Nat.Nat` = {
  yield aggregate(`sumAgg`) {
    yield 1_to_10()
  }
}