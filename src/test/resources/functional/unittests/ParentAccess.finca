module ParentAccess
data Nat = Zero() | Succ(Nat)

@main def main(): Option[Any] =
 let x = Zero() in
   let y = Succ(x) in
     parent(x)

@main def main2(x: Nat): Option[Any] = x match {
  case Zero() => None
  case Succ(p) => p match {
    case Zero() => None
    case Succ(pp) => parent(pp)
  }
}
