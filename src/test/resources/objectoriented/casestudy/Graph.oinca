module CaseStudy

class Edge {
  var start: String = ""
  var end: String = ""

  def this(s: String, e: String) = {
    this.start = s
    this.end = e
  }
}

class Graph {
    val edges: Set[Edge] = Set(
      new Edge("X", "Y"),
      new Edge("Y", "Z")
      // introduce a cycle
      //new Edge("Z", "X") // macht alles kaputt... warum ?
    )

    @main
    def main(): Set[Edge] = {
      new Graph().path("X")
    }

    def path(x: String): Set[Edge] = {
        (for (d <- this.edges if d.start == x) yield d)
        ++
        (for (i <- this.edges if i.start == x; y <- this.path(i.end)) yield y)
    }
}