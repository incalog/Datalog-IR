class A {

}

class B {

}

class Graph {
    @main
    def main(): Set[A] = {
        val g: Graph = new Graph()
        val a: Set[A] = Set(new A(), new A())
        return g.doSomething(a, 2)
    }

    def doSomething(as: Set[A], i: Int): Set[A] = {
        val dummy: B = new B()
        if (i > 0) {
            val s: Set[A] = for (a <- as) yield a
            return this.doSomething(s, i-1)
        } else {
            return as
        }
    }
}