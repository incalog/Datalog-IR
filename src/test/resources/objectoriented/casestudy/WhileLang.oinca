module WhileLang

class Exp {
    // abstract
    def accept(v: Visitor): Unit = { }

    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        new MConstant(`None`)
    }
}

class Var(val name: String) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        v.visitVar(this)
    }

    @override
    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        m.get(this.name).get()
    }
}

class Num(val num: Int) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        v.visitNum(this)
    }

    @override
    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        new MConstant(`Some`(this.num))
    }
}

class BinOp(val left: Exp, val right: Exp) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        this.left.accept(v)
        this.right.accept(v)
        this.binOpAccept(v)
    }
    // abstract
    def binOpAccept(v: Visitor): Unit = { }

    @override
    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        this.binOpConst(this.left.aevalConst(m), this.right.aevalConst(m))
    }
    // abstract
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1
    }
}
class Add extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitAdd(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.add(c2)
    }
}
class Sub extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitSub(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.sub(c2)
    }
}
class Mul extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitMul(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.mul(c2)
    }
}
class GT extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitGT(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.gt(c2)
    }
}

class Stm {
    // abstract
    def accept(v: Visitor): Unit = {
    }
    def first(): Stm = {
        this
    }
    def last(): Stm = {
        this
    }

    def stringValue(): String = {
        "Stm"
    }
}
class Assign(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitAssign(this)
    }

    @override
    def stringValue(): String = {
        "Assign"
    }
}
class Skip extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        v.visitSkip(this)
    }

    @override
    def stringValue(): String = {
        "Skip"
    }
}
class Sequence(val s1: Stm, val s2: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.s1.accept(v)
        this.s2.accept(v)
        v.visitSequence(this)
    }
    @override
    def first(): Stm = {
        this.s1.first()
    }
    @override
    def last(): Stm = {
        this.s2.last()
    }

    @override
    def stringValue(): String = {
        "Sequence"
    }
}
class If(val cnd: Exp, val thn: Stm, val els: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.thn.accept(v)
        this.els.accept(v)
        v.visitIf(this)
    }

    @override
    def stringValue(): String = {
        "If"
    }
}
class While(val cnd: Exp, val body: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.body.accept(v)
        v.visitWhile(this)
    }

    @override
    def stringValue(): String = {
        "While"
    }
}
class ValDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitValDef(this)
    }

    @override
    def stringValue(): String = {
        "Val"
    }
}
class VarDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitVarDef(this)
    }

    @override
    def stringValue(): String = {
        "Var"
    }
}


class Visitor {
    // Exp
    def visitVar(e: Var): Unit = { }
    def visitNum(e: Num): Unit = { }
    def visitAdd(e: Add): Unit = { }
    def visitSub(e: Sub): Unit = { }
    def visitMul(e: Mul): Unit = {}
    def visitGT(e: GT): Unit = {}

    // Stm
    def visitAssign(s: Assign): Unit = { }
    def visitSkip(s: Skip): Unit = { }
    def visitSequence(s: Sequence): Unit = { }
    def visitIf(s: If): Unit = { }
    def visitWhile(s: While): Unit = { }
    def visitValDef(s: ValDef): Unit = { }
    def visitVarDef(s: VarDef): Unit = { }
}

// Currently we do not support coalescing / uncoalescing of subclasses (aka. dynamic dispatching).
// Therefore we encode NoConstant as MConstant(None).
case class MConstant(val num: `Option[Int]`) {
    def isSomeConstant(): Boolean = {
        val numOption: `Option[Int]` = this.num
        numOption.`isDefined`
    }

    def isNoConstant(): Boolean = {
        val numOption: `Option[Int]` = this.num
        numOption.`isEmpty`
    }

    // Only call this if you know that this is some Constant
    def value(): Int = {
        val numOption: `Option[Int]` = this.num
        numOption.`get`
    }

    def stringValue(): String = {
        if (this.isSomeConstant()) {
            val num: Int = this.value()
            num.`toString`()
        } else {
            "NoConstant"
        }
    }

    def add(that: MConstant): MConstant = {
        if (this.isSomeConstant() && that.isSomeConstant()) {
            new MConstant(`Some`(this.value() + that.value()))
        } else {
            new MConstant(`None`)
        }
    }

    def sub(that: MConstant): MConstant = {
        if (this.isSomeConstant() && that.isSomeConstant()) {
            new MConstant(`Some`(this.value() - that.value()))
        } else {
            new MConstant(`None`)
        }
    }

    def mul(that: MConstant): MConstant = {
        if (this.isSomeConstant() && that.isSomeConstant()) {
            new MConstant(`Some`(this.value() * that.value()))
        } else {
            new MConstant(`None`)
        }
    }

    def gt(that: MConstant): MConstant = {
        if (this.isSomeConstant() && that.isSomeConstant()) {
            if(this.value() > that.value())
                new MConstant(`Some`(1))
            else
                new MConstant(`Some`(0))
        } else {
            new MConstant(`None`)
        }
    }
}

class MConstantMonotone extends BalancedMonotone[MConstant, MConstant] {
    def init(): MConstant = {
        new MConstant(`None`)
    }

    def join(v1: MConstant, v2: MConstant): MConstant = {
        if (v1.num == v2.num) {
            v1
        } else {
            new MConstant(`None`)
        }
    }

    def lift(v: MConstant): MConstant = {
        v
    }

    def get(): MConstant = {
        this.result
    }
}

class FIConstantPropagationVisitor extends Visitor {
    /** The Map type separates keys from aggregated values */
    val vars: MonoMap[String, MConstantMonotone] = new MonoMap[String, MConstantMonotone]()

    @override
    def visitValDef(s: ValDef): Unit = {
        this.vars.get(s.name) += s.rhs.aevalConst(this.vars)
        return
    }

    @override
    def visitVarDef(s: VarDef): Unit = {
        this.vars.get(s.name) += s.rhs.aevalConst(this.vars)
        return
    }

    @override
    def visitAssign(s: Assign): Unit = {
        this.vars.get(s.name) += s.rhs.aevalConst(this.vars)
        return
    }
}

