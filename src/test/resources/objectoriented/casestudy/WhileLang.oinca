class Examples {
    val factorial: Stm =
    new Sequence(new ValDef("m", new Num(3)),
    new Sequence(new Assign("m", new Num(3)),
        new Sequence(new VarDef("n", new Num(5)),
            new Sequence(new VarDef("acc", new Num(1)),
                new While(
                    new GT(new Var("n"), new Num(1)),
                    new Sequence(
                        new Assign("acc", new Mul(new Var("acc"), new Var("n"))),
                        new Assign("n", new Sub(new Var("n"), new Num(1)))
                    )
                )
            )
        )
    )
    )
}

class ConstantPropagation {
    @main
    def factorial(): Set[(String, String)] = {
        val constantProp: FIConstantPropagationVisitor = new FIConstantPropagationVisitor()
        val examples: Examples = new Examples()
        examples.factorial.accept(constantProp)
        // This would be correct if it weren't for the bug, where we need to aggregate a second time
        for (k <- constantProp.vars.keys()) yield (k, constantProp.vars.get(k).get().stringValue())
    }
}

class AdvancedConstantPropagation {
    @main
    def factorial(): Set[(String, String, String, String)] = {
        val constantProp: FSConstantPropagationVisitor = new FSConstantPropagationVisitor()
        val examples: Examples = new Examples()
        examples.factorial.accept(constantProp)

        (for (k <- constantProp.varsBefore.keys(); k2 <- constantProp.varsBefore.get(k).keys())
            yield ("Before", k.stringValue(), k2, constantProp.varsBefore.get(k).get(k2).get().stringValue()))
        ++
        (for (k3 <- constantProp.varsAfter.keys(); k4 <- constantProp.varsAfter.get(k3).keys())
            yield ("After", k3.stringValue(), k4, constantProp.varsAfter.get(k3).get(k4).get().stringValue()))
    }
}
