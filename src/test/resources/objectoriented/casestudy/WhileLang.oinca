module WhileLang

class Exp {
    // abstract
    def accept(v: Visitor): Unit = { }

    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        new NoConstant()
    }
}

class Var(val name: String) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        v.visitVar(this)
    }

    @override
    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        m.get(this.name).result
    }
}

class Num(val num: Int) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        v.visitNum(this)
    }

    @override
    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        new SomeConstant(this.num)
    }
}

class BinOp(val left: Exp, val right: Exp) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        this.left.accept(v)
        this.right.accept(v)
        this.binOpAccept(v)
    }
    // abstract
    def binOpAccept(v: Visitor): Unit = { }

    @override
    def aevalConst(m: MonoMap[String, MConstantMonotone]): MConstant = {
        this.binOpConst(this.left.aevalConst(m), this.right.aevalConst(m))
    }
    // abstract
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1
    }
}
class Add extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitAdd(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.add(c2)
    }
}
class Sub extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitSub(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.sub(c2)
    }
}
class Mul extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitMul(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.mul(c2)
    }
}
class GT extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitGT(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.gt(c2)
    }
}

class Stm {
    // abstract
    def accept(v: Visitor): Unit = {
    }
    def first(): Stm = {
        this
    }
    def last(): Stm = {
        this
    }

    def stringValue(): String = {
        "Stm"
    }
}
class Assign(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitAssign(this)
    }

    @override
    def stringValue(): String = {
        "Assign"
    }
}
class Skip extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        v.visitSkip(this)
    }

    @override
    def stringValue(): String = {
        "Skip"
    }
}
class Sequence(val s1: Stm, val s2: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.s1.accept(v)
        this.s2.accept(v)
        v.visitSequence(this)
    }
    @override
    def first(): Stm = {
        this.s1.first()
    }
    @override
    def last(): Stm = {
        this.s2.last()
    }

    @override
    def stringValue(): String = {
        "Sequence"
    }
}
class If(val cnd: Exp, val thn: Stm, val els: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.thn.accept(v)
        this.els.accept(v)
        v.visitIf(this)
    }

    @override
    def stringValue(): String = {
        "If"
    }
}
class While(val cnd: Exp, val body: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.body.accept(v)
        v.visitWhile(this)
    }

    @override
    def stringValue(): String = {
        "While"
    }
}
class ValDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitValDef(this)
    }

    @override
    def stringValue(): String = {
        "Val"
    }
}
class VarDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitVarDef(this)
    }

    @override
    def stringValue(): String = {
        "Var"
    }
}


class Visitor {
    // Exp
    def visitVar(e: Var): Unit = { }
    def visitNum(e: Num): Unit = { }
    def visitAdd(e: Add): Unit = { }
    def visitSub(e: Sub): Unit = { }
    def visitMul(e: Mul): Unit = {}
    def visitGT(e: GT): Unit = {}

    // Stm
    def visitAssign(s: Assign): Unit = { }
    def visitSkip(s: Skip): Unit = { }
    def visitSequence(s: Sequence): Unit = { }
    def visitIf(s: If): Unit = { }
    def visitWhile(s: While): Unit = { }
    def visitValDef(s: ValDef): Unit = { }
    def visitVarDef(s: VarDef): Unit = { }
}

case class MConstant {
    def join(that: MConstant): MConstant = {
        this
    }

    def num(n: Int): MConstant = {
        new SomeConstant(n)
    }
    def add(that: MConstant): MConstant = {
        this
    }
    def sub(that: MConstant): MConstant = {
        this
    }
    def mul(that: MConstant): MConstant = {
        this
    }
    def gt(that: MConstant): MConstant = {
        this
    }

    def stringValue(): String = {
        "MConstant"
    }
}
case class NoConstant extends MConstant {
    @override
    def stringValue(): String = {
        "NoConstant"
    }
}

case class SomeConstant(val num: Int) extends MConstant {
    @override
    def join(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant] && that.asInstanceOf[SomeConstant].num == this.num) {
            this
        } else {
            new NoConstant()
        }
    }

    @override
    def add(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num + that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    @override
    def sub(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num - that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    @override
    def mul(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num * that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    @override
    def gt(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            if(this.num > that.asInstanceOf[SomeConstant].num)
                new SomeConstant(1)
            else
                new SomeConstant(0)
        } else {
            new NoConstant()
        }
    }

    @override
    def stringValue(): String = {
        "SomeConstant(" + this.num + ")"
    }
}


class MConstantMonotone extends BalancedMonotone[MConstant, MConstant] {
    def init(): MConstant = {
        new NoConstant()
    }

    def join(c1: MConstant, c2: MConstant): MConstant = {
        c1.join(c2)
    }

    def lift(v: MConstant): MConstant = {
        v
    }
}

class FIConstantPropagationVisitor extends Visitor {
    /** The Map type separates keys from aggregated values */
    val vars: MonoMap[String, MConstantMonotone] = new MonoMap[String, MConstantMonotone]()

    @override
    def visitValDef(s: ValDef): Unit = {
        this.vars.get(s.name) += s.rhs.aevalConst(this.vars)
        return
    }

    @override
    def visitVarDef(s: VarDef): Unit = {
        this.vars.get(s.name) += s.rhs.aevalConst(this.vars)
        return
    }

    @override
    def visitAssign(s: Assign): Unit = {
        this.vars.get(s.name) += s.rhs.aevalConst(this.vars)
        return
    }
}

