module WhileLang

class Exp {
    // abstract
    def accept(v: Visitor): Unit = { }

    def aevalConst(m: `Map`[String, MConstant]): MConstant = {
        new NoConstant()
    }
}

class Var extends Exp {
    val name: String
    def this(name: String) = {
        this.name = name
    }

    @override
    def accept(v: Visitor): Unit = {
        v.visitVar(this)
    }

    @override
    def aevalConst(m: `Map[String, MConstant]`): MConstant = {
        m.`getOrElse`(this.name, new NoConstant())
    }
}

class Num extends Exp {
    val num: Int
    def this(num: Int) = {
        this.num = num
    }

    @override
    def accept(v: Visitor): Unit = {
        v.visitNum(this)
    }

    @override
    def aevalConst(m: `Map[String, MConstant]`): MConstant = {
        new SomeConstant(this.num)
    }
}

class BinOp extends Exp {
    val left: Exp
    val right: Exp
    def this(left: Exp, right: Exp) = {
        this.left = left
        this.right = right
    }

    @override
    def accept(v: Visitor): Unit = {
        this.left.accept(v)
        this.right.accept(v)
        this.binOpAccept(v)
    }
    // abstract
    def binOpAccept(v: Visitor): Unit = { }

    @override
    def aevalConst(m: `Map[String, MConstant]`): MConstant = {
        this.binOpConst(this.left.aevalConst(m), this.right.aevalConst(m))
    }
    // abstract
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1
    }
}
class Add extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitAdd(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.add(c2)
    }
}
class Sub extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitSub(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.sub(c2)
    }
}
class Mul extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitMul(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.mul(c2)
    }
}
class GT extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitGT(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.gt(c2)
    }
}

class Stm {
    // abstract
    def accept(v: Visitor): Unit = {
    }
    def first(): Stm = {
        this
    }
    def last(): Stm = {
        this
    }
}
class Assign extends Stm {
    val lhs: String
    val rhs: Exp
    def this(lhs: String, rhs: Exp) = {
        this.lhs = lhs
        this.rhs = rhs
    }
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitAssign(this)
    }
}
class Skip extends Stm {
    def this() = {
    }
    @override
    def accept(v: Visitor): Unit = {
        v.visitSkip(this)
    }
}
class Sequence extends Stm {
    val s1: Stm
    val s2: Stm
    def this(s1: Stm, s2: Stm) = {
        this.s1 = s1
        this.s2 = s2
    }
    @override
    def accept(v: Visitor): Unit = {
        this.s1.accept(v)
        this.s2.accept(v)
        v.visitSequence(this)
    }
    @override
    def first(): Stm = {
        this.s1.first()
    }
    @override
    def last(): Stm = {
        this.s2.last()
    }
}
class If extends Stm {
    val cnd: Exp
    val thn: Stm
    val els: Stm
    def this(cnd: Exp, thn: Stm, els: Stm) = {
        this.cnd = cnd
        this.thn = thn
        this.els = els
    }
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.thn.accept(v)
        this.els.accept(v)
        v.visitIf(this)
    }
}
class While extends Stm {
    val cnd: Exp
    val body: Stm
    def this(cnd: Exp, body: Stm) = {
        this.cnd = cnd
        this.body = body
    }
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.body.accept(v)
        v.visitWhile(this)
    }
}
class ValDef extends Stm {
    val name: String
    val rhs: Exp
    def this(name: String, rhs: Exp) = {
        this.name = name
        this.rhs = rhs
    }
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitValDef(this)
    }
}
class VarDef extends Stm {
    val name: String
    val rhs: Exp
    def this(name: String, rhs: Exp) = {
        this.name = name
        this.rhs = rhs
    }
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitVarDef(this)
    }
}


class Visitor {
    // Exp
    def visitVar(e: Var): Unit = { }
    def visitNum(e: Num): Unit = { }
    def visitAdd(e: Add): Unit = { }
    def visitSub(e: Sub): Unit = { }
    def visitMul(e: Mul): Unit = {}
    def visitGT(e: GT): Unit = {}

    // Stm
    def visitAssign(s: Assign): Unit = { }
    def visitSkip(s: Skip): Unit = { }
    def visitSequence(s: Sequence): Unit = { }
    def visitIf(s: If): Unit = { }
    def visitWhile(s: While): Unit = { }
    def visitValDef(s: ValDef): Unit = { }
    def visitVarDef(s: VarDef): Unit = { }
}

class MConstant {
    def join(that: MConstant): MConstant = {
        this
    }

    def num(n: Int): MConstant = {
        new SomeConstant(n)
    }
    def add(that: MConstant): MConstant = {
        this
    }
    def sub(that: MConstant): MConstant = {
        this
    }
    def mul(that: MConstant): MConstant = {
        this
    }
    def gt(that: MConstant): MConstant = {
        this
    }
}
class NoConstant extends MConstant {
}
class SomeConstant extends MConstant {
    val num: Int
    def this(num: Int) = {
        this.num = num
    }
    @override
    def join(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant] && that.asInstanceOf[SomeConstant].num == this.num) {
            this
        } else {
            new NoConstant()
        }
    }

    def add(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num + that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    def sub(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num - that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    def mul(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num * that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    def gt(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            if(this.num > that.asInstanceOf[SomeConstant].num)
                new SomeConstant(1)
            else
                new SomeConstant(0)
        } else {
            new NoConstant()
        }
    }
}

class MonotoneMap extends BalancedMonotone[(String, Any), `scala.collection.immutable.Map[String, Any]`] {
    def init(): `scala.collection.immutable.Map[String, Any]` = {
        `scala.collection.immutable.Map[String, Any]`()
    }

    def join(m1: `scala.collection.immutable.Map[String, Any]`, m2: `scala.collection.immutable.Map[String, Any]`): `scala.collection.immutable.Map[String, Any]` = {
        m1 ++ m2
        //(m1.`keyset` ++ m2.`keyset`).`map { i => i -> }``
    }

    def lift(pair: (String, MConstant)): `scala.collection.immutable.Map[String, Any]` = {
        `scala.collection.immutable.Map[String, Int]`(pair._1 -> pair._2)
    }

    def get(): `scala.collection.immutable.Map[String, Any]` = {
        this.result
    }
}


