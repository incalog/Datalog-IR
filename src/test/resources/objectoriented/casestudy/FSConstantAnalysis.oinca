class FSConstantAnalysisVisitor extends ValueProvider {
    val varsAfter: MonoMap[`(Any, String)`, MConstant] = new MonoMap[`(Any, String)`, MConstant]()
    val varsBefore: MonoMap[`(Any, String)`, MConstant] = new MonoMap[`(Any, String)`, MConstant]()

    @override
    def getValue(s: Stm, n: String): MConstant = {
        this.varsBefore.get(`Tuple2.apply`(s, n))
    }

    // we can not assign a complete inner map currently... so this is a workaround
    def updateVarsAfter(k: `(Any, String)`, v: MConstant): Unit = {
        this.varsAfter += (k, v)
        return
    }

    def updateVarsBefore(k: `(Any, String)`, v: MConstant): Unit = {
        this.varsBefore += (k, v)
        return
    }

    @override
    def visitValDef(s: ValDef): Unit = {
        this.updateVarsAfter(`Tuple2.apply`(s, s.name), s.rhs.aevalConst(this, s))
        for (bf <- this.varsBefore.keys() if ((bf.`_1` == s) && (bf.`_2` != s.name)))
            yield this.updateVarsAfter(bf, this.varsBefore.get(bf))
        return
    }

    @override
    def visitVarDef(s: VarDef): Unit = {
        this.updateVarsAfter(`Tuple2.apply`(s, s.name), s.rhs.aevalConst(this, s))
        for (bf <- this.varsBefore.keys() if ((bf.`_1` == s) && (bf.`_2` != s.name)))
            yield this.updateVarsAfter(bf, this.varsBefore.get(bf))
        return
    }

    @override
    def visitAssign(s: Assign): Unit = {
        this.updateVarsAfter(`Tuple2.apply`(s, s.name), s.rhs.aevalConst(this, s))
        for (bf <- this.varsBefore.keys() if ((bf.`_1` == s) && (bf.`_2` != s.name)))
            yield this.updateVarsAfter(bf, this.varsBefore.get(bf))
        return
    }

    @override
    def visitSkip(s: Skip): Unit = {
        // this.varsAfter(s) ##= this.varsBefore(s)
        for (bf <- this.varsBefore.keys() if bf.`_1` == s)
            yield this.updateVarsAfter(bf, this.varsBefore.get(bf))
        return
    }

    @override
    def visitSequence(s: Sequence): Unit = {
        // data flow s.s2.first() <- s.s1.last()
        // this.varsBefore(s.s2.first()) ##= this.varsAfter(s.s1.last())

        //for (bf2 <- this.varsAfter.keys() if bf2.`_1` == s.s1.first())
        //    yield this.updateVarsBefore(`Tuple2.apply`(s.s1.last(), bf2.`_2`), this.varsAfter.get(bf2))

        for (bf <- this.varsAfter.keys() if bf.`_1` == s.s1.last())
            yield this.updateVarsBefore(`Tuple2.apply`(s.s2.first(), bf.`_2`), this.varsAfter.get(bf))

        return
    }

    @override
    def visitIf(s: If): Unit = {
        // data flow s.thn.first() <- s
        // data flow s.els.first() <- s
        //this.varsBefore ++= for (kv <- this.varsBefore.get(s)) yield (s.thn.first(), kv)
        for (bf <- this.varsBefore.keys() if bf.`_1` == s)
            yield this.updateVarsBefore(`Tuple2.apply`(s.thn.first(), bf.`_2`), this.varsBefore.get(bf))

        //this.varsBefore ++= for (kv <- this.varsBefore.get(s)) yield (s.els.first(), kv)
        for (bf1 <- this.varsBefore.keys() if bf1.`_1` == s)
            yield this.updateVarsBefore(`Tuple2.apply`(s.els.first(), bf1.`_2`), this.varsBefore.get(bf1))

        //this.varsAfter ++= this.varsBefore.get(s.thn.last())
        for (bf2 <- this.varsBefore.keys() if bf2.`_1` == s.thn.last())
            yield this.updateVarsAfter(`Tuple2.apply`(s, bf2.`_2`), this.varsBefore.get(bf2))

        //this.varsAfter ++= this.varsBefore.get(s.els.last())
        for (bf3 <- this.varsBefore.keys() if bf3.`_1` == s.els.last())
            yield this.updateVarsAfter(`Tuple2.apply`(s, bf3.`_2`), this.varsBefore.get(bf3))
        return
    }

    @override
    def visitWhile(s: While): Unit = {
        // data flow s.body.first() <- s
        // data flow s <- s.body.last()
        //this.varsAfter(s) ##= this.varsBefore(s)
        for (bf <- this.varsBefore.keys() if bf.`_1` == s)
            yield this.updateVarsAfter(bf, this.varsBefore.get(bf))

        //this.varsBefore(s.body.first()) ##= this.varsAfter(s)
        for (bf1 <- this.varsAfter.keys() if bf1.`_1` == s)
            yield this.updateVarsBefore(`Tuple2.apply`(s.body.first(), bf1.`_2`), this.varsAfter.get(bf1))

        //this.varsBefore(s) ##= this.varsAfter(s.body.last())
        for (bf2 <- this.varsAfter.keys() if bf2.`_1` == s)
            yield this.updateVarsBefore(`Tuple2.apply`(s.body.last(), bf2.`_2`), this.varsAfter.get(bf2))

        return
    }
}


class ConstantAnalysis {
    @main
    def main(): Set[(String, String, String, String)] = {
        val constantProp: FSConstantAnalysisVisitor = new FSConstantAnalysisVisitor()
        val examples: Examples = new Examples()
        examples.factorial.accept(constantProp)
        // By using result directly we force the aggregation to appear here. Somehow this fixes the double
        // aggregation error.
        (for (k <- constantProp.varsBefore.keys()) yield ("Before", k.`_1`.asInstanceOf[Stm].stringValue(), k.`_2`, constantProp.varsBefore.get(k).stringValue()))
        //++
        //(for (k2 <- constantProp.varsAfter.keys()) yield ("After", k2.`_1`.asInstanceOf[Stm].stringValue(), k2.`_2`, constantProp.varsAfter.get(k2).stringValue()))
    }
}