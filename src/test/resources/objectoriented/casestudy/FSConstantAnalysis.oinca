module WhileLang

// Mark: - Expression

class Exp {
    // abstract
    def accept(v: Visitor): Unit = { }

    def aevalSign(p: ValueManager, s: Stm): MConstant = {
        new NoConstant()
    }

    def stringValue(): String = {
        "Exp"
    }
}

class Var(val name: String) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        v.visitVar(this)
    }

    @override
    def aevalSign(p: ValueManager, s: Stm): MConstant = {
        p.get(s, this.name)
    }

    @override
    def stringValue(): String = {
        "Var(" + this.name + ")"
    }
}

class Num(val num: Int) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        v.visitNum(this)
    }

    @override
    def aevalSign(p: ValueManager, s: Stm): MConstant = {
        new SomeConstant(this.num)
    }

    @override
    def stringValue(): String = {
        val n: Int = this.num
        "Num(" + n.`toString` + ")"
    }
}

class BinOp(val left: Exp, val right: Exp) extends Exp {
    @override
    def accept(v: Visitor): Unit = {
        this.left.accept(v)
        this.right.accept(v)
        this.binOpAccept(v)
    }
    // abstract
    def binOpAccept(v: Visitor): Unit = { }

    @override
    def aevalSign(p: ValueManager, s: Stm): MConstant = {
        this.binOpConst(this.left.aevalSign(p, s), this.right.aevalSign(p, s))
    }
    // abstract
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1
    }
}
class Add extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitAdd(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.add(c2)
    }

    @override
    def stringValue(): String = {
        "Add(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
    }
}
class Sub extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitSub(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.sub(c2)
    }

    @override
    def stringValue(): String = {
        "Sub(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
    }
}
class Mul extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitMul(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.mul(c2)
    }

    @override
    def stringValue(): String = {
        "Mul(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
    }
}
class GT extends BinOp {
    def this(left: Exp, right: Exp) = {
        super(left, right)
    }
    @override
    def binOpAccept(v: Visitor): Unit = {
        v.visitGT(this)
    }
    @override
    def binOpConst(c1: MConstant, c2: MConstant): MConstant = {
        c1.gt(c2)
    }

    @override
    def stringValue(): String = {
        "GT(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
    }
}

// Mark: - Statements

class Stm {
    // abstract
    def accept(v: Visitor): Unit = {
    }

    def first(): Stm = {
        this
    }
    def last(): Set[Stm] = {
        Set(this)
    }

    def stringValue(): String = {
        "Stm"
    }

    def transfer(from: Stm, manager: ValueManager): Unit = {
        // Default: Preserve all variables
        manager.transferAll(from, this)
    }
}

class Assign(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitAssign(this)
    }

    @override
    def stringValue(): String = {
        "Assign(" + this.name + ", " + this.rhs.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.put(this, this.name, this.rhs.aevalSign(manager, from))
    }
}
class Skip extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        v.visitSkip(this)
    }

    @override
    def stringValue(): String = {
        "Skip"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
    }
}
class Sequence(val s1: Stm, val s2: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.s1.accept(v)
        this.s2.accept(v)
        v.visitSequence(this)
    }
    @override
    def first(): Stm = {
        this.s1.first()
    }

    @override
    def last(): Set[Stm] = {
        this.s2.last()
    }

    @override
    def stringValue(): String = {
        "Sequence(" + this.s1.stringValue() + ", " + this.s2.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        // Does not occur
    }
}
class If(val cnd: Exp, val thn: Stm, val els: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.thn.accept(v)
        this.els.accept(v)
        v.visitIf(this)
    }

    @override
    def stringValue(): String = {
        "If(" + this.cnd.stringValue() + ", " + this.thn.stringValue() + ", " + this.els.stringValue() + ")"
    }

    @override
    def last(): Set[Stm] = {
        this.thn.last() ++ this.els.last()
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.transferAll(from, this.thn)
        manager.transferAll(from, this.els)
    }
}
class While(val cnd: Exp, val body: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.body.accept(v)
        v.visitWhile(this)
    }

    @override
    def stringValue(): String = {
        "While(" + this.cnd.stringValue() + ", " + this.body.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.transferAll(from, this.body.first())

        for (l2 <- this.body.last()) yield
            manager.transferAll(l2, this)
        for (l <- this.body.last()) yield
            manager.transferAll(l, this.body.first())

        return
    }
}
class ValDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitValDef(this)
    }

    @override
    def stringValue(): String = {
        "ValDef(" + this.name + ", " + this.rhs.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.put(this, this.name, this.rhs.aevalSign(manager, from))
    }
}
class VarDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitVarDef(this)
    }

    @override
    def stringValue(): String = {
        "VarDef(" + this.name + ", " + this.rhs.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.put(this, this.name, this.rhs.aevalSign(manager, from))
    }
}

// Mark: - Lattice

case class MConstant extends BalancedMonotone[MConstant, MConstant] {
    @static
    def init(): MConstant = {
        new BotConstant()
    }

    @static
    def join(c1: MConstant, c2: MConstant): MConstant = {
        c1.joined(c2)
    }

    // The current hack ignores the lift
    def lift(v: MConstant): MConstant = {
        v
    }

    def joined(that: MConstant): MConstant = {
        this
    }

    def num(n: Int): MConstant = {
        new SomeConstant(n)
    }
    def add(that: MConstant): MConstant = {
        this
    }
    def sub(that: MConstant): MConstant = {
        this
    }
    def mul(that: MConstant): MConstant = {
        this
    }
    def gt(that: MConstant): MConstant = {
        this
    }

    def stringValue(): String = {
        "MConstant"
    }
}

case class NoConstant extends MConstant {
    @override
    def stringValue(): String = {
        "NoConstant"
    }
}

case class BotConstant extends MConstant {
    @override
    def stringValue(): String = {
        "BotConstant"
    }

    @override
    def joined(that: MConstant): MConstant = {
        that
    }
}

case class SomeConstant(val value: Int) extends MConstant {
    @override
    def joined(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant] && that.asInstanceOf[SomeConstant].value == this.value) {
            this
        } else if (that.isInstanceOf[BotConstant]) {
            this
        } else {
            new NoConstant()
        }
    }

    @override
    def add(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.value + that.asInstanceOf[SomeConstant].value)
        } else {
            that
        }
    }

    @override
    def sub(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.value - that.asInstanceOf[SomeConstant].value)
        } else {
            that
        }
    }

    @override
    def mul(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.value * that.asInstanceOf[SomeConstant].value)
        } else {
            that
        }
    }

    @override
    def gt(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            if(this.value > that.asInstanceOf[SomeConstant].value)
                new SomeConstant(1)
            else
                new SomeConstant(0)
        } else {
            that
        }
    }

    @override
    def stringValue(): String = {
        "SomeConstant(" + this.value + ")"
    }
}

// Mark: - CFG

class Visitor {
    // Exp
    def visitVar(e: Var): Unit = { }
    def visitNum(e: Num): Unit = { }
    def visitAdd(e: Add): Unit = { }
    def visitSub(e: Sub): Unit = { }
    def visitMul(e: Mul): Unit = {}
    def visitGT(e: GT): Unit = {}

    // Stm
    def visitAssign(s: Assign): Unit = { }
    def visitSkip(s: Skip): Unit = { }
    def visitSequence(s: Sequence): Unit = { }
    def visitIf(s: If): Unit = { }
    def visitWhile(s: While): Unit = { }
    def visitValDef(s: ValDef): Unit = { }
    def visitVarDef(s: VarDef): Unit = { }
}

class MonoSet extends BalancedMonotone[(Any, Any), `scala.collection.immutable.Set[(Any, Any)]`] {
    @static
    def init(): `scala.collection.immutable.Set[(Any, Any)]` = {
        `scala.collection.immutable.Set[(Any, Any)]`()
    }

    @static
    def join(m1: `scala.collection.immutable.Set[(Any, Any)]`, m2: `scala.collection.immutable.Set[(Any, Any)]`): `scala.collection.immutable.Set[(Any, Any)]` = {
        m1 ++ m2
    }

    def lift(element: (Any, Any)): `scala.collection.immutable.Set[(Any, Any)]` = {
        `scala.collection.immutable.Set[(Any, Any)]`(`Tuple2.apply`(element._1, element._2))
    }

    def get(): `scala.collection.immutable.Set[(Any, Any)]` = {
        this.result
    }
}

class CfgVisitor extends Visitor {
  var cfg: MonoSet = new MonoSet()

  def cfgSet(): Set[(Stm, Stm)] = {
    val set: `scala.collection.immutable.Set[(Any, Any)]` = this.cfg.get()
    val list: `scala.collection.immutable.Vector[(Any, Any)]` = set.`toVector`
    this.cfgSetIter(list, 0)
  }

  def cfgSetIter(list: `scala.collection.immutable.Vector[(Any, Any)]`, ix: Int): Set[(Stm, Stm)] = {
    val e: `(Any, Any)` = list.`apply`(ix)
    val s1: Stm = e.`productElement`(0).asInstanceOf[Stm]
    val s2: Stm = e.`productElement`(1).asInstanceOf[Stm]
    if (ix == list.`size` - 1) {
      Set((s1, s2))
    } else {
      Set((s1, s2)) ++ this.cfgSetIter(list, ix + 1)
    }
  }

  def addPath(from: Stm, to: Stm): Unit = {
    this.cfg += (from,to)
  }

  @override
  def visitSequence(s: Sequence): Unit = {
    val to: Stm = s.s2.first()
    for (from <- s.s1.last())
        yield this.addPath(from, to)
    return
  }

  @override
  def visitIf(s: If): Unit = {
    this.cfg += (s,s.thn.first())
    this.cfg += (s,s.els.first())
  }

  @override
  def visitWhile(s: While): Unit = {
    this.cfg += (s, s.body.first())
    for (from <- s.body.last())
        yield this.addPath(from, s)
    return
  }
}

// Mark: - Constant Analysis

class ValueManager {
    def get(s: Stm, v: String): MConstant = {
        new NoConstant()
    }

    def put(s: Stm, v: String, m: MConstant): Unit = { }

    def transferAll(from: Stm, to: Stm): Unit = { }
}

class FSConstantAnalysis(val head: Stm, val cfg: Set[(Stm, Stm)], val varNames: Set[String]) extends ValueManager {
    val after: MonoMap[`(Any, String)`, MConstant] = new MonoMap[`(Any, String)`, MConstant]()

    @override
    def get(s: Stm, v: String): MConstant = {
        return this.after.get(`Tuple2.apply`(s, v))
    }

    @override
    def put(s: Stm, v: String, m: MConstant): Unit = {
        this.after += (`Tuple2.apply`(s, v), m)
    }

    def runInternal(): Unit = {
        val start: Stm = new Skip()
        for (v <- this.varNames) yield
            this.put(start, v, new BotConstant())
        this.head.transfer(start, this)
        this.iterate()
    }

    def run(): Set[(String, String, String)] = {
        this.runInternal()
        return this.readableResult()
    }

    def iterate(): Unit = {
        for (e <- this.cfg)
            yield e._2.transfer(e._1, this)
        // Comment in this line to compute the correct fixpoint using the interpreter
        //fix this.iterate()
        return
    }

    @override
    def transferAll(from: Stm, to: Stm): Unit = {
        for (y <- this.varNames) yield
            this.put(to, y, this.get(from, y))
        return
    }

    def readableResult(): Set[(String, String, String)] = {
        (for (k <- this.after.keys() if !this.after.get(k).isInstanceOf[BotConstant])
            yield (k.`_1`.asInstanceOf[Stm].stringValue(), k.`_2`, this.after.get(k).stringValue()))
    }
}


class Examples {
    val varNames: Set[String] = Set("n", "m", "acc")

    def factorial(): Stm = {
        new Sequence(new VarDef("n", new Num(5)),
            new Sequence(new VarDef("acc", new Num(1)),
                new While(
                    new GT(new Var("n"), new Num(1)),
                    new Sequence(
                        new Assign("acc", new Mul(new Var("acc"), new Var("n"))),
                        new Assign("n", new Sub(new Var("n"), new Num(1)))
                    )
                )
            )
        )
    }

    // Do not comment this in ! This will triple the execution time...
    // I assume because the demand transformation rewrites this somehow
    /*val assignments: Stm =
        new Sequence(new VarDef("m", new Num(3)),
            new Sequence(new Assign("m", new Num(2)),
                new Sequence(
                    new VarDef("n", new Num(5)),
                    new ValDef("acc", new Num(1))
                )
            )
        )

    val simpleAssignments: Stm =
        new Sequence(
            new ValDef("n", new Num(5)),
            new ValDef("acc", new Num(1))
        )*/
}

class CFGHelper(val prog: Stm) {
    def getCFG(): Set[(Stm, Stm)] = {
        // Calculate CFG
        val cfgVisitor: CfgVisitor = new CfgVisitor()
        this.prog.accept(cfgVisitor)
        return cfgVisitor.cfgSet()
    }
}

class ConstantAnalysis {
    @main
    def main(): Set[(String, String, String)] = {
        // TODO: Automatically get all vars
        val examples: Examples = new Examples()
        val prog: Stm = examples.factorial()
        val cfgHelper: CFGHelper = new CFGHelper(prog)

        // Do constant propagation
        val constantProp: FSConstantAnalysis = new FSConstantAnalysis(prog.first(), cfgHelper.getCFG(), examples.varNames)
        constantProp.run()
    }
}

