module MonoTest

case class Num(val value: Int) {

}

class SumMonotoneWithSetSemantics extends BalancedMonotone[Int, Num] {

    def init(): Num = {
        new Num(0)
    }

    def join(n1: Num, n2: Num): Num = {
        new Num(n1.value + n2.value)
    }

    def lift(v: Int): Num = {
        new Num(v)
    }

    def get(): Num = {
        this.result
    }
}

class Main {
    @main
    def main(): Set[Int] = {
        //val mono: SumMonotoneWithSetSemantics = new SumMonotoneWithSetSemantics()
        val map: MonoMap[String, SumMonotoneWithSetSemantics] = new MonoMap[String, SumMonotoneWithSetSemantics]()
        map.get("A") += 4
        map.get("A") += 5
        map.get("B") += 3
        map.get("B") += 4
        map.get("C") += 1

        // We can perform set comprehensions using the keys
        for (k <- map.keys() if ((k == "B") || (k == "A"))) yield map.get(k).get().value

        // TODO: Can we create nested maps ?
    }
}