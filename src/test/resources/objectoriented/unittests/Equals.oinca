module EqualsTest

class A {
    val c: C

    def this(c : C) = {
        this.c = c
    }
}

class B {
    def this() = {}
}

class C {
    def this() = {}
}

class D {
    @main
    def main(): Boolean = {
        val a: A = new A(new C())
        val b: B = new B()
        val c: C = null

        return (a == a)
            && (b == b)
            && (!(a == b))
            && (a.c == a.c)
            && (a != a.c)
            && (null == null)
            && (c == null)
            && (a != null)
            && (a.c != null)
    }
}