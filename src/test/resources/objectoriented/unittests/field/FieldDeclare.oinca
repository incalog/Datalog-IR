module FieldDeclare

class A {
    var value: Int = 1
    var value2: Int = 4

    def this() = {
        this.value2 = this.value + 2
        this.value = 6
    }

    @main
    def main(): Int = {
        val a: A = new A()
        return a.value2
    }
}

class B {
    val value: Int = 5

    def this() = {

    }
}