module FieldInheritance

class A {
    var value: Int = 1

    def this() = {}

    @main
    def main(): Int = {
        val b: B = new B()
        // make sure value is initialized correctly
        val initVal: Int = b.value
        // make sure value can be assigned
        b.value = 9
        return b.value + initVal
    }
}

class B extends A {
    def this() = {}
}