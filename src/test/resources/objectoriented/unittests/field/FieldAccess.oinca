module FieldAccess1

class Fraction {
    val numerator: Int
    val denominator: Int

    def this(numerator: Int, denominator: Int) = {
        this.numerator = numerator
        this.denominator = denominator
    }

    @main
    def main(num: Int, denom: Int): Int = {
        val frac: Fraction = new Fraction(num, denom)
        return frac.numerator / frac.denominator
    }
}