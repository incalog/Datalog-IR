module VarAssignment

class A {
    var v: Int

    def this(v: Int) = {
        this.v = v
    }

    @main
    def main(p: Int): Boolean = {
        val a: A = new A(3)
        var b: A = a
        a.v = 4
        val c: A = b

        var x: Int = 10
        val y: Int = x
        val z: Int = p

        x = 5

        return (x == 5) && (y == 10) && (z == p) && (a.v == b.v) && (b.v == c.v) && (a.v == 4)
    }
}