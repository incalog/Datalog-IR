module BinaryTree

class Node {
    def this(): Node = {
        return this
    }

    def isUndefined(): Boolean = {
        return false
    }
    def insert(data: Int): Unit = { }
    def printTree(): Unit = { }
}

class UndefinedNode extends Node {
    def this(): UndefinedNode = {
        return this
    }

    def isUndefined(): Boolean = {
        return true
    }
}

class DefinedNode extends Node {
	var left: Node
	var right: Node
	var data: Int
	
	def this(data: Int): DefinedNode = {
	    this()
      	this.data = data
      	this.left = new UndefinedNode()
      	this.right = new UndefinedNode()
      	return this
    }

	def insert(data: Int): Unit = {
		if (data < this.data) {
            if (this.left.isUndefined())
                this.left = new DefinedNode(data)
            else
                this.left.insert(data)
        } else if (data > this.data) {
            if (this.right.isUndefined())
                this.right = new DefinedNode(data)
            else
                this.right.insert(data)
		}
	}

	def printTree(): Unit = {
      if (!this.left.isUndefined())
         this.left.printTree()

      `println`(this.data)

      if (!this.right.isUndefined())
         this.right.printTree()
	}

	@main
	def main(): Unit = {
	    val root: Node = new DefinedNode(12)
        root.insert(6)
        root.insert(14)
        root.insert(3)
        root.printTree()
	}
}


