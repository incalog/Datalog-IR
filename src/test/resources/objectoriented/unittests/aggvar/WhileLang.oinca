/** Shows a set aggregation that collects a growing number of tuples.
 *  The programmer is responsible for making sure the set is bounded.
 */
class CfgVisitor extends Visitor {
    // TODO empty set not currently allowed here
    vag cfg: mono.Set[(Stm, Stm)] = Set((new Skip(), new Skip())) with CfgVisitor.union

    @static
    def union(s1: Set[(Stm,Stm)], s2: Set[(Stm,Stm)]): Set[(Stm,Stm)] = {
        s1 ++ s2
    }

    def visitSequence(s: Sequence): Unit = {
        val from: Stm = s.s1.last()
        val to: Stm = s.s2.first()
        // TODO adds one element to the set
        this.cfg #= (from,to)
    }

    def visitIf(s: If): Unit = {
        // TODO adds a set to the set
        this.cfg ##= Set((s,s.thn.first()), (s,s.els.first()))
    }

    def visitWhile(s: While): Unit = {
        // TODO adds a set to the set
        this.cfg ##= Set((s,s.body.first()), (s.body.last(),s))
    }
}

class MConstant {
    @static
    def join(c1: MConstant, c2: MConstant): MConstant = {
        c1.join(c2)
    }
    def join(that: MConstant): MConstant = {
        this
    }

    def num(n: Int): MConstant = {
        new SomeConstant(n)
    }
    def add(that: MConstant): MConstant = {
        this
    }
    def sub(that: MConstant): MConstant = {
        this
    }
    def mul(that: MConstant): MConstant = {
        this
    }
    def gt(that: MConstant): MConstant = {
        this
    }
}
class NoConstant extends MConstant {
}
class SomeConstant extends MConstant {
    val num: Int
    def this(num: Int) = {
        this.num = num
    }
    @override
    def join(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant] && that.asInstanceOf[SomeConstant].num == this.num) {
            this
        } else {
            new NoConstant()
        }
    }

    def add(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num + that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    def sub(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num - that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    def mul(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            new SomeConstant(this.num * that.asInstanceOf[SomeConstant].num)
        } else {
            new NoConstant()
        }
    }

    def gt(that: MConstant): MConstant = {
        if (that.isInstanceOf[SomeConstant]) {
            if(this.num > that.asInstanceOf[SomeConstant].num)
                new SomeConstant(1)
            else
                new SomeConstant(0)
        } else {
            new NoConstant()
        }
    }
}

/*

1. generics
2. mono.Datentypen kompilieren: linear, balanced, invertible
3. case studies
*/

class ConstantDomain extends BalancedMonotone[(String, MConstant), `Map`[String, MConstant]] {
  def init() = Map[String, MConstant]()
  def +=(kv: (String, MConstant)) = {
    Map(kv)
  }
//  def +=Linear(kv: (String, MConstant)) = {
//    this.join(this.state, lift(kv))
//  }
  protected def join(s1: `St`, s2: `St`): `St` = `{
    var m = s1
    for (kv <- s2)
      s1.get(kv._1) match {
        case None => m + kv
        case Some(v) => m + (k -> v.join(kv._2))
      }
    m
  }`
}

class mono.Map[K, S, M <: Monotone[T, S]](val m: M) extends BalancedMonotone[(K, T), Map[K, S]] {
  def init() = Map[K, S]()
  def +=(kv: (K, T)) = {
    Map(kv._1 -> m.lift(kv._2))
  }
//  def +=Linear(kv: (String, MConstant)) = {
//    this.join(this.state, lift(kv))
//  }
  protected def join(s1: Map[K,S], s2: Map[K,S]): Map[K,S] = {
    var m = s1
    for (kv <- s2)
      s1.get(kv._1) match {
        case None => m += kv
        case Some(v) => m += (k -> m.join(v, kv._2))
      }
    m
  }
  def get(k: K): Option[S] = this.result.get(k)
}


class FIConstantPropagationVisitor extends Visitor {
    /** The Map type separates keys from aggregated values */
    val vars: mono.ConstantDomain = new mono.ConstantDomain() 

    def visitValDef(s: ValDef): Unit = {
        this.vars += s.name -> s.rhs.aevalConst(this.vars)
        // Typechecker test
        //this.vars ##= Set((s.name, s.rhs.aevalConst(this.vars)))
    }

    def visitVarDef(s: VarDef): Unit = {
        this.vars += s.name -> s.rhs.aevalConst(this.vars)
    }

    def visitAssign(s: Assign): Unit = {
        this.vars += s.lhs -> s.rhs.aevalConst(this.vars)
    }
}



/** Shows a groupped aggregation */
class FIConstantPropagationVisitor extends Visitor {
    /** The Map type separates keys from aggregated values */
    vag vars: Map[String, MConstant] = Map(("$$", new NoConstant()))
        with MConstant.join

    def visitValDef(s: ValDef): Unit = {
        this.vars #= (s.name, s.rhs.aevalConst(this.vars))
        // Typechecker test
        //this.vars ##= Set((s.name, s.rhs.aevalConst(this.vars)))
    }

    def visitVarDef(s: VarDef): Unit = {
        this.vars #= (s.name, s.rhs.aevalConst(this.vars))
    }

    def visitAssign(s: Assign): Unit = {
        this.vars #= (s.lhs, s.rhs.aevalConst(this.vars))
    }
}

/** Shows a nested groupped aggregation */
class FSConstantPropagationVisitor extends Visitor {
    // TODO empty set not currently allowed here

    /** The Map types separate key1 from key2 and the aggregated values.
     *  This could have been written Map[(Stm, String), MConstant], but the
     *  nested type provides easier access per statement.
     */
     val varsAfter: mono.Map[Stm, mono.Map[String, MConstant]] = new mono.Map[Stm, mono.Map[String, MConstant]]()

    vag varsAfter: Map[Stm, Map[String, MConstant]] = Map((new Skip(), Map(("$$", new NoConstant()))))
        with MConstant.join
    vag varsBefore: mono.Map[Stm, mono.Map[String, MConstant]] = new mono.Map(new mono.Map())

    def visitValDef(s: ValDef): Unit = {
        this.varsAfter += (s, (s.name, s.rhs.aevalConst(this.varsBefore(s))))
        val beforeMap = this.varsBefore.result
        this.varsAfter ++= for (bf <- beforeMap.`get`(s) if bf._1 != s.name) yield (s, bf)
    }

    def visitVarDef(s: VarDef): Unit = {
        this.varsAfter(s) #= (s.name, s.rhs.aevalConst(this.varsBefore(s)))
        this.varsAfter(s) ##= for (bf <- this.varsBefore(s) if bf._1 != s.name) yield bf
    }

    def visitAssign(s: Assign): Unit = {
        this.varsAfter(s) #= (s.lhs, s.rhs.aevalConst(this.varsBefore(s)))
        this.varsAfter(s) ##= for (bf <- this.varsBefore(s) if bf._1 != s.lhs) yield bf
    }

    def visitSkip(s: Skip): Unit = {
        this.varsAfter(s) ##= this.varsBefore(s)
    }

    def visitSequence(s: Sequence): Unit = {
        // data flow s.s2.first() <- s.s1.last()
        this.varsBefore(s.s2.first()) ##= this.varsAfter(s.s1.last())
    }

    def visitIf(s: If): Unit = {
        // data flow s.thn.first() <- s
        // data flow s.els.first() <- s
        this.varsBefore ++= for (kv <- this.varsBefore.get(s)) yield (s.thn.first(), kv)
        this.varsBefore ++= for (kv <- this.varsBefore.get(s)) yield (s.els.first(), kv)
        this.varsAfter ++= this.varsBefore.get(s.thn.last())
        this.varsAfter ++= this.varsBefore.get(s.els.last())
    }

    def visitWhile(s: While): Unit = {
        // data flow s.body.first() <- s
        // data flow s <- s.body.last()
        this.varsAfter(s) ##= this.varsBefore(s)
        this.varsBefore(s.body.first()) ##= this.varsAfter(s)
        this.varsBefore(s) ##= this.varsAfter(s.body.last())
    }

}



class Examples {
    val factorial: Stm =
        new Sequence(new VarDef("n", new Num(5)),
            new Sequence(new VarDef("acc", new Num(1)),
                new While(
                    new GT(new Var("n"), new Num(1)),
                    new Sequence(
                        new Assign("acc", new Mul(new Var("acc"), new Var("n"))),
                        new Assign("n", new Sub(new Var("n"), new Num(1)))
                    )
                )
            )
        )
}

class FactorialSumNum {
    @main
    def sumNum(): Int = {
        val treeSum: SumNumVisitor = new SumNumVisitor()
        val examples: Examples = new Examples()
        examples.factorial.accept(treeSum)
        treeSum.sum
    }
}




