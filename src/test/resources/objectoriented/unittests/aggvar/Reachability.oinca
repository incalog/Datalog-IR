module ReachabilityTest

class Graph {
    vag maxDis: Int = 0 with Graph.sum

    val edges: Set[(String, String)] = Set(
      ("X", "Y"),
      ("Y", "Z"),
      ("Z", "X"),
      ("A", "Z"),
      ("Z", "Y")
    )

    @static
    def sum(n1: Int, n2: Int): Int = {
        n1 + n2
    }

    @main
    def main(): Int = {
        val g: Graph = new Graph()
        g.path("A", 1)
        g.maxDis
    }

    def path(x: String, idx: Int): Set[String] = {
        this.maxDis #= 1

        (for (d <- this.edges if d._1 == x) yield d._2)
        ++
        (for (i <- this.edges if i._1 == x; y <- this.path(i._2, idx)) yield y)
    }
}
