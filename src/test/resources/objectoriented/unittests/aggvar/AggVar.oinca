module ReachabilityTest

class A {
    vag sum: Set[(Int, Int)] with A.sum

    @static
    def sum(n1: Int, n2: Int): Int = {
        n1 + n2
    }

    @main
    def main(): Int = {
        val a: A = new A()
        a.sum #= 1
        a.sum #= 3

        val b: Int = a.sum
        b1 = b + 1
        a.sum #= b1
        //a.sum
        b
    }
}
