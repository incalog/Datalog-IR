module ReachabilityTest

class Exp {
    def accept(v: Visitor): Unit = {
    }

    def repr(): String = {
        return "Exp"
    }
}

class Var extends Exp {
    val name: String
    def this(name: String) = {
        this.name = name
    }

    @override
    def accept(v: Visitor): Unit = {
        v.visitVar(this)
    }

    @override
    def repr(): String = {
        return "Var"
    }
}

class Num extends Exp {
    val num: Int
    def this(num: Int) = {
        this.num = num
    }

    @override
    def accept(v: Visitor): Unit = {
        v.visitNum(this)
    }

    @override
    def repr(): String = {
        return "Num"
    }
}

class Add extends Exp {
    val left: Exp
    val right: Exp
    def this(left: Exp, right: Exp) = {
        this.left = left
        this.right = right
    }

    @override
    def accept(v: Visitor): Unit = {
        this.left.accept(v)
        this.right.accept(v)
        v.visitAdd(this)
    }

    @override
    def repr(): String = {
        return "Add"
    }
}

class Visitor {
    def visitVar(e: Var): Unit = {
    }
    def visitNum(e: Num): Unit = {
    }
    def visitAdd(e: Add): Unit = {
    }
}

class NodeVisitor extends Visitor {
    // sum unique values of each num node
    vag nodes: Map[String, Int] = Map(("", 0)) with NodeVisitor.sum

    @static
    def sum(n1: Int, n2: Int): Int = {
        n1 + n2
    }

    @override
    def visitNum(e: Num): Unit = {
        this.nodes #= (e.repr(), e.num)
    }

    @override
    def visitVar(e: Var): Unit = {
        this.nodes #= (e.repr(), 0)
    }

    @override
    def visitAdd(e: Add): Unit = {
        this.nodes #= (e.repr(), 0)
    }
}

class Main {
    @main
    def sumNum(): Map[String, Int] = {
        val nodeVisitor: NodeVisitor = new NodeVisitor()
        val tree1: Exp = new Add(new Var("x"), new Num(7))
        val tree2: Exp = new Add(new Num(1), new Add(new Num(2), new Num(1)))
        tree1.accept(nodeVisitor)
        tree2.accept(nodeVisitor)
        nodeVisitor.nodes
    }
}
