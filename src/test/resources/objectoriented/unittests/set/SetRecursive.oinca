module SetRecursive

class Graph {
    val edges: Set[(String, String)] = Set(("X", "Y"), ("Y", "Z"), ("Z", "W"), ("A", "X"))

    @main
    def main(): Set[String] = {
        new Graph().path("X")
    }

    def path(x: String): Set[String] = {
        return for (d <- this.edges if d._1 == x) yield d._2
        ++
        for (i <- this.edges if i._1 == x; y <- this.path(i._2)) yield y

        /*
                val direct: Set[String] = for (d <- this.edges if d._1 == x) yield d._2
                val indirect: Set[String] = for (i <- this.edges if i._1 == x; y <- this.path(i._2)) yield y
                return direct ++ indirect*/
    }
}