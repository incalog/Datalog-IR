module SetTest

class Num {
  var value: Int

  def this(value: Int) = {
    this.value = value
  }

  def max(n: Num): Num = {
    if (n.value > this.value)
      return n
    else
      return this
  }

  @main def main(): Int = {
    val s: Set[Num] = [new Num(1), new Num(3), new Num(4), new Num(2), new Num(-1)]
    return reduce(n.getSet(), max).value
  }
}