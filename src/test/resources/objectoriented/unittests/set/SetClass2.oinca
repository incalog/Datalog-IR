module SetTest

class Num {
    var value: `Int`

    def this(value: `Int`) = {
        this.value = value
    }
}

class Integer extends Num {
    def this(value: `Int`) = {
        super(value)
    }
}

class A {
  def this() = {}

  def bounded(as: Set[Num]): Set[Integer] = {
    return for (a <- as if a.value < 11) yield cast(a, Integer)
  }

  @main def main(): Set[Any] = {
    val a: A = new A()
    return for (v <- a.bounded(Set(new Integer(10), new Integer(5), new Integer(11)))) yield v.value
  }
}