module NullTest

class A {
    def this() = {}
}

class B {
    def this() = {}
}

class C {
    @main
    def main(): Boolean = {
        // Create a null object
        val a: A = null
        val b: B = new B()

        // Todo: We might actually catch this case and prevent instanceOf for null objects
        // Null is subtype of everything, so this should be true, since a is null, although the static type is A
        val isNullInstance: Boolean = instanceOf(a, B)
        val isInstanceOfNull: Boolean = instanceOf(a, Null)
        val isNotInstanceOfNull: Boolean = !instanceOf(b, Null)

        return isNullInstance && isNotInstanceOfNull && isInstanceOfNull
    }
}