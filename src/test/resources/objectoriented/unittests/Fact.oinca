module Fact

class Fact {
    //val num: Double = 1.0

    def this(): Fact = {
        return this
    }

    def fact(n: Int): Int = {
      if (n == 1)
        return 1
      else
        return n * this.fact(n - 1)
    }

    @main
    def main(n: Int): Int = {
        val f: Fact = new Fact()
        return f.fact(n)
    }
}