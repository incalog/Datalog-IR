module BinaryTree

class Node {
    def this() = {}

    def sum(): Int = {
        return 0
    }
}

class UndefinedNode extends Node {
    def this() = {}
}

class DefinedNode extends Node {
	var left: Node
	var right: Node
	var data: Int

    def this(left: Node, right: Node, data: Int) = {
        this.left = left
        this.right = right
        this.data = data
    }

    def sum(): Int = {
        return this.data + this.right.sum() + this.left.sum()
    }

	@main
	def main(): Int = {
	    val undef: Node = new UndefinedNode()
	    val root: Node = new DefinedNode(
	        new DefinedNode(undef, undef, 3),
	        new DefinedNode(undef, undef, 5),
	        12
	    )
	    return root.sum()
	}
}


