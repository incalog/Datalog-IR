module AvgTest

class MonotoneMap extends BalancedMonotone[(String, Int), `scala.collection.immutable.Map[String, Int]`] {
    def init(): `scala.collection.immutable.Map[String, Int]` = {
        `scala.collection.immutable.Map[String, Int]`()
    }

    def join(m1: `scala.collection.immutable.Map[String, Int]`, m2: `scala.collection.immutable.Map[String, Int]`): `scala.collection.immutable.Map[String, Int]` = {
        m1 ++ m2
    }

    def lift(pair: (String, Int)): `scala.collection.immutable.Map[String, Int]` = {
        `scala.collection.immutable.Map[String, Int]`(pair._1 -> pair._2)
    }

    def get(): `scala.collection.immutable.Map[String, Int]` = {
        this.result
    }
}

class Example {
    @main
    def main(): `scala.collection.immutable.Map[String, Int]` = {
        var m: MonotoneMap = new MonotoneMap()
        m += ("Zero", 0)
        m += ("One", 1)
        m += ("Two", 2)
        //m.get()
        //m += ("Three", 3)
        m.get()
    }
}