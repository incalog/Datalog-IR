module AvgTest

class Avg extends BalancedMonotone[Int, (Int, Double)] {
    def init(): (Int, Double) = {
        (0, 0.0)
    }

    def join(v1: (Int, Double), v2: (Int, Double)): (Int, Double) = {
        (v1._1 + v2._1, v1._2 + v2._2)
    }

    def lift(value: Int): (Int, Double) = {
        (value, 1.0)
    }

    def get(): Double = {
        val res: (Int, Double) = this.result
        res._1 / res._2
    }
}

class Example {
    @main
    def main(): Double = {
        var avg: Avg = new Avg()
        avg += 1
        val res: Double = avg.get()
        avg += 2
        res
    }
}