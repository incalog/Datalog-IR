module MonoTest

case class Num(val value: Int) {

}

class SumMonotoneWithSetSemantics extends BalancedMonotone[Int, Num] {

    def init(): Num = {
        new Num(0)
    }

    def join(n1: Num, n2: Num): Num = {
        new Num(n1.value + n2.value)
    }

    def lift(v: Int): Num = {
        new Num(v)
    }

    def get(): Num = {
        this.result
    }
}

class Main {
    @main
    def main(): Set[Int] = {
        //val mono: SumMonotoneWithSetSemantics = new SumMonotoneWithSetSemantics()
        var map: MonoMap[(String, String), SumMonotoneWithSetSemantics] = new MonoMap[(String, String), SumMonotoneWithSetSemantics]()
        map.get(("A", "A")) += 4
        map.get(("A", "A")) += 5
        map.get(("B", "A")) += 3
        map.get(("B", "A")) += 4
        map.get(("C", "A")) += 1

        // We can perform set comprehensions using the keys
        for (k <- map.keys() if ((k._1 == "B") || (k._1 == "A"))) yield map.get(k).get().value

        // We can nest maps
        /*var nested: MonoMap[String, MonoMap[Int, SumMonotoneWithSetSemantics]] = new MonoMap[String, MonoMap[Int, SumMonotoneWithSetSemantics]]()
        nested.get("A").get(1) += 4
        nested.get("A").get(1) += 5
        nested.get("A").get(2) += 2
        nested.get("B").get(3) += 3

        // We still got the problem with duplicate aggregation, but it shouldn't exist in a fixpoint
        for (k1 <- nested.keys() if k1 == "A"; k2 <- nested.get(k1).keys() if k2 == 1) yield nested.get(k1).get(k2).get().value*/
    }
}