module SetFold

class Num(val value: Int) {

  @static
  def sumInt(n1: Int, n2: Int): Int = {
    n1 + n2
  }

  @static
  def sumNum(n1: Num, n2: Num): Num = {
    new Num(n1.value + n2.value)
  }

  def createSet(from: Int, to: Int): Set[(Int, Int)] = {
    if (from == to) {
      Set((0, to), (1, to))
    } else {
      Set((0, from), (1, from)) ++ this.createSet(from+1, to)
    }
  }

  @main def main(): (Int, Int, Int, Int, Int, Int) = {
    val n: Num = new Num(0)

    // 0.
    val s: Set[(Int, Int)] = n.createSet(1, 10)
    val a: Int = s.fold(0, Num.sumInt, (0, #))
    val b: Int = s.fold(0, Num.sumInt, (_, #))

    // 1.
    val c: Int = Set((0, 1), (1,1), (0, 3)).fold(0, Num.sumInt, (0, #))

    // 2.
    val x: Int = 0
    val d: Int = Set((x, 0, 1), (0, 1, 1), (1, 1, 1), (2, 1, 1)).fold(0, Num.sumInt, (x, _, #))

    // 3.
    val e: Int = (for (s2 <- Set((0, 1), (1,1))) yield s2._2).fold(0, Num.sumInt)

    // 4.
    val f: Num = Set((0, new Num(1)), (1, new Num(1)), (0, new Num(3))).fold(new Num(0), Num.sumNum, (0, #))

    (a, b, c, d, e, f.value)
  }
}