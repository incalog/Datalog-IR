module SetFold

class Num {
  @static
  def max(n1: Int, n2: Int): Int = {
    if (n1 > n2)
      return n1
    else
      return n2
  }

  @main def main(): Int = {
    val s: Set[Int] = Set(1, 2, 3, 4, -1)
    val n: Int = s.fold(-100, Num.max)

    val s2: Set[Int] = Set(12, 2, 3, 4, -1)
    val n2: Int = s2.fold(-100, Num.max)
    return n + n2
  }
}