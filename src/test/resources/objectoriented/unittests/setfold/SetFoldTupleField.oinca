module SetFold

class A {
    var b: B

    def this() = {
        this.b = new B()
    }
}

class B {

}

class Num {
  var value: Int
  var tup1: ((Int, Int), Int)
  var tup2: (Int, (A, Int))

  def this(value: Int) = {
    this.value = value
    this.tup1 = ((4, 5), 3)
    this.tup2 = (4, (new A(), 3))
  }

  @static
  def max(n1: Num, n2: Num): Num = {
    if (n1.value > n2.value)
      return n1
    else
      return n2
  }

  @main def main(): Int = {
    val s: Set[Num] = Set(new Num(1), new Num(2), new Num(3), new Num(5), new Num(4))
    val n: Num = s.fold(new Num(0), Num.max)
    return n.value
  }
}