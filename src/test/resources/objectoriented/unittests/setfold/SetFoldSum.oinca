module SetFold

class Num {
  @static
  def sum(n1: Int, n2: Int): Int = {
    n1 + n2
  }

  @main def main(): Int = {
    val s: Set[Int] = Set(1, 2, 3, 4, -1)
    // TODO: somehow negative numbers do not work here, although the generated Scala code is correct
    val n: Int = s.fold(0, Num.sum)

    val s2: Set[Int] = s ++ Set(5)
    val n2: Int = s2.fold(0, Num.sum)
    return n + n2
  }
}