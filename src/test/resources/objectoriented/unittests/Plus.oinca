class Zero extends Nat {
    def succ(): Nat = {
        return new Succ(this)
    }

    @override
    def add(n: Nat): Nat = {
        return n
    }
}

class Succ extends Nat {
    val pred: Nat

    def this(pred: Nat) = {
        this.pred = pred
        return this
    }

    @override
    def add(n: Nat): Nat = {
        return new Succ(this.pred)
    }
}