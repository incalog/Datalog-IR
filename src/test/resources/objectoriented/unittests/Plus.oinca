class Zero(Nat) {
	@override def add(n) {
		return n
	}
}

class Succ(Nat) {
	var pred

	init(pred: Succ) {
	    this.pred = pred
	}
	
	@override def add(n: Nat): Nat {
		return new Succ(this.pred.add(n))
	}
}
