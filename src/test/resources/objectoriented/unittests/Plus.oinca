class Zero extends Nat {
    def succ(): Nat = {
        return new Succ(this, 5, 5d)
    }

    @override
    def add(n: Nat): Nat = {
        return n
    }
}

class Succ extends Nat {
    val pred: Nat
    val data: Int
    val data2: Double

    def this(pred: Nat, data: Int data2: Double) = {
        this.pred = pred
        return this
    }

    @override
    def add(n: Nat): Nat = {
        return new Succ(this.pred, 1, 1d)
    }
}