module Plus

class A {
    def add(n: Nat): Nat = {
        return n
    }
}

class Nat extends A {
    def this() = { }

    def succ(): Succ = {
        return new Succ(this)
    }

    @override
    def add(n: Nat): Nat = {
        return n
    }

    @main
    def main(): Boolean = {
        val zero: Zero = new Zero()
        val first: Succ = zero.succ()
        val second: Succ = zero.succ().succ()

        //return first.add(second)
        return instanceOf(first, A)
    }
}

class Zero extends Nat {
    @override
    def add(n: Nat): Nat = {
        return n
    }
}

class Succ extends Nat {
    val pred: Nat

    def this(pred: Nat) = {
        this.pred = pred
    }

    @override
    def add(n: Nat): Nat = {
        // TODO: Not working since this.pred is always Nat. Therefore the dispatch always occurs to nat
        // TODO: Solution: Add a dynamic dispatch to datalog
        return new Succ(this.pred.add(n))
    }
}