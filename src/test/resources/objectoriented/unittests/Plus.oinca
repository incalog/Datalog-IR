class Zero extends Nat {
    @override
    def add(n: Nat): Nat = {
        return n
    }
}

class Succ extends Nat {
    val pred: Nat

    def this(pred: Nat) = {
        this.pred = pred
    }

    @override
    def add(n: Nat): Nat = {
        // TODO: Not working since this.pred is always Nat. Therefore the dispatch always occurs to nat
        // TODO: Solution: Add a dynamic dispatch to datalog
        return new Succ(this.pred.add(n))
    }
}