class Zero(Nat) {
	@override def add(n) {
		return n
	}
}

class Succ(Nat) {
	var pred

	init(pred) {
	    this.pred = pred
	}
	
	@override def add(n) {
		return new Succ(this.pred.add(n))
	}
}
