module DoubleLinked

class Node {
  var data: Int = 0
  var next: Node = null
  var prev: Node = null

  def this(data: Int) = {
    this.data = data
  }
}

class DoubleLinkedList {
    var head: Node
    var tail: Node

    def this(head: Node) = {
        this.head = head
        this.tail = head
    }

    @main
    def main(num: Int): (Int, Int, Int)  = {
        val list: DoubleLinkedList = new DoubleLinkedList(new Node(1))
        list.append(2).append(3).append(4).append(6).append(7).append(8)

        val sumBefore: Int = list.sum(list.head)
        val index: Int = list.insertAfter(list.head, num)
        val sumAfter: Int = list.sumRev(list.tail)
        return (sumBefore, sumAfter, index)
    }

    def append(data: Int): DoubleLinkedList = {
        val node: Node = new Node(data)
        this.tail.next = node
        node.prev = this.tail
        this.tail = node
        return this
    }

    def sum(start: Node): Int = {
        if (start.next == null) {
            return start.data
        } else {
            return start.data + this.sum(start.next)
        }
    }

    def sumRev(end: Node): Int = {
        if (end.prev == null) {
            return end.data
        } else {
            return end.data + this.sumRev(end.prev)
        }
    }

    def insertAfter(start: Node, num: Int): Int = {
        if ((start.data > num) || (start.next == null)) {
            val node: Node = new Node(num)
            val prev: Node = start.prev
            start.prev = node
            prev.next = node
            node.next = start
            node.prev = prev
            return 0
        }
        return 1 + this.insertAfter(start.next, num)
    }
}
