class Examples {
  val factorial: Stm =
    new Sequence(new VarDef("n", new Num(5)),
      new Sequence(new VarDef("acc", new Num(1)),
        new While(
          new GT(new Var("n"), new Num(1)),
          new Sequence(
            new Assign("acc", new Mul(new Var("acc"), new Var("n"))),
            new Assign("n", new Sub(new Var("n"), new Num(1)))
          )
        )
      )
    )

  @main
  def main(): Set[(String, String)] = {
    /*val visitor: IntervalVisitor = new IntervalVisitor()
    val examples: Examples = new Examples()
    examples.factorial.accept(visitor)
    (visitor.getUpperBound("acc"), visitor.getLowerBound("acc"))*/

    val visitor: CfgVisitor = new CfgVisitor()
    val examples: Examples = new Examples()
    examples.factorial.accept(visitor)
    for (c <- visitor.cfg) yield (c._1.getString(), c._2.getString())
  }
}