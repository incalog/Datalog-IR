module GraphTest

class Edge {
  var start: String
  var end: String

  def this(s: String, e: String) = {
    this.start = s
    this.end = e
  }
}

class Graph {
    val edges: Set[Edge] = Set(
      new Edge("X", "Y"),
      new Edge("Y", "Z"),
      // introduce a cycle
      new Edge("Z", "X")
    )

    @main
    def main(): Set[String] = {
      for (e <- new Graph().path("X")) yield e.end
    }

    def path(x: String): Set[Edge] = {
        (for (d <- this.edges if d.start == x) yield d)
        ++
        (for (i <- this.edges if i.start == x; y <- this.path(i.end)) yield y)
    }
}
