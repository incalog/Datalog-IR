module Graph

class Edge {
  var start: String
  var end: String

  def this(s: String, e: String) = {
    this.start = s
    this.end = e
  }
}

class Graph {
    var counter: Int = 0

    val edges: Set[Edge] = Set(
      new Edge("X", "Y"),
      new Edge("Y", "Z"),
      // introduce a cycle
      new Edge("Z", "X")
    )

    @main
    def main(): Set[Edge] = {
      new Graph().path("X")
    }

    def path(x: String): Set[Edge] = {
        this.counter = 1
        (for (d <- this.edges if d.start == x) yield d)
        ++
        (for (i <- this.edges if i.start == x; y <- this.path(i.end)) yield y)
    }
}
