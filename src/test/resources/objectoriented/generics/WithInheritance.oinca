module WithInheritance

class A[T] {
    var a: T

    def this(value: T) = {
        this.a = value
    }

    def get(): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val B1: B[Int] = new B[Int](0,1)
        // val C1: C[Int] = new C[Int](true, 1)
        return (A1.a == 1) && ((B1.a == 0) && (B1.b == 1)) // && ((C1.c == 1) && C1.c)
    }
}


class B[T] extends A[T] {
    var b: T

    def this(value: T, value2: T) = {
        super(value)
        this.b = value2
    }
}

