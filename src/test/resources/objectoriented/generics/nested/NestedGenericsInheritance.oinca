module NestedGenericsInheritance

class A[T] {
    var a: T
    def this(value: T) = {
        this.a = value
    }
    def get(): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
      val a1: A[Int] = new A[Int](1)
      val b1: B[A[Int]] = new B[A[Int]](a1)
      val c1: C[A[Int]] = new C[A[Int]](a1)
      return c1.get().get() == 1
    }
}

class B[T] {
    var b: T
    def this(value: T) = {
        this.b = value
    }
    def get(): T = {
        return this.b
    }
}

class C[T] extends B[T] {
    var c: T
    def this(value: T) = {
        this.c = value
    }
}
