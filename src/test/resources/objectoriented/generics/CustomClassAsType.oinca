module CustomClassAsType

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get[T]: T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val newA1 = new A[B](new B[Int](1))
        return (newA1.a.b == 1)
    }
}

class B[T] {
    val b: T

    def this(value: T) = {
        this.b = value
    }

    def get[T]: T = {
        return this.b
    }
}

