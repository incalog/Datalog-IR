module InstancesWithDifferentTypes

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get[T](): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val newA1: A[Int] = new A[Int](1)
        val newA2: A[String] = new A[String]("Hello")

        return (newA1.a == 1) && (newA2.a == "Hello")
    }
}