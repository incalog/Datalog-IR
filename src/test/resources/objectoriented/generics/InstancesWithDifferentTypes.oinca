module InstancesWithDifferentTypes

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get(): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val A2: A[String] = new A[String]("Hello")

        return (A1.a == 1) && (A2.a == "Hello")
    }
}