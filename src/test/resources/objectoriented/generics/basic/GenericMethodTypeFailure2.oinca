module GenericMethodTypeFailure2

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get[T2, A](value: T2): T2 = {     // should not work (A is already a Class)
        return value
    }

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val res: Int = A1.get[Int, Int](1)
        return res == 1
    }

}