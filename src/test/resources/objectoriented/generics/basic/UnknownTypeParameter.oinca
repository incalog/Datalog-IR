module UnknownTypeParameter

class A[T] {
    val a: T2   // should throw error

    def this(value: T2) = {
        this.a = value
    }

    def get(): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val res: Int = A1.get()
        return (res == 1)
    }
}
