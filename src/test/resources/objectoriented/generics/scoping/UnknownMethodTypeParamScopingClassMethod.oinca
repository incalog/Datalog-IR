module UnknownMethodTypeParamScopingClassMethod

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get[T2](value: T2): T2 = {
                return value
            }

    def give(value: T2): T = {     // should throw error (Unbound T2)
        return this.a
    }

    @main
    def main(): Boolean = {
            val A1: A[Int] = new A[Int](1)
            val res: String = A1.get[String]("Hello World!")
            val res2: Int = A1.give("Hello World!")
            return (res == "Hello World!") && (res2 == 1)
            }
}
