module UnknownTypeParamScopingInheritanceClass

class A[T] {
    val a: T   // should throw error

    def this(value: T) = {
        this.a = value
    }

    def get(): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val B1: B[Int] = new B[Int](2)
        val res: Int = B1.get()
        return (res == 1)
    }
}

class B[T2] extends A[Int] {
    val b: T

    def this(value: T) = {
        this.b = value
    }
}