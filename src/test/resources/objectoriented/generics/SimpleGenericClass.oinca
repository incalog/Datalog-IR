module SimpleGenericClass

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get[T](): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val res: Int = A1.get[Int]()
        return A1.a == 1 //&& (res == 1)
    }
}


