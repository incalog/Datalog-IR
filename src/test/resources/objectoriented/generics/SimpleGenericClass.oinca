module SimpleGenericClass

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get(): T = {
        return this.a
    }

    @main
    def main(): Boolean = {
        var a1: A[Int]
        a1 = new A[Int](1)
        val res: Int = a1.get()
        //val res2: String = a1.a   // should not work
        val res2: Int = a1.a
        return (res2 == 1) && (res == 1)
    }
}

