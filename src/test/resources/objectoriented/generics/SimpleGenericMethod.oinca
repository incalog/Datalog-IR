module SimpleGenericMethod

class A[T] {
    val a: T

    def this(value: T) = {
        this.a = value
    }

    def get[T2,T3](value: T2): T2 = {
        return value
    }

    def get2[T2](value: T2): T2 = {
        return value
    }

    /*def get2[T2, A](value: T2): A = {     // should not work
        return value
    }*/

    @main
    def main(): Boolean = {
        val A1: A[Int] = new A[Int](1)
        val res: String = A1.get[String,Int]("Hello World")
        return (A1.a == 1) && (res == "Hello World")
    }
}
