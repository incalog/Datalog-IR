module GenericClassInheritance

class A[T] {
    var a: T

    def this(value: T) = {
        this.a = value
    }

    def get(): T = {
        return this.a
    }

    def get2(value: T): T = {
        return value
    }

    @main
    def main(): Boolean = {
        //val a1: A[Int] = new A[Int](1)
        val b1: B[Int] = new B[Int](0,1)
        return (b1.get() == 0) && (b1.b == 1) && (b1.a == 0)
    }
}


class B[T] extends A[T] {
    var b: T

    def this(value: T, value2: T) = {
        super(value)
        this.b = value2
    }
}


