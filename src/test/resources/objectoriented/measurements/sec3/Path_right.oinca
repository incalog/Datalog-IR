module GraphTest

class Graph {
    def line(from: Int, to: Int): Set[(Int, Int)] = {
        if (from < to-1)
            Set((from, from + 1)) ++ this.line(from + 1, to)
        else
            Set((from, to))
    }

    def loop(from: Int, to: Int, step: Int): Set[(Int, Int)] = {
      	if (from < to) {
        	this.line(from, from+step) ++ Set((from + step, from)) ++ this.loop(from + step, to, step)
        } else if (from == to) {
			Set((from-step, from))
        } else {
      		this.line(to, from)
        }
    }

    @main
    def main(endNode: Int, step: Int): Set[(Int, Int)] = {
      val g: Graph = new Graph()
      val edges: Set[(Int, Int)] = g.loop(0, endNode, step) ++ Set((endNode, 0))
      for (e <- g.path(edges)) yield (e._1, e._2)
    }

    def path(edges: Set[(Int, Int)]): Set[(Int, Int)] = {
        edges
        ++
        (for (e <- edges; p <- this.path(edges) if e._2 == p._1) yield (e._1, p._2))
    }
}
