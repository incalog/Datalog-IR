module GraphTest

class Graph {
    @main
    def main(): Set[(Int, Int)] = {
      val g: Graph = new Graph()
      for (e <- g.path(Set.from[(Int, Int)](edbEdges))) yield (e._1, e._2)
    }

    def path(edges: Set[(Int, Int)]): Set[(Int, Int)] = {
        (for (p <- this.path(edges); e <- edges if e._2 == p._1) yield (e._1, p._2))
        ++
        edges
    }
}

