module GraphTest

class Dummy(val id: Int) {}

class Graph {
    def line(from: Int, to: Int): Set[(Int, Int)] = {
        if (from < to-1)
            Set((from, from + 1)) ++ this.line(from + 1, to)
        else
            Set((from, to))
    }

    def loop(from: Int, to: Int): Set[(Int, Int)] = {
        this.line(from, to) ++ Set((to, from))
    }

    def generateDummy(start: Int, end: Int): Int = {
        if (start < end) {
            // Prevent Datalog from optimizing this code away
            val d: Dummy = new Dummy(1)
            this.generateDummy(start+1, end)
            return d.id
        }
        return 1
    }

    /*@main
    def main(numDummyObjs: Int): Set[(Int, Int)] = {
      val g: Graph = new Graph()
      val i: Int = g.generateDummy(0, numDummyObjs)
      val edges: Set[(Int, Int)] = g.line(1, 10) ++ g.loop(10, 50)
      for (e <- edges; r <- g.path(e._1, edges)) yield (e._1, r)
     }

     def path(x: Int, edges: Set[(Int, Int)]): Set[Int] = {
         (for (d <- edges if d._1 == x) yield d._2)
         ++
         (for (i <- edges if i._1 == x; y <- this.path(i._2, edges)) yield y)
     }*/

     @main
     def main(numDummyObjs: Int): Set[(Int, Int)] = {
       val g: Graph = new Graph()
       val i: Int = g.generateDummy(0, numDummyObjs)
       for (e <- g.path(g.line(1, 10) ++ g.loop(10, 50))) yield (e._1, e._2)
     }

     def path(edges: Set[(Int, Int)]): Set[(Int, Int)] = {
         edges
         ++
         (for (e <- edges; p <- this.path(edges) if e._2 == p._1) yield (e._1, p._2))
     }
}
