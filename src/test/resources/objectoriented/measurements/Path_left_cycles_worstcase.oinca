module GraphTest

class Graph {
    // All edges from `from` to `to`
    def line(from: Int, to: Int): Set[(Int, Int)] = {
        if (from < to-1)
            this.line(from + 1, to) ++ Set((from, from + 1))
        else
            Set((from, to))
    }

  	// Connect current with all other nodes in the graph
  	def fullyConnect(current: Int, startNode: Int, endNode: Int): Set[(Int, Int)] = {
      if (endNode > startNode)
      	Set((current, endNode)) ++ this.fullyConnect(current, startNode, endNode-1)
      else
      	Set((current, endNode))
    }

    // Add fully connect every `step` node with all others
    def cycles(current: Int, step: Int, startNode: Int, endNode: Int): Set[(Int, Int)] = {
        if (current < endNode)
            this.cycles(current + step, step, startNode, endNode) ++ this.fullyConnect(current, startNode, endNode)
        else if (current == endNode)
            this.line(startNode, endNode) ++ this.fullyConnect(current, startNode, endNode)
        else
            this.line(startNode, endNode)
    }

    @main
    def main(endNode: Int, step: Int): Set[(Int, Int)] = {
      val g: Graph = new Graph()
      val edges: Set[(Int, Int)] = g.cycles(1, step, 1, endNode)
      for (e <- edges; r <- g.path(e._1, edges)) yield (e._1, r)
    }

    def path(x: Int, edges: Set[(Int, Int)]): Set[Int] = {
        (for (y <- this.path(x, edges); i <- edges if i._1 == y) yield i._2)
        ++
        (for (d <- edges if d._1 == x) yield d._2)
    }
}
