class While(val cnd: Exp, val body: Stm) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.cnd.accept(v)
        this.body.accept(v)
        v.visitWhile(this)
    }

    @override
    def stringValue(): String = {
        "While(" + this.cnd.stringValue() + ", " + this.body.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.transferAll(from, this.body.first())

        fix manager.transferAll(this.body.last(), this)
        fix manager.transferAll(this.body.last(), this.body.first())

        /*for (l2 <- this.body.last()) yield
            manager.transferAll(l2, this)
        for (l <- this.body.last()) yield
            manager.transferAll(l, this.body.first())*/

        return
    }
}
class ValDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitValDef(this)
    }

    @override
    def stringValue(): String = {
        "ValDef(" + this.name + ", " + this.rhs.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.put(this, this.name, this.rhs.aevalSign(manager, from))
    }
}
class VarDef(val name: String, val rhs: Exp) extends Stm {
    @override
    def accept(v: Visitor): Unit = {
        this.rhs.accept(v)
        v.visitVarDef(this)
    }

    @override
    def stringValue(): String = {
        "VarDef(" + this.name + ", " + this.rhs.stringValue() + ")"
    }

    @override
    def transfer(from: Stm, manager: ValueManager): Unit = {
        manager.transferAll(from, this)
        manager.put(this, this.name, this.rhs.aevalSign(manager, from))
    }
}

// Mark: - Lattice

case class MSign extends BalancedMonotone[MSign, MSign] {
    @static
    def init(): MSign = { new BotSign() }

    @static
    def join(c1: MSign, c2: MSign): MSign = { c1.joined(c2) }

    // The current hack ignores the lift
    def lift(v: MSign): MSign = { v }
    def joined(that: MSign): MSign = { this }
    def add(that: MSign): MSign = { this }
    def sub(that: MSign): MSign = { this }
    def mul(that: MSign): MSign = { this }
    def gt(that: MSign): MSign = { this }
    def stringValue(): String = { "MSign" }
}

case class BotSign extends MSign {
    @override
	def joined(that: MSign): MSign = { that }

	@override
	def stringValue(): String = { "Bot" }
}

case class TopSign extends MSign {
    @override
	def joined(that: MSign): MSign = { this }

    @override
    def stringValue(): String = { "Top" }
}

case class PosSign extends MSign {
    @override
	def joined(that: MSign): MSign = {
		if (that.isInstanceOf[PosSign] || that.isInstanceOf[BotSign]) this else new TopSign()
	}

    @override
	def add(that: MSign): MSign = {
        if (that.isInstanceOf[PosSign] || that.isInstanceOf[ZeroSign] || that.isInstanceOf[BotSign]) this else new TopSign()
    }

    @override
    def sub(that: MSign): MSign = {
		if (that.isInstanceOf[NegSign] || that.isInstanceOf[ZeroSign] || that.isInstanceOf[BotSign]) this else new TopSign()
    }

    @override
    def mul(that: MSign): MSign = {
		if (that.isInstanceOf[NegSign] || that.isInstanceOf[ZeroSign] || that.isInstanceOf[PosSign])
			that
		else
			new TopSign()
    }

    @override
    def stringValue(): String = { "Pos" }
}

case class NegSign extends MSign {
    @override
	def joined(that: MSign): MSign = {
		if (that.isInstanceOf[NegSign] || that.isInstanceOf[BotSign]) this else new TopSign()
	}

    @override
	def add(that: MSign): MSign = {
        if (that.isInstanceOf[NegSign] || that.isInstanceOf[ZeroSign] || that.isInstanceOf[BotSign]) this else new TopSign()
    }

    @override
    def sub(that: MSign): MSign = {
		if (that.isInstanceOf[PosSign] || that.isInstanceOf[ZeroSign] || that.isInstanceOf[BotSign]) this else new TopSign()
    }

    @override
    def mul(that: MSign): MSign = {
		if (that.isInstanceOf[NegSign])
			new PosSign()
		else if (that.isInstanceOf[PosSign] || that.isInstanceOf[BotSign])
			this
		else if (that.isInstanceOf[ZeroSign])
			that
		else
			new TopSign()
    }

	@override
	def stringValue(): String = { "Neg" }
}

case class ZeroSign extends MSign {
    @override
	def joined(that: MSign): MSign = {
		if (that.isInstanceOf[ZeroSign] || that.isInstanceOf[BotSign]) this else new TopSign()
	}

    @override
	def add(that: MSign): MSign = { that }

    @override
    def sub(that: MSign): MSign = {
		if (that.isInstanceOf[NegSign])
			new PosSign()
		else if (that.isInstanceOf[PosSign])
			new NegSign()
		else if (that.isInstanceOf[ZeroSign] || that.isInstanceOf[BotSign])
			this
		else
			new TopSign()
    }

    @override
    def mul(that: MSign): MSign = { this }

	@override
	def stringValue(): String = { "Zero" }
}

// Mark: - CFG

class Visitor {
    // Exp
    def visitVar(e: Var): Unit = { }
    def visitNum(e: Num): Unit = { }
    def visitAdd(e: Add): Unit = { }
    def visitSub(e: Sub): Unit = { }
    def visitMul(e: Mul): Unit = {}
    def visitGT(e: GT): Unit = {}

    // Stm
    def visitAssign(s: Assign): Unit = { }
    def visitSkip(s: Skip): Unit = { }
    def visitSequence(s: Sequence): Unit = { }
    //def visitIf(s: If): Unit = { }
    def visitWhile(s: While): Unit = { }
    def visitValDef(s: ValDef): Unit = { }
    def visitVarDef(s: VarDef): Unit = { }
}

class MonoSet extends BalancedMonotone[(Any, Any), `scala.collection.immutable.Set[(Any, Any)]`] {
    @static
    def init(): `scala.collection.immutable.Set[(Any, Any)]` = {
        `scala.collection.immutable.Set[(Any, Any)]`()
    }

    @static
    def join(m1: `scala.collection.immutable.Set[(Any, Any)]`, m2: `scala.collection.immutable.Set[(Any, Any)]`): `scala.collection.immutable.Set[(Any, Any)]` = {
        m1 ++ m2
    }

    def lift(element: (Any, Any)): `scala.collection.immutable.Set[(Any, Any)]` = {
        `scala.collection.immutable.Set[(Any, Any)]`(`Tuple2.apply`(element._1, element._2))
    }

    def get(): `scala.collection.immutable.Set[(Any, Any)]` = {
        this.result
    }
}

class CfgVisitor extends Visitor {
  var cfg: MonoSet = new MonoSet()

  def cfgSet(): Set[(Stm, Stm)] = {
    val set: `scala.collection.immutable.Set[(Any, Any)]` = this.cfg.get()
    val list: `scala.collection.immutable.Vector[(Any, Any)]` = set.`toVector`
    this.cfgSetIter(list, 0)
  }

  def cfgSetIter(list: `scala.collection.immutable.Vector[(Any, Any)]`, ix: Int): Set[(Stm, Stm)] = {
    val e: `(Any, Any)` = list.`apply`(ix)
    val s1: Stm = e.`productElement`(0).asInstanceOf[Stm]
    val s2: Stm = e.`productElement`(1).asInstanceOf[Stm]
    if (ix == list.`size` - 1) {
      Set((s1, s2))
    } else {
      Set((s1, s2)) ++ this.cfgSetIter(list, ix + 1)
    }
  }

  def addPath(from: Stm, to: Stm): Unit = {
    this.cfg += (from,to)
  }

  @override
  def visitSequence(s: Sequence): Unit = {
    this.addPath(s.s1.last(), s.s2.first())
    /*
     val to: Stm = s.s2.first()
     for (from <- s.s1.last())
        yield this.addPath(from, to)*/
    return
  }

  /*@override
  def visitIf(s: If): Unit = {
    this.cfg += (s,s.thn.first())
    this.cfg += (s,s.els.first())
  }*/

  @override
  def visitWhile(s: While): Unit = {
    this.cfg += (s, s.body.first())
    this.addPath(s.body.last(), s)
    /*for (from <- s.body.last())
        yield this.addPath(from, s)*/
    return
  }
}

// Mark: - Constant Analysis

class ValueManager {
    def get(s: Stm, v: String): MSign = {
        new TopSign()
    }

    def put(s: Stm, v: String, m: MSign): Unit = { }

    def transferAll(from: Stm, to: Stm): Unit = { }
}

class FSSignAnalysis(val head: Stm, val cfg: Set[(Stm, Stm)], val varNames: Set[String]) extends ValueManager {
    val after: MonoMap[`(Any, String)`, MSign] = new MonoMap[`(Any, String)`, MSign]()

    @override
    def get(s: Stm, v: String): MSign = {
        return this.after.get(`Tuple2.apply`(s, v))
    }

    @override
    def put(s: Stm, v: String, m: MSign): Unit = {
        this.after += (`Tuple2.apply`(s, v), m)
    }

    def run(): Unit = {
        val start: Stm = new Skip()
        for (v <- this.varNames) yield
            this.put(start, v, new BotSign())
        this.head.transfer(start, this)
        this.iterate()
    }

    /*def run(): Unit = {
        this.runInternal()
        return this.readableResult()
    }*/

    def iterate(): Unit = {
        for (e <- this.cfg)
            yield e._2.transfer(e._1, this)
        fix this.iterate()
        return
    }

    @override
    def transferAll(from: Stm, to: Stm): Unit = {
        for (y <- this.varNames) yield
            this.put(to, y, this.get(from, y))
        return
    }

    /*def readableResult(): Set[(String, String, String)] = {
        (for (k <- this.after.keys() if !this.after.get(k).isInstanceOf[BotSign])
            yield (k.`_1`.asInstanceOf[Stm].stringValue(), k.`_2`, this.after.get(k).stringValue()))
    }*/
}


class Examples {
    val varNames: Set[String] = Set("a") // set by benchmark

    def generateWhile(size: Int, cur: Int, numAssign: Int, varName: String): Stm = {
        if (cur == 0) {
          val lastName: String = `((x: String, s: Int) => (x(0) + s).toChar.toString)`("a", size - 1)
          return new Assign("a", new Add(new Var("a"), new Var(lastName)))
        }

        val vName: String = `((x: String) => (x(0) + 1).toChar.toString)`(varName)
        if (cur == size)
          return new While(
            new Num(1), this.generateAssignSequence(numAssign, numAssign, varName, this.generateWhile(size, cur-1, numAssign, vName))
          )
        else
          return new While(
            new Num(1), this.generateAssignSequence(numAssign, numAssign, varName, this.generateWhile(size, cur-1, numAssign, vName))
          )
    }

    def generateAssignSequence(size: Int, cur: Int, varName: String, last: Stm): Stm = {
        if (cur == 0)
          return last
        if (cur == size)
           return new Sequence(new VarDef(varName, new Num(1)), this.generateAssignSequence(size, cur-1, varName, last))
        else
           return new Sequence(new Assign(varName, new Num(1)), this.generateAssignSequence(size, cur-1, varName, last))
    }
}

class CFGHelper(val prog: Stm) {
    def getCFG(): Set[(Stm, Stm)] = {
        // Calculate CFG
        val cfgVisitor: CfgVisitor = new CfgVisitor()
        this.prog.accept(cfgVisitor)
        return cfgVisitor.cfgSet()
    }
}

class ConstantAnalysis {
    @main
    def main(numWhiles: Int, numAssigns: Int): Unit = {
        val examples: Examples = new Examples()
        val prog: Stm = examples.generateWhile(numWhiles, numWhiles, numAssigns, "a")
        val cfgHelper: CFGHelper = new CFGHelper(prog)

        // Do constant propagation
        val signProp: FSSignAnalysis = new FSSignAnalysis(prog.first(), cfgHelper.getCFG(), examples.varNames)
        signProp.run()
    }
}



