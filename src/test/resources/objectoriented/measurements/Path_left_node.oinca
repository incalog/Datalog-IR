module GraphTest

class Node(val id: Int) {}

class Graph {
    def line(from: Int, to: Int): Set[(Node, Node)] = {
        if (from < to-1)
            Set((new Node(from), new Node(from + 1))) ++ this.line(from + 1, to)
        else
            Set((new Node(from), new Node(to)))
    }

    def loop(from: Int, step: Int, to: Int): Set[(Node, Node)] = {
        this.line(from, to) ++ Set((new Node(to), new Node(from)))
    }

    @main
    def main(endNode: Int): Set[(Int, Int)] = {
      val g: Graph = new Graph()
      val edges: Set[(Node, Node)] = g.line(1, 10) ++ g.loop(10, endNode)
      for (e <- g.path(edges)) yield (e._1.id, e._2.id)
    }

    def path(edges: Set[(Node, Node)]): Set[(Node, Node)] = {
        (for (p <- this.path(edges); e <- edges if e._2.id == p._1.id) yield (e._1, p._2))
        ++
        edges
    }
}
