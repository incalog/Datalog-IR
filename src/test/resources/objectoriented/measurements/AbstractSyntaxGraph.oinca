module ASG

class Visitor {
  def visitProg(n: Prog): Unit = { }
  def visitDef(d: Def): Unit = { }
  def visitNum(n: Num, d: Def): Unit = { }
  def visitVar(v: Var, d: Def): Unit = { }
  def visitAdd(a: Add, d: Def): Unit = { }
}

class Prog(val defs: `List[Any]`) {
  def forEach(list: `List[Any]`, v: Visitor, i: Int, size: Int): Unit = {
    if (i >= size) return
    val ele: Def = list.`apply`(i).asInstanceOf[Def]
    ele.accept(v)
    this.forEach(list, v, i+1, size)
  }

  def accept(v: Visitor): Unit = {
    val defs: `List[Any]` = this.defs
    this.forEach(defs, v, 0, defs.`size`)
    v.visitProg(this)
  }
}

class Def(val name: String, val exp: Exp) {
  def accept(v: Visitor): Unit = {
    v.visitDef(this)
    this.exp.accept(v, this)
  }
}

class Exp {
  def accept(v: Visitor, d: Def): Unit = {}
}
class Num(val value: Int) extends Exp {
  @override def accept(v: Visitor, d: Def): Unit = {
    v.visitNum(this, d)
  }
}
class Var(val name: String) extends Exp {
  var target: Def = null
  @override def accept(v: Visitor, d: Def): Unit = {
    v.visitVar(this, d)
  }
}
class Add(val lhs: Exp, val rhs: Exp) extends Exp {
  @override def accept(v: Visitor, d: Def): Unit = {
    v.visitAdd(this, d)
    this.lhs.accept(v, d)
    this.rhs.accept(v, d)
  }
}

class NameAnalysis(val prog: Prog) extends Visitor {
  def findByName(list: `List[Any]`, name: String, i: Int, size: Int): Def = {
    if (i >= size) return null
    val ele: Def = list.`apply`(i).asInstanceOf[Def]
    if (ele.name == name) return ele
    this.findByName(list, name, i+1, size)
  }

  @override def visitVar(v: Var, d: Def): Unit = {
    val defs: `List[Any]` = this.prog.defs
    v.target = this.findByName(defs, v.name, 0, defs.`size`)
  }
}

case class Edge(val from: Def, val to: Def) { }

class DependencyAnalysis extends Visitor {
  val edges: MonotoneSet = new MonotoneSet()

  def edgeSet(): Set[Edge] = {
    val set: `scala.collection.immutable.Set[Any]` = this.edges.get()
    val list: `scala.collection.immutable.Vector[Any]` = set.`toVector`
    this.edgeSetIter(list, 0)
  }
  def edgeSetIter(list: `scala.collection.immutable.Vector[Any]`, ix: Int): Set[Edge] = {
    val e: Edge = list.`apply`(ix).asInstanceOf[Edge]
    if (ix == list.`size` - 1) {
      Set(e)
    } else {
      Set(e) ++ this.edgeSetIter(list, ix + 1)
    }
  }

  @override def visitVar(v: Var, d: Def): Unit = {
    val trg: Def = v.target
    if (trg != null) {
      this.edges += new Edge(d, trg)
      fix trg.accept(this)
    }
  }

  def directDependencies(d: Def): Set[Def] = {
    for (e <- this.edgeSet() if e.from == d) yield e.to
  }

  def dependencies(d1: Def): Set[Def] = {
    this.directDependencies(d1) ++
    for (d2 <- this.directDependencies(d1);
         d3 <- this.dependencies(d2))
      yield d3
  }
}

class MonotoneSet extends BalancedMonotone[Any, `scala.collection.immutable.Set[Any]`] {
    @static
    def init(): `scala.collection.immutable.Set[Any]` = {
        `scala.collection.immutable.Set[Any]`()
    }

    @static
    def join(m1: `scala.collection.immutable.Set[Any]`, m2: `scala.collection.immutable.Set[Any]`): `scala.collection.immutable.Set[Any]` = {
        m1 ++ m2
    }

    def lift(element: Any): `scala.collection.immutable.Set[Any]` = {
        `scala.collection.immutable.Set[Any]`(element)
    }

    def get(): `scala.collection.immutable.Set[Any]` = {
        this.result
    }
}

class ReachVisitor extends Visitor {
  val reachable: MonotoneSet = new MonotoneSet()

  @override def visitDef(d: Def): Unit = {
    this.reachable += d
  }

  @override def visitVar(v: Var, d: Def): Unit = {
    val trg: Def = v.target
    if (trg != null)
        fix trg.accept(this)
  }
}

class Mapper {
    def mkDef(i: Int): Def = {
      val n: Int = i+1
      new Def("a" + i.`toString`, new Add(new Var("a" + n.`toString`), new Num(i)))
    }

    def line(i: Int, to: Int): `List[Any]` = {
      if (i < to) {
        val d: Def = this.mkDef(i)
        val ds: `List[Any]` = this.line(i + 1, to)
        d +: ds
      } else {
        `Nil`
      }
    }

    def circle(from: Int, to: Int): Def = {
        new Def("a" + to.`toString`, new Add(new Var("a" + from.`toString`), new Num(to)))
    }

    def prog(from: Int, to: Int, step: Int): `List[Any]` = {
        if (from < to) {
          (this.line(from, from+step) :+ this.circle(from+step, from)) ++ this.prog(from+step, to, step)
        } else {
          `List[Any]`(this.circle(0, to))
        }
    }
}

class ProgEntry {
  @main
  def main(endNode: Int, step: Int): Unit = {
    val mapper: Mapper = new Mapper()

    val defs: `List[Any]` = mapper.prog(0, endNode, step)
    val main: Def = defs.`head`.asInstanceOf[Def]
    val prog: Prog = new Prog(defs)

    val resolving: NameAnalysis = new NameAnalysis(prog)
    prog.accept(resolving)

    val depending: DependencyAnalysis = new DependencyAnalysis()
    prog.accept(depending)
  }
}