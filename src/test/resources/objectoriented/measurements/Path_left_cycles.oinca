module GraphTest

class Graph {
    def line(from: Int, to: Int): Set[(Int, Int)] = {
        if (from < to-1)
            this.line(from + 1, to) ++ Set((from, from + 1))
        else
            Set((from, to))
    }

    def loop(from: Int, to: Int): Set[(Int, Int)] = {
        this.line(from, to) ++ Set((to, from))
    }

    // Add a loop after each step
    def cycles(current: Int, step: Int, endNode: Int): Set[(Int, Int)] = {
        if (current < endNode)
            this.cycles(current+step, step, endNode) ++ this.loop(current, current+step)
        else
            this.line(current, endNode) ++ Set((endNode, current))
    }

    @main
    def main(endNode: Int, step: Int): Set[(Int, Int)] = {
      val g: Graph = new Graph()
      val edges: Set[(Int, Int)] = g.line(1, 10) ++ g.cycles(10, step, endNode)
      for (e <- edges; r <- g.path(e._1, edges)) yield (e._1, r)
    }

    def path(x: Int, edges: Set[(Int, Int)]): Set[Int] = {
        (for (y <- this.path(x, edges); i <- edges if i._1 == y) yield i._2)
        ++
        (for (d <- edges if d._1 == x) yield d._2)
    }
}
