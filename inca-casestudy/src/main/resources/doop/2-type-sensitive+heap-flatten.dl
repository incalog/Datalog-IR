   mainAnalysis_MethodHandleCallGraphEdge(_,?invo,_,?method,?mh,_),
   basic_ClassConstructor(?method,?type),
   ThisVar(?method,_),
   mainAnalysis_isImmutableHContext(_),
   AssignReturnValue(?invo,?ret),
   Var_Type(?ret,?retType),
   basic_SubtypeOf(?type,?retType).

mainAnalysis_Value_DeclaringType(cat("<method type (",cat(?dynParamTypes,cat(")",cat(?dynRetType,">")))),"java.lang.Object") :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,_,_),
   DynamicMethodInvocation_DynReturnType(?invokedynamic,?dynRetType),
   DynamicMethodInvocation_DynParamTypes(?invokedynamic,?dynParamTypes).

mainAnalysis_Value_DeclaringType(cat("<mock method handles lookup object for type ",cat(?callerClass,">")),"java.lang.Object") :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,_,?bootMethod),
   FormalParam(0,?bootMethod,_),
   FormalParam(2,?bootMethod,_),
   mainAnalysis_Invokedynamic_MethodType(?invokedynamic,_),
   mainAnalysis_isImmutableHContext(_),
   Instruction_Method(?invokedynamic,?method),
   Method_DeclaringType(?method,?callerClass).

mainAnalysis_Value_DeclaringType(cat("<bootstrap varargs array for ",cat(?invokedynamic,">")),"java.lang.Object") :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,_,?bootMethod),
   mainAnalysis_MethodVarArgs(?bootMethod,?bootIdx,_,_),
   BootstrapParam(?idx,?invokedynamic,?actual),
   ?idx > (?bootIdx-3),
   mainAnalysis_VarPointsTo(_,_,_,?actual),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_DeclaringType(cat(?invokedynamic,cat("::: ",cat(?dynRetType,cat("::: (Mock)::: ",cat("reference ",cat(?handleType,cat("::",cat(?handleMeth,cat(" from ",cat(?implMethod,cat(" wrapped as ",cat(?dynRetType,cat(".",?dynName))))))))))))),"java.lang.Object") :- 
   mainAnalysis_ReachableLambdaMetafactoryInvoke(?invokedynamic,?dynName,?dynRetType,?callerCtx),
   DynamicMethodInvocation_DynArity(?invokedynamic,_),
   BootstrapParam(1,?invokedynamic,?handleVar),
   mainAnalysis_VarPointsTo(_,?handleVal,?callerCtx,?handleVar),
   MethodHandleConstant_Method(?handleVal,?implMethod),
   Method_SimpleName(?implMethod,?handleMeth),
   Method_DeclaringType(?implMethod,?handleType),
   AssignReturnValue(?invokedynamic,_).

mainAnalysis_Value_DeclaringType(cat("<mock object of type ",cat(?type,cat(" constructed by constructor reference at ",cat(?i,">")))),"java.lang.Object") :- 
   mainAnalysis_LambdaCallGraphEdge(_,?i,_,?implMethod,_),
   basic_ClassConstructor(?implMethod,?type),
   AssignReturnValue(?i,_),
   ThisVar(?implMethod,_),
   mainAnalysis_isImmutableHContext(_).

