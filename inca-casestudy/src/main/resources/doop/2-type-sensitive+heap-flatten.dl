   mainAnalysis_isImmutableContext(?callerCtx),
   mainAnalysis_FakeInvocation_ThreadGroupInit(?invo).

mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invo,?value,"<java.lang.ThreadGroup: void <init>(java.lang.ThreadGroup,java.lang.String)>",1) :- 
