   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(?tableField,?mapClass),
   Field_SimpleName(?tableField,"table"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(?hctx),
   mainAnalysis_isImmutableHContext(?basehctx).

mainAnalysis_InstanceFieldPointsTo(?hctx,?entryBeanMockObject,?valueField,?basehctx,cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node")) :- 
   BeanMap(?id,?mapClass,_),
   BeanMapEntry(?id,?entryBeanId,?entryBeanMockObject),
   Field_DeclaringType(_,?mapClass),
   Field_SimpleName(_,"contents"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(?hctx),
   mainAnalysis_isImmutableHContext(?basehctx).

mainAnalysis_InstanceFieldPointsTo(?hctx,?entryBeanId,?keyField,?basehctx,cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node")) :- 
   BeanMap(?id,?mapClass,_),
   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(_,?mapClass),
   Field_SimpleName(_,"contents"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(?hctx),
   mainAnalysis_isImmutableHContext(?basehctx).

mainAnalysis_InstanceFieldPointsTo(?hctx,cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node"),?contentsField,?basehctx,?mapMockObject) :- 
   BeanMap(?id,?mapClass,?mapMockObject),
   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(_,?mapClass),
   Field_SimpleName(?contentsField,"contents"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(?hctx),
   mainAnalysis_isImmutableHContext(?basehctx).

mainAnalysis_Instruction_Throws(?hctx,?value,?ctx,?insn) :- 
   Throw(?insn,?var),
   mainAnalysis_VarPointsTo(?hctx,?value,?ctx,?var).

mainAnalysis_Instruction_Throws(?hctx,?value,?callerCtx,?invocation) :- 
   mainAnalysis_ThrowPointsTo(?hctx,?value,?calleeCtx,?tomethod),
   mainAnalysis_CallGraphEdge(?callerCtx,?invocation,?calleeCtx,?tomethod). .plan 1:(2,1)

mainAnalysis_InvokedynamicBootCallGraphEdge(?callerCtx,?invokedynamic,?calleeCtx,?bootMethod) :- 
   mainAnalysis_ReachableInvokedynamic(?invokedynamic,_,_,?callerCtx),
   DynamicMethodInvocation_Bootstrap(?invokedynamic,?bootMethod),
   mainAnalysis_isBootstrapMethodContext(?calleeCtx).

mainAnalysis_InvokedynamicCallSite(?callsite,?invokedynamic,?dynName,?K,?callerCtx) :- 
   mainAnalysis_ReachableInvokedynamic(?invokedynamic,?dynName,_,?callerCtx),
   DynamicMethodInvocation_DynArity(?invokedynamic,?K),
   DynamicMethodInvocation_Bootstrap(?invokedynamic,?bootMethod),
   ReturnVar(?bootRetVar,?bootMethod),
   mainAnalysis_isBootstrapMethodContext(?calleeCtx),
   mainAnalysis_VarPointsTo(_,?callsite,?calleeCtx,?bootRetVar).

mainAnalysis_Invokedynamic_MethodType(?invokedynamic,cat("<method type (",cat(?dynParamTypes,cat(")",cat(?dynRetType,">"))))) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,_,_),
   DynamicMethodInvocation_DynReturnType(?invokedynamic,?dynRetType),
   DynamicMethodInvocation_DynParamTypes(?invokedynamic,?dynParamTypes).

mainAnalysis_LambdaArg(?calleeCtx,?formal,?formalType,?actual,?invokedynamic) :- 
   mainAnalysis_LambdaCallGraphEdge(_,?i,?calleeCtx,?implMethod,?lambda),
   mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,?shiftK,?shiftN),
   mainAnalysis_LambdaObject(?invokedynamic,?lambda,_,?K,?implMethod,_),
   ActualParam(?idx,?i,?actual),
   FormalParam( _tmp_0,?implMethod,?formal),
   Var_Type(?formal,?formalType),
    _tmp_0 = (((?K-?shiftK)+?idx)-?shiftN).

mainAnalysis_LambdaCallGraphEdge(?callerCtx,?i,?calleeCtx,?implMethod,?lambda) :- 
   mainAnalysis_LambdaObject(_,?lambda,?dynName,_,?implMethod,_),
   mainAnalysis_VarPointsTo(_,?lambda,?callerCtx,?var),
   VirtualMethodInvocation_Base(?i,?var),
   VirtualMethodInvocation_SimpleName(?i,?dynName),
   mainAnalysis_isImmutableContext(?calleeCtx).

mainAnalysis_LambdaCaptured(?invokedynamic,?val,?idx,?hctx) :- 
   mainAnalysis_ReachableLambdaMetafactoryInvoke(?invokedynamic,_,_,?callerCtx),
   DynamicMethodInvocation_DynArity(?invokedynamic,?K),
   ?K > 0,
   ActualParam(?idx,?invokedynamic,?actual),
   mainAnalysis_VarPointsTo(?hctx,?val,?callerCtx,?actual).

mainAnalysis_LambdaMetafactoryInvoke(?invokedynamic) :- 
   DynamicMethodInvocation_Bootstrap(?invokedynamic,?method),
   ?method = "<java.lang.invoke.LambdaMetafactory: java.lang.invoke.CallSite metafactory(java.lang.invoke.MethodHandles$Lookup,java.lang.String,java.lang.invoke.MethodType,java.lang.invoke.MethodType,java.lang.invoke.MethodHandle,java.lang.invoke.MethodType)>".

mainAnalysis_LambdaMetafactoryInvoke(?invokedynamic) :- 
   DynamicMethodInvocation_Bootstrap(?invokedynamic,?method),
   ?method = "<java.lang.invoke.LambdaMetafactory: java.lang.invoke.CallSite altMetafactory(java.lang.invoke.MethodHandles$Lookup,java.lang.String,java.lang.invoke.MethodType,java.lang.Object[])>".

mainAnalysis_LambdaObject(?invokedynamic,cat(?invokedynamic,cat("::: ",cat(?dynRetType,cat("::: (Mock)::: ",cat("reference ",cat(?handleType,cat("::",cat(?handleMeth,cat(" from ",cat(?implMethod,cat(" wrapped as ",cat(?dynRetType,cat(".",?dynName))))))))))))),?dynName,?K,?implMethod,?callerCtx) :- 
   mainAnalysis_ReachableLambdaMetafactoryInvoke(?invokedynamic,?dynName,?dynRetType,?callerCtx),
   DynamicMethodInvocation_DynArity(?invokedynamic,?K),
   BootstrapParam(1,?invokedynamic,?handleVar),
   mainAnalysis_VarPointsTo(_,?handleVal,?callerCtx,?handleVar),
   MethodHandleConstant_Method(?handleVal,?implMethod),
   Method_SimpleName(?implMethod,?handleMeth),
   Method_DeclaringType(?implMethod,?handleType),
   AssignReturnValue(?invokedynamic,_).

mainAnalysis_LoadFromReference(?ctx,?to,?basehctx,?basevalue) :- 
   mainAnalysis_LoadFromReferenceArgs(?base,?to),
   mainAnalysis_VarPointsTo(?basehctx,?basevalue,?ctx,?base).

mainAnalysis_LoadFromReferenceArgs(?base,?to) :- 
   ?refGet = "<java.lang.ref.Reference: java.lang.Object getReferent()>",
   MethodInvocation_Method(?invo,?refGet),
   mainAnalysis_OptSpecialMethodInvocationBase(?invo,?base),
   AssignReturnValue(?invo,?to).

mainAnalysis_LoadHeapArrayIndex(?ctx,?to,?basehctx,?basevalue) :- 
   mainAnalysis_ReachableLoadArrayIndexBase(?base),
   mainAnalysis_OptLoadArrayIndex(?to,?base),
   mainAnalysis_VarPointsTo(?basehctx,?basevalue,?ctx,?base).

mainAnalysis_LoadHeapInstanceField(?ctx,?to,?sig,?basehctx,?basevalue) :- 
   LoadInstanceField(?base,?sig,?to,_),
   mainAnalysis_VarPointsTo(?basehctx,?basevalue,?ctx,?base).

mainAnalysis_MainThread(?hctx,?alloc) :- 
   mainAnalysis_isImmutableHContext(?hctx),
   ?alloc = "<<main-thread>>",
   isValue(?alloc).

mainAnalysis_MainThreadGroup(?hctx,?alloc) :- 
   mainAnalysis_isImmutableHContext(?hctx),
   ?alloc = "<<main-thread-group>>",
   isValue(?alloc).

mainAnalysis_MethodAllocationMergeThreshold(50).

mainAnalysis_MethodAndTypeToHeap(?heap,?heaptype,?meth) :- 
   AssignHeapAllocation(?heap,_,?meth),
   HeapAllocation_Type(?heap,?heaptype),
   !isStringConstant(?heap),
   !mainAnalysis_StringFactoryHeap(?heap),
   !HeapAllocation_EmptyArray(?heap),
   !mainAnalysis_ObjectMultipleAllocated(?heap).

mainAnalysis_MethodAndTypeToMergedHeap(?heap,?heaptype,?meth) :- 
   mainAnalysis_AllocationShouldBeMergedPerMethod(?heaptype,?meth),
   mainAnalysis_MethodAndTypeToHeap(?heap,?heaptype,?meth).

mainAnalysis_MethodAndTypeToRepresentative(?type,?meth,?representativeHeap) :- 
   isHeapAllocation(?representativeHeap),
   mainAnalysis_MinHeapOrdinalPerMethodAndType(?minHeapOrd,?type,?meth),
   ord(?representativeHeap) = ?minHeapOrd.

mainAnalysis_MethodHandleCGE_Arg(?callerCtx,?calleeCtx,?actual,?formal,?actualType,?formalType,?name) :- 
   mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invo,?calleeCtx,?method,_,?name),
   Method_Modifier("static",?method),
   ActualParam(?idx,?invo,?actual),
   FormalParam(?idx,?method,?formal),
   Var_Type(?actual,?actualType),
   Var_Type(?formal,?formalType).

mainAnalysis_MethodHandleCGE_Arg(?callerCtx,?calleeCtx,?actual,?formal,?actualType,?formalType,?name) :- 
   mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invo,?calleeCtx,?method,_,?name),
   !Method_Modifier("static",?method),
   ActualParam(?idx,?invo,?actual),
   ?idx > 0,
   FormalParam( _tmp_1,?method,?formal),
   Var_Type(?actual,?actualType),
   Var_Type(?formal,?formalType),
    _tmp_1 = (?idx-1).

mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invo,?calleeCtx,?method,?mh,?name) :- 
   mainAnalysis_configuration_StaticContextResponse(?callerCtx,?invo,?calleeCtx),
   mainAnalysis_MethodHandleCallGraphEdge_Candidate(?callerCtx,?invo,?method,?mh,?name).

mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invo,?calleeCtx,?method,?mh,?name) :- 
   mainAnalysis_MethodHandleCallGraphEdge_Candidate(?callerCtx,?invo,?method,?mh,?name),
   !Method_Modifier("static",?method),
   mainAnalysis_isImmutableContext(?calleeCtx).

mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invokedynamic,?calleeCtx,?method,?mh,"invokeExact") :- 
   mainAnalysis_StaticMethodHandleCall(?callerCtx,?invokedynamic,?method,?mh),
   mainAnalysis_configuration_StaticContextResponse(?callerCtx,?invokedynamic,?calleeCtx).

mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invokedynamic,?calleeCtx,?method,?mh,"invokeExact") :- 
   mainAnalysis_CallSiteMatchesMethodHandleType(?invokedynamic,?mh,?method,?callerCtx),
   !Method_Modifier("static",?method),
   mainAnalysis_isImmutableContext(?calleeCtx).

mainAnalysis_MethodHandleCallGraphEdge_Candidate(?callerCtx,?invo,?method,?mh,?name) :- 
   mainAnalysis_ReachableContext(?callerCtx,?containingMethod),
   _VirtualMethodInvocation(?invo,_,_,?base,?containingMethod),
   _PolymorphicInvocation(?invo,?name),
   mainAnalysis_VarPointsTo(_,?mh,?callerCtx,?base),
   mainAnalysis_MethodHandle_Method(?mh,?method). .plan 1:(4,5,2,1,3), 2:(5,4,2,1,3)

mainAnalysis_MethodHandleCallGraphEdge_Candidate(?callerCtx,?invo,?method,?mh,?name) :- 
   mainAnalysis_ReachableContext(?callerCtx,?containingMethod),
   _SpecialMethodInvocation(?invo,_,_,?base,?containingMethod),
   _PolymorphicInvocation(?invo,?name),
   mainAnalysis_VarPointsTo(_,?mh,?callerCtx,?base),
   mainAnalysis_MethodHandle_Method(?mh,?method). .plan 1:(4,5,2,1,3), 2:(5,4,2,1,3)

mainAnalysis_MethodHandle_Method(?methodHandle,?method) :- 
   MethodHandleConstant_Method(?methodHandle,?method),
   MethodHandleConstant_ParamTypes(?methodHandle,_),
   MethodHandleConstant_ReturnType(?methodHandle,_),
   MethodHandleConstant_Arity(?methodHandle,_).

mainAnalysis_MethodHandle_Method(cat("<adapter for ",cat(?mh,cat(" as ",?mt))),?mhMethod) :- 
   _VirtualMethodInvocation(?invo,_,?sig,?base,?method),
   mainAnalysis_ReachableContext(?ctx,?method),
   ?sig = "<java.lang.invoke.MethodHandle: java.lang.invoke.MethodHandle asType(java.lang.invoke.MethodType)>",
   mainAnalysis_VarPointsTo(_,?mh,?ctx,?base),
   ActualParam(0,?invo,?arg),
   mainAnalysis_VarPointsTo(_,?mt,?ctx,?arg),
   AssignReturnValue(?invo,_),
   mainAnalysis_MethodHandle_Method(?mh,?mhMethod),
   Method_ParamTypes(?mhMethod,_).

mainAnalysis_MethodHandle_MethodType(?methodHandle,cat("<method type (",cat(?paramTypes,cat(")",cat(?retType,">"))))) :- 
   MethodHandleConstant_Method(?methodHandle,_),
   MethodHandleConstant_ParamTypes(?methodHandle,?paramTypes),
   MethodHandleConstant_ReturnType(?methodHandle,?retType),
   MethodHandleConstant_Arity(?methodHandle,_).

mainAnalysis_MethodHandle_MethodType(cat("<adapter for ",cat(?mh,cat(" as ",?mt))),?mt) :- 
   _VirtualMethodInvocation(?invo,_,?sig,?base,?method),
   mainAnalysis_ReachableContext(?ctx,?method),
   ?sig = "<java.lang.invoke.MethodHandle: java.lang.invoke.MethodHandle asType(java.lang.invoke.MethodType)>",
   mainAnalysis_VarPointsTo(_,?mh,?ctx,?base),
   ActualParam(0,?invo,?arg),
   mainAnalysis_VarPointsTo(_,?mt,?ctx,?arg),
   AssignReturnValue(?invo,_),
   mainAnalysis_MethodHandle_Method(?mh,?mhMethod),
   Method_ParamTypes(?mhMethod,_).

mainAnalysis_MethodType_ReturnType(?mt,?retType) :- 
   MethodTypeConstant_ReturnType(?mt,?retType).

mainAnalysis_MethodType_ReturnType(cat("<method type (",cat(?paramTypes,cat(")",cat(?retType,">")))),?retType) :- 
   MethodHandleConstant_Method(?methodHandle,_),
   MethodHandleConstant_ParamTypes(?methodHandle,?paramTypes),
   MethodHandleConstant_ReturnType(?methodHandle,?retType),
   MethodHandleConstant_Arity(?methodHandle,_).

mainAnalysis_MethodType_ReturnType(cat("<method type (",cat(?dynParamTypes,cat(")",cat(?dynRetType,">")))),?dynRetType) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,_,_),
   DynamicMethodInvocation_DynReturnType(?invokedynamic,?dynRetType),
   DynamicMethodInvocation_DynParamTypes(?invokedynamic,?dynParamTypes).

mainAnalysis_MethodVarArgs(?method,?idx,?formal,?type) :- 
   Method_Modifier("varargs",?method),
   Method_Arity(?method,?arity),
   ?idx = (?arity-1),
   FormalParam(?idx,?method,?formal),
   Var_Type(?formal,?type),
   isArrayType(?type).

mainAnalysis_MinHeapOrdinalPerMethodAndType(?minHeapOrd,?type,?meth) :- 
   mainAnalysis_MethodAndTypeToMergedHeap(_,?type,?meth),
   ?minHeapOrd = min ord(?heap): mainAnalysis_MethodAndTypeToMergedHeap(?heap, ?type, ?meth).

mainAnalysis_MinRepresentativeHeapToPickFromOrdinal(?minHeapReprOrd,?heap) :- 
   mainAnalysis_RepresentativesToPickFrom(_,?heap),
   ?minHeapReprOrd = min ord(?heapRepr): mainAnalysis_RepresentativesToPickFrom(?heapRepr, ?heap).

mainAnalysis_MockedMethodReturns("<java.sql.DriverManager: java.sql.Connection getConnection(java.lang.String,java.util.Properties,java.lang.Class)>",cat("<mock SQL connection of type ",cat(?type,">")),?type) :- 
   basic_SubtypeOf(?type,"java.sql.Connection"),
   isClassType(?type).

mainAnalysis_NotEmptyArrayValue(?heapValue) :- 
   mainAnalysis_Value_isHeap(?heapValue),
   isHeapAllocation(?heapValue),
   !HeapAllocation_EmptyArray(?heapValue).

mainAnalysis_NotEmptyArrayValue(?value) :- 
   mainAnalysis_Value_isNonHeap(?value).

mainAnalysis_NotSpecialObject(?value) :- 
   mainAnalysis_Value_isHeap(?value).

mainAnalysis_NotSpecialObject(?value) :- 
   mainAnalysis_Value_isMock(?value).

mainAnalysis_ObjectMultipleAllocated(?heap) :- 
   mainAnalysis_OptAssignHeapAllocation(?inmethod1,?heap),
   mainAnalysis_OptAssignHeapAllocation(?inmethod2,?heap),
   ?inmethod1 != ?inmethod2.

mainAnalysis_OpaqueCallGraphEdge(?invo,?sig) :- 
   _VirtualMethodInvocation(?invo,_,?sig,?base,?method),
   mainAnalysis_ReachableContext(?ctx,?method),
   ?sig = "<java.lang.invoke.MethodHandle: java.lang.invoke.MethodHandle asType(java.lang.invoke.MethodType)>",
   mainAnalysis_VarPointsTo(_,?mh,?ctx,?base),
   ActualParam(0,?invo,?arg),
   mainAnalysis_VarPointsTo(_,_,?ctx,?arg),
   AssignReturnValue(?invo,_),
   mainAnalysis_MethodHandle_Method(?mh,?mhMethod),
   Method_ParamTypes(?mhMethod,_).

mainAnalysis_OptArgAssign(?calleeCtx,?formal,?callerCtx,?actual,?allowedType) :- 
   mainAnalysis_CallGraphEdge(?callerCtx,?invocation,?calleeCtx,?method),
   ActualParam(?index,?invocation,?actual),
   FormalParam(?index,?method,?formal),
   Var_Type(?formal,?allowedType).

mainAnalysis_OptArgVarPointsTo(?hctx,?value,?actualCtx,?actual) :- 
   mainAnalysis_VarPointsTo(?hctx,?value,?actualCtx,?actual),
   ActualParam(_,_,?actual).

mainAnalysis_OptAssignCast(?type,?to,?from) :- 
   mainAnalysis_Reachable(?inmethod),
   AssignCast(?type,?from,?to,?inmethod).

mainAnalysis_OptAssignHeapAllocation(?inmethod,?heap) :- 
   AssignHeapAllocation(?heap,_,?inmethod).

mainAnalysis_OptLoadArrayIndex(?to,?base) :- 
   LoadArrayIndex(?base,?to,_).

mainAnalysis_OptLoadHeapArrayIndex(?to,?basevalue) :- 
   mainAnalysis_LoadHeapArrayIndex(_,?to,_,?basevalue).

mainAnalysis_OptRetVarPointsTo(?hctx,?value,?returnCtx,?return) :- 
   mainAnalysis_VarPointsTo(?hctx,?value,?returnCtx,?return),
   ReturnVar(?return,_).

mainAnalysis_OptReturnAssign(?callerCtx,?local,?calleeCtx,?return) :- 
   mainAnalysis_CallGraphEdge(?callerCtx,?invocation,?calleeCtx,?method),
   AssignReturnValue(?invocation,?local),
   ReturnVar(?return,?method).

mainAnalysis_OptSpecialMethodInvocationBase(?invocation,?base) :- 
   mainAnalysis_Reachable(?inmethod),
   Instruction_Method(?invocation,?inmethod),
   SpecialMethodInvocation_Base(?invocation,?base).

mainAnalysis_OptStoreArrayIndex(?from,?base) :- 
   StoreArrayIndex(?from,?base,_).

mainAnalysis_OptStoreIntoArray(?hctx,?value,?basehctx,?basevalue) :- 
   mainAnalysis_StoreHeapArrayIndex(?basehctx,?basevalue,?ctx,?from),
   mainAnalysis_VarPointsTo(?hctx,?value,?ctx,?from).

mainAnalysis_OptSuperMethodInvocationBase(?invocation,?base) :- 
   mainAnalysis_Reachable(?inmethod),
   Instruction_Method(?invocation,?inmethod),
   SuperMethodInvocation_Base(?invocation,?base).

mainAnalysis_OptVirtualMethodInvocationBase(?invocation,?base) :- 
   mainAnalysis_Reachable(?inmethod),
   Instruction_Method(?invocation,?inmethod),
   VirtualMethodInvocation_Base(?invocation,?base).

mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,0,0) :- 
   mainAnalysis_LambdaObject(_,?lambda,_,_,?implMethod,_),
   Method_Modifier("static",?implMethod).

mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,0,1) :- 
   mainAnalysis_CalledInstanceImplMethod(?invokedynamic,?implMethod,_,_,_,?lambda),
   DynamicMethodInvocation_DynArity(?invokedynamic,0).

mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,1,0) :- 
   mainAnalysis_CalledInstanceImplMethod(?invokedynamic,?implMethod,_,_,_,?lambda),
   mainAnalysis_LambdaCaptured(?invokedynamic,_,0,_).

mainAnalysis_PrimitiveType_Boxed("boolean","java.lang.Boolean").

mainAnalysis_PrimitiveType_Boxed("byte","java.lang.Byte").

mainAnalysis_PrimitiveType_Boxed("short","java.lang.Short").

mainAnalysis_PrimitiveType_Boxed("char","java.lang.Character").

mainAnalysis_PrimitiveType_Boxed("int","java.lang.Integer").

mainAnalysis_PrimitiveType_Boxed("long","java.lang.Long").

mainAnalysis_PrimitiveType_Boxed("float","java.lang.Float").

mainAnalysis_PrimitiveType_Boxed("double","java.lang.Double").

mainAnalysis_Reachable(?method) :- 
   mainAnalysis_ReachableContext(_,?method).

mainAnalysis_ReachableAnnotationMethod(?annotMethod,?annotation) :- 
   mainAnalysis_ReachableContext(_,?method),
   Method_Annotation(?method,?annotation),
   Method_DeclaringType(?annotMethod,?annotation).

mainAnalysis_ReachableContext(?ctx,?method) :- 
   mainAnalysis_isImmutableContext(?ctx),
   EntryPointMethod(?method).

mainAnalysis_ReachableContext(?calleeCtx,?method) :- 
   mainAnalysis_MethodHandleCallGraphEdge(_,_,?calleeCtx,?method,_,_).

mainAnalysis_ReachableContext(?calleeCtx,?bootMethod) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,_,?calleeCtx,?bootMethod).

mainAnalysis_ReachableContext(?calleeCtx,?callee) :- 
   mainAnalysis_MethodHandleCallGraphEdge(_,_,?calleeCtx,?callee,_,_).

mainAnalysis_ReachableContext(?calleeCtx,?callee) :- 
   mainAnalysis_LambdaCallGraphEdge(_,_,?calleeCtx,?callee,_).

mainAnalysis_ReachableContext(?calleeCtx,?register) :- 
   mainAnalysis_configuration_ContextResponse(?callerCtx,?hctx,?fakeinvo,?heapValue,?register,?calleeCtx),
   mainAnalysis_FinalizeContextRequest(?callerCtx,?hctx,?fakeinvo,?heapValue,?register,_). .plan 1:(2,1)

mainAnalysis_ReachableContext(?ctx,?meth) :- 
   mainAnalysis_ForcedReachableContext(?ctx,?meth).

mainAnalysis_ReachableContext(?calleeCtx,?run) :- 
   ?start = "<java.lang.Thread: void start0()>",
   ThisVar(?start,?startThis),
   mainAnalysis_CallGraphEdge(_,_,?calleeCtx,?start),
   mainAnalysis_VarPointsTo(_,?value,?calleeCtx,?startThis),
   mainAnalysis_Value_Type(?value,?valuetype),
   basic_MethodLookup("run","void()",?valuetype,?run),
   ThisVar(?run,_).

mainAnalysis_ReachableContext(?calleeCtx,?signature) :- 
   ?signature = "<java.lang.ThreadGroup: void <init>()>",
   ThisVar(?signature,_),
   mainAnalysis_SystemThreadGroup(?hctx,?value),
   mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invo,?value,?signature,1),
   mainAnalysis_configuration_ContextResponse(?callerCtx,?hctx,?invo,?value,?signature,?calleeCtx).

mainAnalysis_ReachableContext(?calleeCtx,?signature) :- 
   ?signature = "<java.lang.ThreadGroup: void <init>(java.lang.ThreadGroup,java.lang.String)>",
   ThisVar(?signature,_),
   mainAnalysis_MainThreadGroup(?hctx,?value),
   FormalParam(0,?signature,_),
   mainAnalysis_SystemThreadGroup(_,_),
   mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invo,?value,?signature,1),
   mainAnalysis_configuration_ContextResponse(?callerCtx,?hctx,?invo,?value,?signature,?calleeCtx).

mainAnalysis_ReachableContext(?calleeCtx,?signature) :- 
   ?signature = "<java.lang.Thread: void <init>(java.lang.ThreadGroup,java.lang.String)>",
   ThisVar(?signature,_),
   mainAnalysis_MainThread(?hctx,?value),
   FormalParam(0,?signature,_),
   mainAnalysis_MainThreadGroup(_,_),
   mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invo,?value,?signature,1),
   mainAnalysis_configuration_ContextResponse(?callerCtx,?hctx,?invo,?value,?signature,?calleeCtx).

mainAnalysis_ReachableContext(?initialContext,?method) :- 
   mainAnalysis_isImmutableContext(?initialContext),
   basic_MainMethodDeclaration(?method).

mainAnalysis_ReachableContext(?ctx,?method) :- 
   mainAnalysis_isImmutableContext(?ctx),
   mainAnalysis_ImplicitReachable(?method).

mainAnalysis_ReachableContext(?clinitContext,?clinit) :- 
   mainAnalysis_isImmutableContext(?clinitContext),
   mainAnalysis_InitializedClass(?class),
   mainAnalysis_ClassInitializer(?class,?clinit).

mainAnalysis_ReachableContext(?ctx,?method) :- 
   mainAnalysis_CallGraphEdge(_,_,?ctx,?method).

mainAnalysis_ReachableContext(?ctx0,?annotMethod) :- 
   mainAnalysis_ReachableAnnotationMethod(?annotMethod,_),
   mainAnalysis_isImmutableContext(?ctx0).

mainAnalysis_ReachableCurrentThreadInvocation(?callerCtx,?local) :- 
   ?signature = "<java.lang.Thread: java.lang.Thread currentThread()>",
   StaticMethodInvocation(?invocation,?signature,?inmethod),
   mainAnalysis_ReachableContext(?callerCtx,?inmethod),
   AssignReturnValue(?invocation,?local).

mainAnalysis_ReachableInvokedynamic(?invokedynamic,?dynName,?dynRetType,?ctx) :- 
   isDynamicMethodInvocation_Insn(?invokedynamic),
   Instruction_Method(?invokedynamic,?inMethod),
   DynamicMethodInvocation_DynName(?invokedynamic,?dynName),
   DynamicMethodInvocation_DynReturnType(?invokedynamic,?dynRetType),
   mainAnalysis_ReachableContext(?ctx,?inMethod).

mainAnalysis_ReachableLambdaMetafactoryInvoke(?invokedynamic,?dynName,?dynRetType,?ctx) :- 
   mainAnalysis_LambdaMetafactoryInvoke(?invokedynamic),
   mainAnalysis_ReachableInvokedynamic(?invokedynamic,?dynName,?dynRetType,?ctx).

mainAnalysis_ReachableLoadArrayIndexBase(?base) :- 
   mainAnalysis_Reachable(?inmethod),
   LoadArrayIndex(?base,_,?inmethod).

mainAnalysis_ReachableStoreArrayIndexBase(?base) :- 
   mainAnalysis_Reachable(?inmethod),
   StoreArrayIndex(_,?base,?inmethod).

