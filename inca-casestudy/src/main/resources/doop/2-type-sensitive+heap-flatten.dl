   basic_ClassConstructor(?implMethod,?type),
   AssignReturnValue(?i,_),
   ThisVar(?implMethod,_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_isMock(cat("<mock value for forced-reachable parameter ",cat(?class,">"))) :- 
   mainAnalysis_FormalOfForcedReachableContext(_,_,?formalType),
   mainAnalysis_TypeToConcreteImplementation(?formalType,?class),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_isMock(cat(?class,"::MockObject")) :- 
   ExercisedEntryPointMethod(?class,?method),
   ThisVar(?method,_),
   mainAnalysis_isImmutableContext(_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_isMock(cat(?class,"::MockObject")) :- 
   mainAnalysis_ForcedReachable(?method),
   Method_DeclaringType(?method,?class),
   ThisVar(?method,_),
   mainAnalysis_isImmutableContext(_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_isNonHeap(?value) :- 
   mainAnalysis_Value_isMock(?value).

mainAnalysis_VarPointsTo(?hctx,?value,?ctx,?bridgeParam) :- 
   ExercisedEntryPointMethod(?entryPoint,?bridge),
   BridgeMethod(?bridge,?entryPoint),
   basic_MethodMightBeCovariantBridge(?bridge,?method),
   FormalParam(?index,?bridge,?bridgeParam),
   FormalParam(?index,?method,?methodParam),
   mainAnalysis_VarPointsTo(?hctx,?value,?ctx,?methodParam),
   MockObjFromOpenProgramEntryPointArg(?value).

mainAnalysis_VarPointsTo(?immHctx,?beanMockObject,?ctx,?return) :- 
   DependencyInjectedMethod(?method),
   mainAnalysis_ReachableContext(?ctx,?method),
   ReturnVar(?return,?method),
   Method_SimpleName(?method,?simplename),
   ConcreteBean_Id(?beanClass,?simplename),
   MockObject(?beanMockObject,?beanClass),
   mainAnalysis_isImmutableHContext(?immHctx).

mainAnalysis_VarPointsTo(?hctx,?value,?ctx,?param) :- 
   mainAnalysis_Instruction_Throws(?hctx,?value,?ctx,?insn),
   mainAnalysis_Value_Type(?value,?valueType),
   basic_ExceptionHandler_InRange(?handler,?insn),
   ExceptionHandler_Type(?handler,?handlerType),
   basic_SubtypeOf(?valueType,?handlerType),
   ConcreteClass(?valueType),
   ExceptionHandler_FormalParam(?handler,?param),
   !basic_ExceptionHandler_Impossible(?valueType,?handler,?insn). .plan 1:(2,1,3,4,5,6,7)

mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?formal) :- 
   mainAnalysis_MethodHandleCGE_Arg(?callerCtx,?calleeCtx,?actual,?formal,?actualType,?formalType,_),
   mainAnalysis_VarPointsTo(?hctx,?val,?callerCtx,?actual),
   basic_SubtypeOf(?actualType,?formalType).

mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?this) :- 
   mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invo,?calleeCtx,?method,_,_),
   !Method_Modifier("static",?method),
   ActualParam(0,?invo,?actual),
   mainAnalysis_VarPointsTo(?hctx,?val,?callerCtx,?actual),
   ThisVar(?method,?this),
   Var_Type(?actual,?actualType),
   Var_Type(?this,?thisType),
   basic_SubtypeOf(?actualType,?thisType).

mainAnalysis_VarPointsTo(?hctx,?val,?callerCtx,?var) :- 
   mainAnalysis_MethodHandleCallGraphEdge(?callerCtx,?invo,?calleeCtx,?method,_,_),
   ReturnVar(?ret,?method),
   mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?ret),
   AssignReturnValue(?invo,?var),
   Var_Type(?ret,?retType),
   Var_Type(?var,?varType),
   mainAnalysis_CompatibleTypes(?retType,?varType).

mainAnalysis_VarPointsTo(?hctx,?retVal,?callerCtx,?ret) :- 
   mainAnalysis_LambdaCallGraphEdge(?callerCtx,?i,?calleeCtx,?method,_),
   ReturnVar(?realReturnVar,?method),
   mainAnalysis_VarPointsTo(?hctx,?retVal,?calleeCtx,?realReturnVar),
   AssignReturnValue(?i,?ret).

mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?formal) :- 
   mainAnalysis_LambdaArg(?calleeCtx,?formal,?formalType,?actual,_),
   mainAnalysis_VarPointsTo(?hctx,?val,_,?actual),
   mainAnalysis_Value_Type(?val,?valType),
   basic_SubtypeOf(?valType,?formalType).

mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?formal) :- 
   mainAnalysis_LambdaArg(?calleeCtx,?formal,?formalType,?actual,?invokedynamic),
   mainAnalysis_ReachableLambdaMetafactoryInvoke(?invokedynamic,_,?dynRetType,_),
   Var_Type(?actual,?primType),
   mainAnalysis_BoxingFunction(?dynRetType,?primType,?formalType),
   mainAnalysis_BoxAllocation(?val,?formalType),
   mainAnalysis_isImmutableHContext(?hctx).

mainAnalysis_VarPointsTo(?hctx,?thisValue,?calleeCtx,?this) :- 
   mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,1,0),
   mainAnalysis_CalledInstanceImplMethod(?invokedynamic,?implMethod,?this,?thisType,?calleeCtx,?lambda),
   mainAnalysis_LambdaCaptured(?invokedynamic,?thisValue,0,?hctx),
   mainAnalysis_Value_Type(?thisValue,?thisValueType),
   basic_SubtypeOf(?thisValueType,?thisType).

mainAnalysis_VarPointsTo(?hctx,?argValue,?calleeCtx,?this) :- 
   mainAnalysis_LambdaCallGraphEdge(?callerCtx,?i,?calleeCtx,?implMethod,?lambda),
   mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,0,1),
   ActualParam(0,?i,?actual),
   mainAnalysis_VarPointsTo(?hctx,?argValue,?callerCtx,?actual),
   mainAnalysis_Value_Type(?argValue,?argType),
   ThisVar(?implMethod,?this),
   Var_Type(?this,?thisType),
   basic_SubtypeOf(?argType,?thisType).

mainAnalysis_VarPointsTo(?hctx,?heapValue,?calleeCtx,?formal) :- 
   mainAnalysis_configuration_ContextResponse(?callerCtx,?hctx,?fakeinvo,?heapValue,?register,?calleeCtx),
   mainAnalysis_FinalizeContextRequest(?callerCtx,?hctx,?fakeinvo,?heapValue,?register,?formal). .plan 1:(2,1)

mainAnalysis_VarPointsTo(?hctx,?argArray,?ctx,?args) :- 
   mainAnalysis_isImmutableHContext(?hctx),
   basic_MainMethodDeclaration(?mainMethod),
   mainAnalysis_ReachableContext(?ctx,?mainMethod),
   FormalParam(0,?mainMethod,?args),
   MainMethodArgArray(?argArray),
   MainMethodArgArrayContent(_).

mainAnalysis_VarPointsTo(?hctx,?value,?calleeCtx,?runThis) :- 
   ?start = "<java.lang.Thread: void start0()>",
   ThisVar(?start,?startThis),
   mainAnalysis_CallGraphEdge(_,_,?calleeCtx,?start),
   mainAnalysis_VarPointsTo(?hctx,?value,?calleeCtx,?startThis),
   mainAnalysis_Value_Type(?value,?valuetype),
   basic_MethodLookup("run","void()",?valuetype,?run),
   ThisVar(?run,?runThis).

