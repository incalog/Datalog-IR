mainAnalysis_Value_Null(?nullheap) :- 
   HeapAllocation_Null(?nullheap).

mainAnalysis_Value_Type(?heapValue,?type) :- 
   isHeapAllocation(?heapValue),
   HeapAllocation_Type(?heapValue,?type).

mainAnalysis_Value_Type(?value,?type) :- 
   Instruction_Method(?invocation,?inmethod),
   mainAnalysis_ReachableContext(_,?inmethod),
   MethodInvocation_Method(?invocation,?method),
   mainAnalysis_MockedMethodReturns(?method,?value,?type),
   AssignReturnValue(?invocation,_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_Type(cat(?concreteType,"::MockObject"),?concreteType) :- 
   ExercisedEntryPointMethod(?entryPointDeclaringType,?method),
