Stats_Metrics("7.0","app instance field points-to (INS)",c) :- 
   c = count : { Stats_Simple_Application_InsensInstanceFieldPointsTo(_,_,_) }.

Stats_Metrics("7.5","app instance field points-to (SENS)",c) :- 
