mainAnalysis_SpecialConcreteImplementations(?class,?type) :- 
   isClassType(?class),
   basic_SubtypeOf(?class,?type),
   mainAnalysis_ServletParamType(?type).

mainAnalysis_SpecialLibraryClass(?class) :- 
   isClassType(?class),
   !ApplicationClass(?class),
   !mainAnalysis_CollectionClass(?class).

mainAnalysis_SpecialLibraryMethod(?method) :- 
   Method_DeclaringType(?method,?class),
   mainAnalysis_SpecialLibraryClass(?class).

mainAnalysis_SpecialLibraryObject(?heap) :- 
   AssignHeapAllocation_Heap(?insn,?heap),
   Instruction_Method(?insn,?method),
   mainAnalysis_SpecialLibraryMethod(?method).

mainAnalysis_StaticFieldPointsTo(?hctx,?value,?pending) :- 
   ?pending = "<java.lang.ref.Reference: java.lang.ref.Reference pending>",
   ?this = "<java.lang.ref.Reference: void <init>(java.lang.Object,java.lang.ref.ReferenceQueue)>/@this",
   isField(?pending),
   isVar(?this),
   mainAnalysis_VarPointsTo(?hctx,?value,_,?this).

mainAnalysis_StaticFieldPointsTo(?hctx,?value,?pending) :- 
   ?pending = "<java.lang.ref.Reference: java.lang.ref.Reference pending>",
   ?this = "<java.lang.ref.Reference: void <init>(java.lang.Object,java.lang.ref.ReferenceQueue)>/v1",
   isField(?pending),
   isVar(?this),
   mainAnalysis_VarPointsTo(?hctx,?value,_,?this).

mainAnalysis_StaticFieldPointsTo(?hctx,?value,?signature) :- 
   mainAnalysis_ReachableStoreStaticFieldFrom(?from),
   StoreStaticField(?from,?signature,_),
   mainAnalysis_VarPointsTo(?hctx,?value,_,?from).

mainAnalysis_StaticMethodHandleCall(?callerCtx,?invokedynamic,?method,?mh) :- 
   mainAnalysis_CallSiteMatchesMethodHandleType(?invokedynamic,?mh,?method,?callerCtx),
   Method_Modifier("static",?method).

mainAnalysis_StoreHeapArrayIndex(?basehctx,?basevalue,?ctx,?from) :- 
