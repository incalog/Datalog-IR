   Instruction_Method(?invokedynamic,?method),
   Method_DeclaringType(?method,?callerClass).

mainAnalysis_VarPointsTo(?immHctx,?mt,?calleeCtx,?invokedTypeParam) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,?calleeCtx,?bootMethod),
   FormalParam(0,?bootMethod,_),
   FormalParam(2,?bootMethod,?invokedTypeParam),
