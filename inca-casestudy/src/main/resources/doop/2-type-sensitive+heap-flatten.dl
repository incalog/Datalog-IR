mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invo,?value,"<java.lang.Thread: void <init>(java.lang.ThreadGroup,java.lang.String)>",1) :- 
   mainAnalysis_MainThread(?hctx,?value),
   mainAnalysis_isImmutableContext(?callerCtx),
