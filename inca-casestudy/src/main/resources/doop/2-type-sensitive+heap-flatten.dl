mainAnalysis_VarPointsTo(?hctx,cat("<adapter for ",cat(?mh,cat(" as ",?mt))),?ctx,?ret) :- 
   _VirtualMethodInvocation(?invo,_,?sig,?base,?method),
   mainAnalysis_ReachableContext(?ctx,?method),
   ?sig = "<java.lang.invoke.MethodHandle: java.lang.invoke.MethodHandle asType(java.lang.invoke.MethodType)>",
   mainAnalysis_VarPointsTo(?hctx,?mh,?ctx,?base),
   ActualParam(0,?invo,?arg),
   mainAnalysis_VarPointsTo(_,?mt,?ctx,?arg),
   AssignReturnValue(?invo,?ret),
   mainAnalysis_MethodHandle_Method(?mh,?mhMethod),
   Method_ParamTypes(?mhMethod,_).

