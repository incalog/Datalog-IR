mainAnalysis_VarPointsTo(?immHctx,cat("<mock method handles lookup object for type ",cat(?callerClass,">")),?calleeCtx,?caller) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,?calleeCtx,?bootMethod),
   FormalParam(0,?bootMethod,?caller),
