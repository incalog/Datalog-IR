   mainAnalysis_VarPointsTo(?hctx,?value,?callerCtx,?base),
   MethodInvocation_Method(?invocation,?tomethod).

mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invo,?value,"<java.lang.ThreadGroup: void <init>()>",1) :- 
