mainAnalysis_configuration_ContextResponse(?callerCtx,[?hctxType],?invo,?value,?tomethod,[?hctxType,?type]) :- 
   mainAnalysis_configuration_ContextRequest(?callerCtx,[?hctxType],?invo,?value,?tomethod,_),
   mainAnalysis_Value_DeclaringType(?value,?type).

mainAnalysis_configuration_InitContextRequest("<<immutable-context>>").

mainAnalysis_configuration_InitContextResponse(?value,[?value,?value]) :- 
   mainAnalysis_configuration_InitContextRequest(?value).

mainAnalysis_configuration_InitHContextRequest("<<immutable-hcontext>>").

mainAnalysis_configuration_InitHContextResponse(?value,[?value]) :- 
   mainAnalysis_configuration_InitHContextRequest(?value).

mainAnalysis_configuration_RecordContextRequest(?ctx,?heapValue,?var) :- 
   mainAnalysis_AssignNormalHeapAllocation(?heapValue,?var,?inmethod),
   mainAnalysis_ReachableContext(?ctx,?inmethod).

mainAnalysis_configuration_RecordContextResponse([?ctxType1,?ctxType2],?value,?var,[?ctxType2]) :- 
   mainAnalysis_configuration_RecordContextRequest([?ctxType1,?ctxType2],?value,?var).

mainAnalysis_configuration_StaticContextRequest(?callerCtx,?invo) :- 
   mainAnalysis_MethodHandleCallGraphEdge_Candidate(?callerCtx,?invo,?method,_,_),
   Method_Modifier("static",?method).

mainAnalysis_configuration_StaticContextRequest(?callerCtx,?invokedynamic) :- 
   mainAnalysis_CallSiteMatchesMethodHandleType(?invokedynamic,_,?method,?callerCtx),
   Method_Modifier("static",?method).

mainAnalysis_configuration_StaticContextRequest(?callerCtx,?invocation) :- 
   mainAnalysis_ReachableContext(?callerCtx,?inmethod),
   StaticMethodInvocation(?invocation,_,?inmethod).

mainAnalysis_configuration_StaticContextResponse(?callerCtx,?invo,?callerCtx) :- 
   mainAnalysis_configuration_StaticContextRequest(?callerCtx,?invo).

mainAnalysis_isBootstrapMethodContext(?ctx) :- 
   mainAnalysis_isImmutableContext(?ctx).

mainAnalysis_isImmutableContext(?ctx) :- 
   ?s = "<<immutable-context>>",
   mainAnalysis_configuration_InitContextRequest(?s),
   mainAnalysis_configuration_InitContextResponse(?s,?ctx).

mainAnalysis_isImmutableHContext(?hctx) :- 
   ?s = "<<immutable-hcontext>>",
   mainAnalysis_configuration_InitHContextRequest(?s),
   mainAnalysis_configuration_InitHContextResponse(?s,?hctx).
