   Var_Type(?formal,?formalType).

mainAnalysis_HeapAllocation_ContextInsensitive(?heap) :- 
   isMethodHandleConstant(?heap).

mainAnalysis_HeapAllocation_ContextInsensitive(?heap) :- 
   mainAnalysis_HeapAllocation_Merge(?heap,_).

mainAnalysis_HeapAllocation_ContextInsensitive(?heap) :- 
   isStringConstant(?heap),
   !mainAnalysis_HeapRepresentative(_,?heap).

mainAnalysis_HeapAllocation_ContextInsensitive(?heap) :- 
   isClassHeap(?heap).

mainAnalysis_HeapAllocation_ContextInsensitive(?heap) :- 
   mainAnalysis_SpecialLibraryObject(?heap),
   !mainAnalysis_HeapRepresentative(_,?heap).

mainAnalysis_HeapAllocation_ContextInsensitive(?heap) :- 
   HeapAllocation_Type(?heap,?type),
   isArrayType(?type),
   ComponentType(?type,?componentType),
   isPrimitiveType(?componentType).

mainAnalysis_HeapAllocation_Merge(?heap,?heapRepr) :- 
   ?heapRepr = "<<string-constant>>",
   mainAnalysis_HeapRepresentative(?heapRepr,?heap).

mainAnalysis_HeapAllocation_Merge(?heap,?heapRepr) :- 
   ?heapRepr = "<<string-buffer>>",
   mainAnalysis_HeapRepresentative(?heapRepr,?heap).

mainAnalysis_HeapAllocation_Merge(?heap,?heapRepr) :- 
   ?heapRepr = "<<string-builder>>",
   mainAnalysis_HeapRepresentative(?heapRepr,?heap).

mainAnalysis_HeapAllocation_Merge(?heap,?heapRepr) :- 
   ?heapRepr = "<<pystring-object>>",
   mainAnalysis_HeapRepresentative(?heapRepr,?heap).

mainAnalysis_HeapAllocation_Merge(?heap,?mergeHeap) :- 
   isHeapAllocation(?mergeHeap),
   ord(?mergeHeap) = ?minHeapReprOrd,
   mainAnalysis_MinRepresentativeHeapToPickFromOrdinal(?minHeapReprOrd,?heap).

mainAnalysis_HeapInterproceduralAssign(?ctxTo,?to,?ctxFrom,?from) :- 
   mainAnalysis_LoadFromReference(?ctxTo,?to,?basehctx,?basevalue),
   mainAnalysis_StoreIntoWeakReference(?basehctx,?basevalue,?ctxFrom,?from),
   !mainAnalysis_Value_Null(?basevalue). .plan 1:(2,1)

mainAnalysis_HeapInterproceduralAssign(?ctxTo,?to,?ctxFrom,?from) :- 
   mainAnalysis_LoadHeapInstanceField(?ctxTo,?to,?signature,?basehctx,?basevalue),
   mainAnalysis_StoreHeapInstanceField(?signature,?basehctx,?basevalue,?ctxFrom,?from),
   !mainAnalysis_Value_Null(?basevalue). .plan 1:(2,1)

mainAnalysis_HeapIsMergedString(?heap) :- 
   mainAnalysis_HeapRepresentative("<<string-constant>>",?heap).

mainAnalysis_HeapIsMergedStringFactory(?heap) :- 
   mainAnalysis_HeapRepresentative("<<string-buffer>>",?heap).

mainAnalysis_HeapIsMergedStringFactory(?heap) :- 
   mainAnalysis_HeapRepresentative("<<string-builder>>",?heap).

mainAnalysis_HeapRepresentative(?representativeHeap,?heap) :- 
   mainAnalysis_MethodAndTypeToRepresentative(?type,?meth,?representativeHeap),
   mainAnalysis_MethodAndTypeToMergedHeap(?heap,?type,?meth).

mainAnalysis_HeapRepresentative(?representativeHeap,?heap) :- 
   mainAnalysis_ExceptionHeapTypeRepresentativeOrdinal(?heaptype,?representativeHeapOrd),
   mainAnalysis_ExceptionTypeToHeap(?heap,?heaptype),
   ord(?representativeHeap) = ?representativeHeapOrd,
   isHeapAllocation(?representativeHeap).

mainAnalysis_HeapRepresentative(?constant,?heap) :- 
   isStringConstant(?heap),
   ?constant = "<<string-constant>>",
   isHeapAllocation(?constant).

mainAnalysis_HeapRepresentative("<<string-buffer>>",?heap) :- 
   HeapAllocation_Type(?heap,"java.lang.StringBuffer").

mainAnalysis_HeapRepresentative("<<string-builder>>",?heap) :- 
   HeapAllocation_Type(?heap,"java.lang.StringBuilder").

mainAnalysis_HeapRepresentative("<<pystring-object>>",?heap) :- 
   HeapAllocation_Type(?heap,"org.python.core.PyString").

