VirtualMethodInvocation_Descriptor(?invocation,?descriptor) :- 
   isVirtualMethodInvocation_Insn(?invocation),
   MethodInvocation_Method(?invocation,?signature),
   Method_SimpleName(?signature,_),
   Method_Descriptor(?signature,?descriptor).

VirtualMethodInvocation_SimpleName(?invocation,?simplename) :- 
   isVirtualMethodInvocation_Insn(?invocation),
   MethodInvocation_Method(?invocation,?signature),
   Method_SimpleName(?signature,?simplename),
   Method_Descriptor(?signature,_).

XMLIFPTDI(?hctx,?mockObject,?injectedField,?basehctx,?basevalue) :- 
   mainAnalysis_Value_Type(?basevalue,?decltype),
   Field_DeclaringType(?injectedField,?decltype),
   BeanFieldInjection(?decltype,?injectedField,?mockObject),
   mainAnalysis_isImmutableHContext(?basehctx),
   mainAnalysis_isImmutableHContext(?hctx).

basic_AllocatedObjectSupportsFinalize(?heap,?inmethod) :- 
   AssignHeapAllocation(?heap,_,?inmethod),
   HeapAllocation_Type(?heap,?class),
   basic_OverridesFinalize(?class).

basic_AnyMainMethodDeclaration(?method,?type) :- 
   Method_DeclaringType(?method,?type),
   Method_SimpleName(?method,"main"),
   Method_Descriptor(?method,"void(java.lang.String[])"),
   Method_Modifier("public",?method),
   Method_Modifier("static",?method).

basic_ClassConstructor(method,type) :- 
   isClassType(type),
   basic_MethodLookup(_,_,type,method),
   isMethod(method),
   match(".*<init>.*", method).

basic_DirectSubclass(?a,?c) :- 
   DirectSuperclass(?a,?c).

basic_ExceptionHandler_Before(?previous,?handler) :- 
   ExceptionHandler_Previous(?handler,?previous).

basic_ExceptionHandler_Before(?before,?handler) :- 
   basic_ExceptionHandler_Before(?middle,?handler),
   ExceptionHandler_Previous(?middle,?before).

basic_ExceptionHandler_Impossible(?type,?h2,?insn) :- 
   basic_ExceptionHandler_InRange(?h1,?insn),
   basic_ExceptionHandler_InRange(?h2,?insn),
   basic_ExceptionHandler_Before(?h1,?h2),
   ExceptionHandler_Type(?h1,?h1Type),
   ExceptionHandler_Type(?h2,?h2Type),
   basic_SubtypeOf(?type,?h1Type),
   basic_SubtypeOf(?type,?h2Type),
   ConcreteClass(?type).

basic_ExceptionHandler_InRange(?handler,?instruction) :- 
   ExceptionHandler_Method(?handler,?method),
   Instruction_Method(?instruction,?method),
   Instruction_Index(?instruction,?index),
   ExceptionHandler_Begin(?handler,?beginIndex),
   ?beginIndex <= ?index,
   ExceptionHandler_End(?handler,?endIndex),
   ?endIndex > ?index.

basic_ExceptionHandler_SameBlock_PartialOrder(?h1,?h2) :- 
   basic_ExceptionHandler_Before(?h1,?h2),
   ExceptionHandler_Index(?h1,?h2Index),
   ExceptionHandler_Index(?h2,?h2Index).

basic_ExceptionHandler_SameBlock_Repr(?handler,?handler) :- 
   isExceptionHandler(?handler),
   !basic_ExceptionHandler_SameBlock_PartialOrder(_,?handler).

basic_ExceptionHandler_SameBlock_Repr(?handler,?repr) :- 
   basic_ExceptionHandler_SameBlock_PartialOrder(?repr,?handler),
   !basic_ExceptionHandler_SameBlock_PartialOrder(_,?repr).

basic_ExceptionHandler_SameInsn_PartialOrder(?h1,?h2,?insn) :- 
   basic_ExceptionHandler_InRange(?h1,?insn),
   basic_ExceptionHandler_InRange(?h2,?insn),
   basic_ExceptionHandler_Before(?h1,?h2).

basic_ExceptionHandler_SameInsn_Repr(?insn,?handler) :- 
   basic_ExceptionHandler_InRange(?handler,?insn),
   !basic_ExceptionHandler_SameInsn_PartialOrder(_,?handler,?insn).

basic_ExceptionHandler_TypeIsCaught(?type,?block) :- 
   basic_ExceptionHandler_InRange(?handler,?insn),
   basic_ExceptionHandler_SameInsn_Repr(?insn,?repr),
   basic_ExceptionHandler_SameBlock_Repr(?repr,?block),
   ExceptionHandler_Type(?handler,?handlerType),
   basic_SubtypeOf(?type,?handlerType),
   ConcreteClass(?type).

basic_MainMethodDeclaration(?method) :- 
   MainClass(?type),
   basic_AnyMainMethodDeclaration(?method,?type).

basic_MethodImplemented(?simplename,?descriptor,?type,?method) :- 
   Method_SimpleName(?method,?simplename),
   Method_Descriptor(?method,?descriptor),
   Method_DeclaringType(?method,?type),
   !Method_Modifier("abstract",?method).

basic_MethodLookup(?simplename,?descriptor,?type,?method) :- 
   basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method,_),
   !basic__MethodLookup_MoreThanOne(?simplename,?descriptor,?type).

basic_MethodLookup(?simplename,?descriptor,?type,?method) :- 
   basic__MethodLookup_ClassResolution(?simplename,?descriptor,?type,?method).

basic_MethodLookup(?simplename,?descriptor,?type,?method) :- 
   basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method),
   !basic__MethodLookup_MultiClosestInterfaces(?simplename,?descriptor,?type).

basic_MethodLookup(?simplename,?descriptor,?type,?method) :- 
   basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method),
   !basic__MethodLookup_ImpossibleClosest(?simplename,?descriptor,?type,?method).

basic_MethodLookup(?simplename,?descriptor,?arraytype,?method) :- 
   isArrayType(?arraytype),
   isType(?objectType),
   basic_MethodImplemented(?simplename,?descriptor,?objectType,?method),
   ?objectType = "java.lang.Object".

basic_MethodMightBeCovariantBridge(?bridge,?meth) :- 
   Method_SimpleName(?meth,?name),
   basic__BridgeMethod(?bridge,?name,?bridgetype),
   Method_DeclaringType(?meth,?bridgetype),
   !Method_Modifier("bridge",?meth).

basic_OverridesFinalize(?class) :- 
   basic_MethodLookup("finalize","void()",?class,?method),
   ?method != "<java.lang.Object: void finalize()>".

basic_ResolveInvocation(?type,?invocation,?tomethod) :- 
   VirtualMethodInvocation_SimpleName(?invocation,?simplename),
   VirtualMethodInvocation_Descriptor(?invocation,?descriptor),
   basic_VirtualMethodInvocation_BaseType(?invocation,?basetype),
   basic_SubtypeOf(?type,?basetype),
   basic_MethodLookup(?simplename,?descriptor,?type,?tomethod).

basic_ResolveInvocation(?basetype,?invocation,?tomethod) :- 
   SuperMethodInvocation_SimpleName(?invocation,?simplename),
   SuperMethodInvocation_Descriptor(?invocation,?descriptor),
   SuperMethodInvocation_Base(?invocation,?base),
   Var_Type(?base,?basetype),
   DirectSuperclass(?basetype,?supertype),
   basic_MethodLookup(?simplename,?descriptor,?supertype,?tomethod).

basic_Subclass(?c,?a) :- 
   basic_DirectSubclass(?a,?c).

basic_Subclass(?c,?a) :- 
   basic_Subclass(?b,?a),
   basic_DirectSubclass(?b,?c).

basic_SubtypeOf(?s,?s) :- 
   isClassType(?s).

basic_SubtypeOf(?s,?t) :- 
   basic_Subclass(?t,?s).

basic_SubtypeOf(?s,?t) :- 
   isClassType(?s),
   basic_Superinterface(?t,?s).

basic_SubtypeOf(?s,?t) :- 
   isInterfaceType(?s),
   isType(?t),
   ?t = "java.lang.Object".

basic_SubtypeOf(?s,?s) :- 
   isInterfaceType(?s).

basic_SubtypeOf(?s,?t) :- 
   isInterfaceType(?s),
   basic_Superinterface(?t,?s).

basic_SubtypeOf(?s,?t) :- 
   isArrayType(?s),
   isType(?t),
   ?t = "java.lang.Object".

basic_SubtypeOf(?s,?t) :- 
   isArrayType(?s),
   isArrayType(?t),
   ComponentType(?s,?sc),
   ComponentType(?t,?sc),
   isPrimitiveType(?sc).

basic_SubtypeOf(?s,?t) :- 
   ComponentType(?s,?sc),
   ComponentType(?t,?tc),
   isReferenceType(?sc),
   isReferenceType(?tc),
   basic_SubtypeOf(?sc,?tc).

basic_SubtypeOf(?s,?t) :- 
   isArrayType(?s),
   isInterfaceType(?t),
   isType(?t),
   ?t = "java.lang.Cloneable".

basic_SubtypeOf(?s,?t) :- 
   isArrayType(?s),
   isInterfaceType(?t),
   isType(?t),
   ?t = "java.io.Serializable".

basic_SubtypeOf(?s,?t) :- 
   Type_null(?s),
   isReferenceType(?t),
   ?t != ?s.

basic_SubtypeOf(?s,?t) :- 
   Type_float(?s),
   Type_double(?t).

basic_SubtypeOf(?s,?t) :- 
   Type_long(?s),
   Type_float(?t).

basic_SubtypeOf(?s,?t) :- 
   Type_int(?s),
   Type_long(?t).

basic_SubtypeOf(?s,?t) :- 
   Type_char(?s),
   Type_int(?t).

basic_SubtypeOf(?s,?t) :- 
   Type_short(?s),
   Type_int(?t).

basic_SubtypeOf(?s,?t) :- 
   Type_byte(?s),
   Type_short(?t).

basic_SubtypeOf(?t,?t) :- 
   isType(?t).

basic_Superinterface(?k,?c) :- 
   DirectSuperinterface(?c,?k).

basic_Superinterface(?k,?c) :- 
   DirectSuperinterface(?c,?j),
   basic_Superinterface(?k,?j).

basic_Superinterface(?k,?c) :- 
   DirectSuperclass(?c,?super),
   basic_Superinterface(?k,?super).

basic_SupertypeOf(?s,?t) :- 
   basic_SubtypeOf(?t,?s).

basic_VirtualMethodInvocation_BaseType(?invocation,?basetype) :- 
   VirtualMethodInvocation_Base(?invocation,?base),
   Var_Type(?base,?basetype).

basic__BridgeMethod(?bridge,?name,?type) :- 
   Method_Modifier("bridge",?bridge),
   Method_SimpleName(?bridge,?name),
   Method_DeclaringType(?bridge,?type),
   ?name != "<clinit>",
   ?name != "<init>".

basic__MethodLookup_ClassResolution(?simplename,?descriptor,?type,?method) :- 
   basic__MethodLookup_MoreThanOne(?simplename,?descriptor,?type),
   basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method,_),
   Method_DeclaringType(?method,?supertype),
   isClassType(?supertype).

basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method) :- 
   basic__MethodLookup_MoreThanOne(?simplename,?descriptor,?type),
   ?minLen = min ?len : { basic__MethodLookup_WithLen(?simplename,?descriptor,?type,_,?len) },
   basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method,?minLen),
   !basic__MethodLookup_ClassResolution(?simplename,?descriptor,?type,_).

basic__MethodLookup_ImpossibleClosest(?simplename,?descriptor,?type,?method2) :- 
   basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method1),
   basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method2),
   Method_DeclaringType(?method1,?type1),
   Method_DeclaringType(?method2,?type2),
   basic_SubtypeOf(?type1,?type2),
   ?type1 != ?type2.

basic__MethodLookup_MoreThanOne(?simplename,?descriptor,?type) :- 
   basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method1,_),
   basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method2,_),
   ?method1 != ?method2.

basic__MethodLookup_MultiClosestInterfaces(?simplename,?descriptor,?type) :- 
   basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method1),
   basic__MethodLookup_ClosestInterface(?simplename,?descriptor,?type,?method2),
   ?method1 != ?method2.

basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method,0) :- 
   basic_MethodImplemented(?simplename,?descriptor,?type,?method).

basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method,(n+1)) :- 
   DirectSuperclass(?type,?supertype),
   basic__MethodLookup_WithLen(?simplename,?descriptor,?supertype,?method,n),
   !basic_MethodImplemented(?simplename,?descriptor,?type,_).

basic__MethodLookup_WithLen(?simplename,?descriptor,?type,?method,(n+1)) :- 
   DirectSuperinterface(?type,?supertype),
   basic__MethodLookup_WithLen(?simplename,?descriptor,?supertype,?method,n),
   !basic_MethodImplemented(?simplename,?descriptor,?type,_).

