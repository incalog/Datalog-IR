mainAnalysis_VarPointsTo(?hctx,?null,?toCtx,?to) :- 
   mainAnalysis_Reachable(?inmethod),
   AssignNull(?to,?inmethod),
   mainAnalysis_Value_Null(?null),
   mainAnalysis_ReachableContext(?toCtx,?inmethod),
   mainAnalysis_isImmutableHContext(?hctx).

mainAnalysis_VarPointsTo(?hctx,?value,?ctx,?to) :- 
