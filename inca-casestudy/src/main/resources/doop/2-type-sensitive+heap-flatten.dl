   Instruction_Method(?invokedynamic,?method),
   Method_DeclaringType(?method,_).

mainAnalysis_VarPointsTo(?immHctx,cat("<bootstrap varargs array for ",cat(?invokedynamic,">")),?calleeCtx,?formalVarArgs) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,?calleeCtx,?bootMethod),
   mainAnalysis_MethodVarArgs(?bootMethod,?bootIdx,?formalVarArgs,_),
   BootstrapParam(?idx,?invokedynamic,?actual),
   ?idx > (?bootIdx-3),
   mainAnalysis_VarPointsTo(_,_,_,?actual),
   mainAnalysis_isImmutableHContext(?immHctx).

mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?formal) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,?calleeCtx,?bootMethod),
   !Method_Modifier("varargs",?bootMethod),
   FormalParam( _tmp_2,?bootMethod,?formal),
   BootstrapParam(?idx,?invokedynamic,?actual),
   mainAnalysis_VarPointsTo(?hctx,?val,_,?actual),
    _tmp_2 = (?idx+3).

mainAnalysis_VarPointsTo(?hctx,cat(?invokedynamic,cat("::: ",cat(?dynRetType,cat("::: (Mock)::: ",cat("reference ",cat(?handleType,cat("::",cat(?handleMeth,cat(" from ",cat(?implMethod,cat(" wrapped as ",cat(?dynRetType,cat(".",?dynName))))))))))))),?callerCtx,?ret) :- 
   mainAnalysis_ReachableLambdaMetafactoryInvoke(?invokedynamic,?dynName,?dynRetType,?callerCtx),
   DynamicMethodInvocation_DynArity(?invokedynamic,_),
   BootstrapParam(1,?invokedynamic,?handleVar),
   mainAnalysis_VarPointsTo(?hctx,?handleVal,?callerCtx,?handleVar),
   MethodHandleConstant_Method(?handleVal,?implMethod),
   Method_SimpleName(?implMethod,?handleMeth),
   Method_DeclaringType(?implMethod,?handleType),
   AssignReturnValue(?invokedynamic,?ret).

mainAnalysis_VarPointsTo(?hctx,?val,?calleeCtx,?formal) :- 
   mainAnalysis_LambdaCallGraphEdge(_,_,?calleeCtx,?implMethod,?lambda),
   mainAnalysis_Params_ReceiverShiftRight(?lambda,?implMethod,?shiftK,_),
   mainAnalysis_LambdaObject(?invokedynamic,?lambda,_,?K,?implMethod,_),
   mainAnalysis_LambdaCaptured(?invokedynamic,?val,?idx,?hctx),
   (?idx+?shiftK) <= ?K,
   FormalParam( _tmp_3,?implMethod,?formal),
   mainAnalysis_Value_Type(?val,?valType),
   Var_Type(?formal,?formalType),
   basic_SubtypeOf(?valType,?formalType),
    _tmp_3 = (?idx-?shiftK).

mainAnalysis_VarPointsTo(?hctx,cat("<mock object of type ",cat(?type,cat(" constructed by constructor reference at ",cat(?i,">")))),?callerCtx,?var) :- 
