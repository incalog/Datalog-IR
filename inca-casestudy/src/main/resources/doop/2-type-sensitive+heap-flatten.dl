mainAnalysis_Value_DeclaringType(cat("Mock map: ",cat(?id,?mapClass)),"java.lang.Object") :- 
   XMLNode(?XMLFile,?parentNodeId,_,_,"map","util:map"),
   XMLNodeAttribute(?XMLFile,?parentNodeId,_,"id","id",?id),
   XMLNodeAttribute(?XMLFile,?parentNodeId,_,"map-class","map-class",?mapClass),
   XMLNode(?XMLFile,?nodeId,?parentNodeId,_,"entry","beans:entry"),
   XMLNodeAttribute(?XMLFile,?nodeId,_,"key","key",_),
   XMLNodeAttribute(?XMLFile,?nodeId,_,"value-ref","value-ref",?entryBeanId),
   ConcreteBean_Id(?entryBeanClass,?entryBeanId),
   MockObject(_,?entryBeanClass).

mainAnalysis_Value_DeclaringType(cat("Mock map: ",cat(cat(cat(?beanClass," "),?injectedField),"java.util.HashMap")),"java.lang.Object") :- 
   XMLNode(?XMLFile,?beanNodeId,_,_,"bean","bean"),
   XMLNodeAttribute(?XMLFile,?beanNodeId,_,"class","class",?beanClass),
   XMLNode(?XMLFile,?beanPropertyNodeId,?beanNodeId,_,"property","property"),
   XMLNodeAttribute(?XMLFile,?beanPropertyNodeId,_,"name","name",?injectedField),
   XMLNode(?XMLFile,?mapNodeId,?beanPropertyNodeId,_,"map","map"),
   XMLNode(?XMLFile,?entryNodeId,?mapNodeId,_,"entry","entry"),
   XMLNodeAttribute(?XMLFile,?entryNodeId,_,"key","key",_),
   XMLNode(?XMLFile,?valueNodeId,?entryNodeId,_,"bean","bean"),
   XMLNodeAttribute(?XMLFile,?valueNodeId,_,"class","class",?entryBeanId),
   ConcreteBean_Id(?entryBeanClass,?entryBeanId),
   MockObject(_,?entryBeanClass).

mainAnalysis_Value_DeclaringType(cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node[]"),"java.lang.Object") :- 
   BeanMap(?id,?mapClass,_),
   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(?tableField,?mapClass),
   Field_SimpleName(?tableField,"table"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_DeclaringType(cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node"),"java.lang.Object") :- 
   BeanMap(?id,?mapClass,_),
   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(?tableField,?mapClass),
   Field_SimpleName(?tableField,"table"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_DeclaringType(cat("Mock map: ",cat(cat(cat(?beanClass," "),?injectedField),"java.util.HashMap")),"java.lang.Object") :- 
   XMLNode(?XMLFile,?beanNodeId,_,_,"bean","bean"),
   XMLNodeAttribute(?XMLFile,?beanNodeId,_,"class","class",?beanClass),
   XMLNode(?XMLFile,?beanPropertyNodeId,?beanNodeId,_,"property","property"),
   XMLNodeAttribute(?XMLFile,?beanPropertyNodeId,_,"name","name",?injectedField),
   XMLNode(?XMLFile,?mapNodeId,?beanPropertyNodeId,_,"map","map"),
   XMLNode(?XMLFile,?entryNodeId,?mapNodeId,_,"entry","entry"),
   XMLNodeAttribute(?XMLFile,?entryNodeId,_,"key","key",_),
   XMLNode(?XMLFile,?valueNodeId,?entryNodeId,_,"bean","bean"),
   XMLNodeAttribute(?XMLFile,?valueNodeId,_,"class","class",?entryBeanId),
   ConcreteBean_Id(?entryBeanClass,?entryBeanId),
   MockObject(_,?entryBeanClass).

mainAnalysis_Value_DeclaringType(cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node"),"java.lang.Object") :- 
   BeanMap(?id,?mapClass,_),
   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(_,?mapClass),
   Field_SimpleName(_,"contents"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(_),
   mainAnalysis_isImmutableHContext(_).

mainAnalysis_Value_DeclaringType("<mock string concatenation result>","java.lang.Object") :- 
   DynamicMethodInvocation_Bootstrap(?insn,"<java.lang.invoke.StringConcatFactory: java.lang.invoke.CallSite makeConcatWithConstants(java.lang.invoke.MethodHandles$Lookup,java.lang.String,java.lang.invoke.MethodType,java.lang.String,java.lang.Object[])>"),
   Instruction_Method(?insn,?method),
   mainAnalysis_ReachableContext(_,?method),
   mainAnalysis_isImmutableHContext(_),
   AssignReturnValue(?insn,_).

mainAnalysis_Value_DeclaringType(cat("<method type (",cat(?paramTypes,cat(")",cat(?retType,">")))),"java.lang.Object") :- 
   MethodHandleConstant_Method(?methodHandle,_),
   MethodHandleConstant_ParamTypes(?methodHandle,?paramTypes),
   MethodHandleConstant_ReturnType(?methodHandle,?retType),
   MethodHandleConstant_Arity(?methodHandle,_).

mainAnalysis_Value_DeclaringType(cat("<mock box allocation for type ",cat(?t2,">")),"java.lang.Object") :- 
   mainAnalysis_PrimitiveType_Boxed(_,?wrapperT),
   basic_SubtypeOf(?wrapperT,?t2).

mainAnalysis_Value_DeclaringType(cat("<adapter for ",cat(?mh,cat(" as ",?mt))),"java.lang.Object") :- 
   _VirtualMethodInvocation(?invo,_,?sig,?base,?method),
   mainAnalysis_ReachableContext(?ctx,?method),
   ?sig = "<java.lang.invoke.MethodHandle: java.lang.invoke.MethodHandle asType(java.lang.invoke.MethodType)>",
   mainAnalysis_VarPointsTo(_,?mh,?ctx,?base),
   ActualParam(0,?invo,?arg),
   mainAnalysis_VarPointsTo(_,?mt,?ctx,?arg),
   AssignReturnValue(?invo,_),
   mainAnalysis_MethodHandle_Method(?mh,?mhMethod),
   Method_ParamTypes(?mhMethod,_).

