mainAnalysis_AllApplicationConcreteImplementations(?class,?abstractType) :- 
   ApplicationClass(?class),
   basic_SubtypeOf(?class,?abstractType),
   ?abstractType != "java.lang.Object",
   !ClassModifier("abstract",?class).

mainAnalysis_AllApplicationConcreteImplementations(?class,?class) :- 
   ConcreteClass(?class).

mainAnalysis_AllocationShouldBeMergedPerMethod(?heaptype,?meth) :- 
   mainAnalysis_AllocationsPerMethodAndType(?heaptype,?meth,?n),
   mainAnalysis_MethodAllocationMergeThreshold(?t),
   ?n > ?t.

mainAnalysis_AllocationShouldBeMergedPerMethod(?heaptype,?meth) :- 
   mainAnalysis_AllocationsPerMethodAndType(?heaptype,?meth,?n),
   ?n > 1,
   Method_DeclaringType(?meth,?class),
   mainAnalysis_SpecialLibraryClass(?class).

mainAnalysis_AllocationsPerMethodAndType(?type,?meth,?n) :- 
   mainAnalysis_MethodAndTypeToHeap(_,?type,?meth),
   ?n = count : { mainAnalysis_MethodAndTypeToHeap(_,?type,?meth) }.

mainAnalysis_AnyCallGraphEdge(?i,?m) :- 
   mainAnalysis_CallGraphEdge(_,?i,_,?m).

mainAnalysis_AnyCallGraphEdge(?i,?m) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?i,_,?m).

mainAnalysis_AnyCallGraphEdge(?i,?m) :- 
   mainAnalysis_LambdaCallGraphEdge(_,?i,_,?m,_).

mainAnalysis_AnyCallGraphEdge(?i,?m) :- 
   mainAnalysis_MethodHandleCallGraphEdge(_,?i,_,?m,_,_).

mainAnalysis_AnyCallGraphEdge(?i,?m) :- 
   mainAnalysis_OpaqueCallGraphEdge(?i,?m).

mainAnalysis_ApplicationConcreteType(?type) :- 
   ApplicationClass(?type),
   !isInterfaceType(?type),
   !ClassModifier("abstract",?type).

mainAnalysis_ArrayIndexPointsTo(?hctx,?argArrayContent,?hctx,?argArray) :- 
   mainAnalysis_isImmutableHContext(?hctx),
   basic_MainMethodDeclaration(?mainMethod),
   mainAnalysis_ReachableContext(_,?mainMethod),
   FormalParam(0,?mainMethod,_),
   MainMethodArgArray(?argArray),
   MainMethodArgArrayContent(?argArrayContent).

mainAnalysis_ArrayIndexPointsTo(?hctx,?value,?basehctx,?basevalue) :- 
   mainAnalysis_OptStoreIntoArray(?hctx,?value,?basehctx,?basevalue),
   mainAnalysis_NotSpecialObject(?value),
   mainAnalysis_NotEmptyArrayValue(?basevalue),
   mainAnalysis_Value_Type(?value,?valuetype),
   mainAnalysis_Value_Type(?basevalue,?basevaluetype),
   ComponentType(?basevaluetype,?componenttype),
   basic_SupertypeOf(?componenttype,?valuetype). .plan 1:(2,1,3,4,5,6,7), 2:(3,1,2,4,5,6,7), 3:(4,1,2,3,5,6,7), 4:(5,1,2,3,4,6,7)

mainAnalysis_ArrayIndexPointsTo(?hctx,cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node"),?basehctx,cat(cat(cat(?entryBeanId,": "),?mapClass),"$Node[]")) :- 
   BeanMap(?id,?mapClass,_),
   BeanMapEntry(?id,?entryBeanId,_),
   Field_DeclaringType(?tableField,?mapClass),
   Field_SimpleName(?tableField,"table"),
   Field_DeclaringType(?keyField,?nodeType),
   Field_SimpleName(?keyField,"key"),
   Field_DeclaringType(?valueField,?nodeType),
   Field_SimpleName(?valueField,"value"),
   ?nodeType = cat(?mapClass,"$Node"),
   mainAnalysis_isImmutableHContext(?hctx),
   mainAnalysis_isImmutableHContext(?basehctx).

mainAnalysis_ArrayIndexPointsTo(?immHctx,?val,?immHctx,cat("<bootstrap varargs array for ",cat(?invokedynamic,">"))) :- 
   mainAnalysis_InvokedynamicBootCallGraphEdge(_,?invokedynamic,_,?bootMethod),
   mainAnalysis_MethodVarArgs(?bootMethod,?bootIdx,_,_),
   BootstrapParam(?idx,?invokedynamic,?actual),
   ?idx > (?bootIdx-3),
   mainAnalysis_VarPointsTo(_,?val,_,?actual),
   mainAnalysis_isImmutableHContext(?immHctx).

