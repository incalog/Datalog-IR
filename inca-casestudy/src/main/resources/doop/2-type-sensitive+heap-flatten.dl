mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?fakeinvo,?heapValue,?register,1) :- 
   mainAnalysis_FakeInvocation_RegisterFinalize(?heapValue,?fakeinvo),
   basic_AllocatedObjectSupportsFinalize(?heapValue,?inmethod),
   !mainAnalysis_HeapAllocation_Merge(?heapValue,_),
   mainAnalysis_ReachableContext(?callerCtx,?inmethod),
   ?register = "<java.lang.ref.Finalizer: void register(java.lang.Object)>",
   isMethod(?register),
   FormalParam(0,?register,_),
   mainAnalysis_isImmutableHContext(?hctx).

mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?fakeinvo,?heapValue,?register,1) :- 
   mainAnalysis_FakeInvocation_RegisterFinalize(?heapValue,?fakeinvo),
   basic_AllocatedObjectSupportsFinalize(?heapValue,?inmethod),
   mainAnalysis_HeapAllocation_Merge(?heapValue,?heapValue),
   mainAnalysis_ReachableContext(?callerCtx,?inmethod),
   ?register = "<java.lang.ref.Finalizer: void register(java.lang.Object)>",
   isMethod(?register),
   FormalParam(0,?register,_),
   mainAnalysis_isImmutableHContext(?hctx).

mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invocation,?value,?tomethod,1) :- 
   mainAnalysis_OptVirtualMethodInvocationBase(?invocation,?base),
   mainAnalysis_VarPointsTo(?hctx,?value,?callerCtx,?base),
   mainAnalysis_Value_Type(?value,?valuetype),
   basic_ResolveInvocation(?valuetype,?invocation,?tomethod).

mainAnalysis_configuration_ContextRequest(?callerCtx,?hctx,?invocation,?value,?tomethod,1) :- 
