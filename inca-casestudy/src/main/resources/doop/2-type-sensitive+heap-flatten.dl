   c = count : { Stats_Simple_JavaUtilInsensVarPointsTo(_,_) }.

Stats_Metrics("5.8","java.util var points-to (SENS)",c) :- 
   c = count : { Stats_Simple_JavaUtilVarPointsTo(_,_,_,_) }.

