mainAnalysis_Value_Type("<mock string concatenation result>","java.lang.String") :- 
   DynamicMethodInvocation_Bootstrap(?insn,"<java.lang.invoke.StringConcatFactory: java.lang.invoke.CallSite makeConcatWithConstants(java.lang.invoke.MethodHandles$Lookup,java.lang.String,java.lang.invoke.MethodType,java.lang.String,java.lang.Object[])>"),
   Instruction_Method(?insn,?method),
   mainAnalysis_ReachableContext(_,?method),
   mainAnalysis_isImmutableHContext(_),
   AssignReturnValue(?insn,_).

mainAnalysis_Value_Type(cat("<method type (",cat(?paramTypes,cat(")",cat(?retType,">")))),"java.lang.invoke.MethodType") :- 
   MethodHandleConstant_Method(?methodHandle,_),
