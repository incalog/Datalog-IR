module LambdaCalculus

data Type = TInt() | TFun(Type, Type)
data MaybeType = NoType() | SomeType(Type)
data TExp = TNum(Int) | TLam(String, Type, TExp) | TApp(TExp, TExp) | TVar(String)
data Ctx = EmptyCtx() | BindCtx(String, Type, Ctx)

data Exp = Num(Int) | Lam(String, Exp) | App(Exp, Exp) | Var(String)

data Env = EmptyEnv() | BindEnv(String, Val, Env)
data Val = VNum(Int) | VClosure(String, Exp, Env)
data MaybeVal = NoVal() | SomeVal(Val)

@main def mainTypeOf(exp: TExp): MaybeType = typeOf(EmptyCtx(), exp)

def typeOf(ctx: Ctx, exp: TExp): MaybeType = exp match {
  case TNum(v) => SomeType(TInt())
  case TLam(n, ty, b) =>
    typeOf(BindCtx(n, ty, ctx), b) match {
      case SomeType(ty2) => SomeType(TFun(ty, ty2))
      case NoType() => NoType()
    }
  case TApp(fun, arg) =>
    typeOf(ctx, fun) match {
      case SomeType(funty) =>
        funty match {
          case TInt() => NoType()
          case TFun(ty1, ty2) =>
            typeOf(ctx, arg) match {
              case SomeType(argty) =>
                if (argty == ty1) SomeType(ty2)
                else NoType()
              case NoType() => NoType()
            }
      }
      case NoType() => NoType()
    }
  case TVar(n) => ctxLookup(ctx, n)
}

def ctxLookup(ctx: Ctx, n: String): MaybeType = ctx match {
  case EmptyCtx() => NoType()
  case BindCtx(n1, ty, rest) =>
    if (n1 == n) SomeType(ty)
    else ctxLookup(rest, n)
}

// we need a wrapper function for erase. Otherwise, the demand transformation
// is not applied to `erase`. As such we don't get any output.
@main def mainErase(texp: TExp): Exp = erase(texp)

def erase(texp: TExp): Exp = texp match {
  case TNum(v) => Num(v)
  case TLam(n, ty, b) => Lam(n, erase(b))
  case TApp(fun, arg) => App(erase(fun), erase(arg))
  case TVar(n) => Var(n)
}

@main def mainInterp(exp: Exp): MaybeVal = interp(EmptyEnv(), exp)

def interp(env: Env, exp: Exp): MaybeVal = exp match {
  case Num(v) => SomeVal(VNum(v))
  case Lam(n, b) => SomeVal(VClosure(n, b, env))
  case App(fun, arg) => interp(env, fun) match {
    case SomeVal(funv) => funv match {
      case VClosure(param, body, fenv) => interp(env, arg) match {
        case SomeVal(argv) => interp(BindEnv(param, argv, fenv), body)
        case NoVal() => NoVal()
      }
      case VNum(v) => NoVal()
    }
    case NoVal() => NoVal()
  }
  case Var(n) => envLookup(env, n)
}

def envLookup(env: Env, n: String): MaybeVal = env match {
  case EmptyEnv() => NoVal()
  case BindEnv(n1, v, rest) =>
    if (n1 == n) SomeVal(v)
    else envLookup(rest, n)
}

@main def main(exp: TExp): MaybeVal = typeOf(EmptyCtx(), exp) match {
  case SomeType(ty) => interp(EmptyEnv(), erase(exp))
  case NoType() => NoVal()
}
