module CloneDetection

dl_import SouffleFacts as sf {
   _OperatorAt(inst: String, operator: String),
   _StmInstructions(inst: String),
   _AssignNum(inst: String, index: Int, const: String, to: String, method: String),
   _AssignNumConstant(inst: String, index: Int, const: String, to: String, method: String),
   _AssignBinop(inst: String, index: Int, to: String, method: String),
   _AssignUnop(inst: String, index: Int, to: String, method: String),
   _AssignLocal(inst: String, index: Int, from: String, to: String, method: String),
   _FormalParam(index: Int, method: String, vari: String),
   _AssignCast(inst: String, index: Int, from: String, to: String, ty: String, method: String),
   _AssignInstanceOf(inst: String, index: Int, from: String, to: String, ty: String, method: String),
   _AssignNull(inst: String, index: Int, to: String, method: String),
   _ThisVar(method: String, vari: String),
   _AssignHeapAllocation(inst: String, index: Int, heap: String, to: String, method: String, linenumber: Int),
   _Var_Type(vari: String, ty: String),
   _LoadArrayIndex(inst: String, index: Int, to: String, base: String, method: String),
   _ArrayNumIndex(inst: String, index: Int),
   _ArrayInsnIndex(inst: String, index: Int),
   _AssignReturnValue(inv: String, to: String),
   _VirtualMethodInvocation(inst: String, index: Int, signature: String, base: String, method: String),
   _SuperMethodInvocation(inst: String, index: Int, signature: String, base: String, method: String),
   _SpecialMethodInvocation(inst: String, index: Int, signature: String, base: String, method: String),
   _StaticMethodInvocation(inst: String, index: Int, signature: String, method: String),
   _DynamicMethodInvocation(inst: String, index: Int, bootSignature: String, dynName: String, dynRetType: String, dynArity: Int, dynParamTypes: String, tag: Int, method: String),
   _LoadInstanceField(inst: String, index: Int, to: String, base: String, signature: String, method: String),
   _LoadStaticField(inst: String, index: Int, to: String, signature: String, method: String),
   ExceptionHandler_FormalParam(handler: String, vari: String),
   _ExceptionHandler(handler: String, method: String, index: Int, type: String, begin: Int, end: Int),
   _AssignOperFromConstant(inst: String, pos: Int, from: String),
   _AssignOperFrom(inst: String, pos: Int, from: String),
   _ActualParam(index: Int, invocation: String, var: String),
   _StoreArrayIndex(inst: String, index: Int, from: String, base: String, method: String),
   _StoreInstanceField(inst: String, index: Int, from: String, base: String, signature: String, method: String),
   _StoreStaticField(inst: String, index: Int, from: String, signature: String, method: String),
   _ReturnVoid(inst: String, index: Int, method: String),
   _Return(inst: String, index: Int, vari: String, method: String),
   _Method(method: String, simplename: String, descriptor: String, declaringType: String, returnType: String, jvmDescriptor: String, arity: Int),
   _Goto(inst: String, index: Int, to: Int, method: String),
   _If(inst: String, index: Int, to: Int, method: String),
   _OperatorAt(inst: String, op: String),
   _TableSwitch(inst: String, index: Int, key: String, method: String),
   _LookupSwitch(inst: String, index: Int, key: String, method: String),
   _Throw(inst: String, index: Int, vari: String, method: String),
   _ThrowNull(inst: String, index: Int, method: String),
   _IfConstant(inst: String, pos: Int, numConst: String),
   _IfVar(inst: String, pos: Int, vari: String),
   _DummyIfVar(inst: String, vari: String),
   TableSwitch_CaseValue(inst: String, value: Int),
   _TableSwitch_DefaultTarget(inst: String, target: Int),
   _TableSwitch_Target(inst: String, value: Int, target: Int),
   _LookupSwitch_DefaultTarget(inst: String, target: Int),
   _LookupSwitch_Target(inst: String, value: Int, target: Int),
   Method_Instruction_Index(method: String, index: Int),
   Instruction_Method(inst: String, method: String),
   Instruction_Index(inst: String, index: Int)
}

data ArgList = NilArg() | ConsArg(Exp, ArgList)
// TODO recover more info about new array and new multi array
data Exp = NumLit(String)
         | Var(String)
         | BinOp(String, Exp, Exp)
         | UnOp(String, Exp)
         | Cast(Exp, String)
         | InstanceOf(Exp, String)
         | StringLit(String)
         | Alloc(String, String)
         | SpecialAlloc(String, String, ArgList)
         | ArrayRead(Exp, Exp)
         | InstanceFieldRead(Exp, String)
         | StaticFieldRead(String)
         | Invoke(Exp, String, ArgList)
         | SpecialInvoke(Exp, String, ArgList)
         | SuperInvoke(Exp, String, ArgList)
         | StaticInvoke(String, ArgList)
         | DynamicInvoke(String, String, ArgList)
         | This()
         | Null()
         | CaughtException(String)
         | DummyVar() // TODO dummy var is always generated and we use it when there is no lhs or rhs for if

data CaseList = ConsCase(Int, Int, CaseList) | DefaultCase(Int)
data CatchList = ConsCatch() | NilCatch()
data Stm = Assign(String, String)
         | InvokeStm(Exp, String, ArgList)
         | SpecialInvokeStm(Exp, String, ArgList)
         | StaticInvokeStm(String, ArgList)
         | ArrayWrite(Exp, Exp, Exp)
         | InstanceFieldWrite(Exp, String, Exp)
         | StaticFieldWrite(String, Exp)
         | ReturnVoid()
         | Return(Exp)
         | Goto(Int)
         | If(String, Exp, Exp, Int)
         | TableSwitch(Exp, CaseList)
         | LookupSwitch(Exp, CaseList)
         | Throw(Exp)
         | ThrowNull()
         | Phi(String, ArgList)

data StmList = ConsStm(Stm, Int, StmList) | NilStm()

// TODO ClassConstant
// TODO MethodHandleConstant
// PolymorphicInvoke
// How can i generate them? What features do i need to use to get these in jimple?
def assignExp(v: String): Set[Exp] = {
    NumLit(num) | (inst, idx, num, v, meth) in ?sf._AssignNumConstant
  } ++ {
    BinOp(op, left, right) |
      (inst, idx, v, meth) in ?sf._AssignBinop,
      (inst, op) in ?sf._OperatorAt,
      left in getOperand(inst, 1),
      right in getOperand(inst, 2)
  } ++ {
    UnOp(op, exp) |
      (inst, idx, v, meth) in ?sf._AssignUnop,
      (inst, op) in ?sf._OperatorAt,
      exp in getOperand(inst, 1)
  } ++ {
    exp |
      (inst, idx, from, v, meth) in ?sf._AssignLocal,
      isPhiInstruction(inst) == false,
      exp in assignExp(from)
  } ++ { // we do not inline results of phi functions
    Var(v) |
      (inst, idx, from, v, meth) in ?sf._AssignLocal,
      isPhiInstruction(inst)
  } ++ {
    // TODO maybe remove the method prefix from the variable name
    Var(v) | (idx, meth, v) in ?sf._FormalParam
  } ++ {
    Cast(exp, ty) |
      (inst, idx, from, v, ty, meth) in ?sf._AssignCast,
      exp in assignExp(from)
  } ++ {
    InstanceOf(exp, ty) |
      (inst, idx, from, v, ty, meth) in ?sf._AssignInstanceOf,
      exp in assignExp(from)
  } ++ {
    Null() | (inst, idx, v, meth) in ?sf._AssignNull
  } ++ {
    This() | (meth, v) in ?sf._ThisVar
  } ++ {
    Alloc(heap, ty) |
      (inst1, idx1, heap, v, meth, line) in ?sf._AssignHeapAllocation,
      (v, ty) in ?sf._Var_Type,
      (inst2, idx2, specialmeth, v, meth) not in ?sf._SpecialMethodInvocation
  } ++ {
    SpecialAlloc(heap, specialmeth, args) |
      (inst1, idx1, heap, v, meth, line) in ?sf._AssignHeapAllocation,
      (inst2, idx2, specialmeth, v, callingMeth) in ?sf._SpecialMethodInvocation,
      args in getArgs(inst2, 0)
  } ++ {
    ArrayRead(exp, NumLit(toString(index))) |
       (inst, idx, v, from, meth) in ?sf._LoadArrayIndex,
       exp in assignExp(from),
       (inst, index) in ?sf._ArrayNumIndex
  } ++ {
    ArrayRead(exp, indexExp) |
       (inst, idx, v, from, meth) in ?sf._LoadArrayIndex,
       (inst, indexVar) in ?sf._ArrayInsnIndex,
       exp in assignExp(from),
       indexExp in assignExp(indexVar)
  } ++ {
    Invoke(recvExp, meth, args) |
      (inst, v) in ?sf._AssignReturnValue,
      (inst, idx, meth, recv, callingMeth) in ?sf._VirtualMethodInvocation,
      recvExp in assignExp(recv),
      args in getArgs(inst, 0)
  } ++ {
    SuperInvoke(recvExp, meth, args) |
      (inst, v) in ?sf._AssignReturnValue,
      (inst, idx, meth, recv, callingMeth) in ?sf._SuperMethodInvocation,
      recvExp in assignExp(recv),
      args in getArgs(inst, 0)
  } ++ {
    SpecialInvoke(recvExp, meth, args) |
      (inst, v) in ?sf._AssignReturnValue,
      (inst, idx, meth, recv, callingMeth) in ?sf._SpecialMethodInvocation,
      recvExp in assignExp(recv),
      args in getArgs(inst, 0)
  } ++ {
    StaticInvoke(meth, args) |
      (inst, v) in ?sf._AssignReturnValue,
      (inst, idx, meth, callingMeth) in ?sf._StaticMethodInvocation,
      args in getArgs(inst, 0)
  } ++ {
    DynamicInvoke(bootmeth, dynname, args) |
      (inst, v) in ?sf._AssignReturnValue,
      (inst, idx, bootmeth, dynname, dynretty, dynarity, dynparamtys, tag, callingMeth) in ?sf._DynamicMethodInvocation,
      args in getArgs(inst, 0)
  } ++ {
    InstanceFieldRead(recvExp, field) |
      (inst, idx, v, recv, field, meth) in ?sf._LoadInstanceField,
      recvExp in assignExp(recv)
  } ++ {
    StaticFieldRead(fieldsig) | (inst, idx, v, fieldsig, meth) in ?sf._LoadStaticField
  } ++ { // TODO order of caught exceptions????
    CaughtException(ex) |
      (handler, v) in ?sf.ExceptionHandler_FormalParam,
      (handler, _, _, ex, _, _) in ?sf._ExceptionHandler
  }

