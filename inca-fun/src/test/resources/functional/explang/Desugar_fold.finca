module Desugar

/*
 * This is a nice example to show why we need inter-relation constant propagation at all layers.
 * Consider this simplified version of the program below:
 * data Value = VBool(Boolean) | VErr(String)
 *
 *   data Exp = True() | False() | And(Exp, Exp)
 *   data Type = TBool() | TErr(String)
 *
 *   def foldExp[T](expr: Exp, boolF: Boolean => T, andF: (T, T) => T): T = expr match
 *       case True()  => boolF(true)
 *       case False() => boolF(false)
 *       case And(lhs, rhs) => andF(foldExp[T](lhs, boolF, andF), foldExp[T](rhs, boolF, andF))
 *
 *   def assertBinOp(lhsTy: Type, rhsTy: Type, expected: Type): Type =
 *       if ((lhsTy == rhsTy) && rhsTy == expected) expected
 *       else TErr("Invalid binary op")
 *
 *   def assertBoolBinOp(lhsTy: Type, rhsTy: Type): Type = assertBinOp(lhsTy, rhsTy, TBool())
 *
 *   def typecheck(expr: Exp): Type = foldExp[Type](expr, (b: Boolean) => TBool(), assertBoolBinOp)
 *
 * 1. With intra-relational reasoning, we can not figure out anything about (b: Boolean) => TBool().
      That is, we always get Top for the argument.
 * 2. With inter-relational reasoning after lowering, we can figure out that (b: Boolean) => TBool(),
 *    will always produce TBool(). However, at that point we already defunctionalized the lambda expression.
 *    That is, we created an ADT and a corresponding case for the lambda function. We can not get rid of it anymore.
 * Solution:
 *    With inter-relational reasoning before lowering, we can figure out that (b: Boolean) => TBool() is always TBool(),
 *    and we can remove it before we defunctionalized it!
*/

data Value = VNum(Int) | VBool(Boolean) | VErr(String)

data Exp = BoolLit(Boolean) |
           And(Exp, Exp) |
           Not(Exp) |
           If(Exp, Exp, Exp) |
           NumLit(Int) |
           Plus(Exp, Exp) |
           Mult(Exp, Exp) |
           // These are syntactic sugar – we desugar them into core terms
           Or(Exp, Exp) |
           BiImplication(Exp, Exp) |
           Implication(Exp, Exp)

data Type = TInt() | TBool() | TErr(String)

@fold
def foldExp[T](
    expr: Exp,
    numF: Int => T,
    boolF: Boolean => T,
    andF: (T, T) => T,
    orF: (T, T) => T,
    notF: T => T,
    condF: (T, T, T) => T,
    plusF: (T, T) => T,
    multF: (T, T) => T,
    implF: (T, T) => T,
    biimplF: (T, T) => T
): T = expr match {
  case BoolLit(b) => boolF(b)
  case NumLit(n) => numF(n)
  case And(lhs, rhs) =>
    andF(
      foldExp[T](lhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](rhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
  case Or(lhs, rhs) =>
    orF(
      foldExp[T](lhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](rhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
  case Not(e) =>
    notF(foldExp[T](e, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF))
  case If(cond, thenE, elseE) =>
    condF(
      foldExp[T](cond, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](thenE, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](elseE, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
  case Plus(lhs, rhs) =>
    plusF(
      foldExp[T](lhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](rhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
  case Mult(lhs, rhs) =>
    multF(
      foldExp[T](lhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](rhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
  case Implication(lhs, rhs) =>
    implF(
      foldExp[T](lhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](rhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
  case BiImplication(lhs, rhs) =>
    biimplF(
      foldExp[T](lhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF),
      foldExp[T](rhs, numF, boolF, andF, orF, notF, condF, plusF, multF, implF, biimplF)
    )
}

def assertUnaryOp(ty: Type, expected: Type): Type =
    if (ty == expected)
        expected
    else
        TErr("Invalid unary op")

def assertBinOp(lhsTy: Type, rhsTy: Type, expected: Type): Type =
    if ((lhsTy == rhsTy) && rhsTy == expected)
        expected
    else
        TErr("Invalid binary op")

def assertBoolBinOp(lhsTy: Type, rhsTy: Type): Type =
    assertBinOp(lhsTy, rhsTy, TBool())

def assertBoolUnaryOp(ty: Type): Type =
   assertUnaryOp(ty, TBool())

def assertNumBinOp(lhsTy: Type, rhsTy: Type): Type =
   assertBinOp(lhsTy, rhsTy, TInt())

def typecheck(expr: Exp): Type =
    foldExp[Type](
        expr,
        (n: Int) => TInt(),
        (b: Boolean) => TBool(),
        assertBoolBinOp,
        assertBoolBinOp,
        assertBoolUnaryOp,
        (conTy: Type, thnTy: Type, elsTy: Type) => conTy match {
            case TBool() => assertBinOp(thnTy, elsTy, thnTy)
            case TInt() => TErr("If condition must be a boolean")
            case TErr(msg) => TErr(msg)
        },
        assertNumBinOp,
        assertNumBinOp,
        assertBoolBinOp,
        assertBoolBinOp
    )

