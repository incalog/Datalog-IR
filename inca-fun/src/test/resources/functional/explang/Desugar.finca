module Desugar

data Value = VNum(Int) | VBool(Boolean) | VErr(String)

data Exp = BoolLit(Boolean) |
           And(Exp, Exp) |
           Not(Exp) |
           If(Exp, Exp, Exp) |
           NumLit(Int) |
           Plus(Exp, Exp) |
           Mult(Exp, Exp) |
           Or(Exp, Exp) |
           BiImplication(Exp, Exp) |
           Implication(Exp, Exp)

data Type = TInt() | TBool() | TErr(String)

def typecheckBinOpWithExpected(lhs: Exp, rhs: Exp, expected: Type): Type =
    typecheckBinOp(lhs, rhs) match {
        case TErr(msg) =>
            TErr(msg)
        case TBool() =>
            if (expected == TBool()) TBool()
            else TErr("Expected bool, but got int")
        case TInt() =>
            if (expected == TInt()) TInt()
            else TErr("Expected int, but got bool")
    }

def typecheckBinOp(lhs: Exp, rhs: Exp): Type =
    let lTy = typecheck(lhs) in
    let rTy = typecheck(rhs) in
    if (lTy == rTy)
        lTy
    else
        TErr("Left and right hand side types do not match")

@fold
def typecheck(expr: Exp): Type = expr match {
  case BoolLit(b) => TBool()
  case Not(e) => typecheck(e) match {
    case TBool() => TBool()
    case TInt() => TErr("Expected bool, but got int")
    case TErr(msg) => TErr(msg)
  }
  case And(lhs, rhs) => typecheckBinOpWithExpected(lhs, rhs, TBool())
  case Or(lhs, rhs) => typecheckBinOpWithExpected(lhs, rhs, TBool())
  case Implication(lhs, rhs) => typecheckBinOpWithExpected(lhs, rhs, TBool())
  case BiImplication(lhs, rhs) => typecheckBinOpWithExpected(lhs, rhs, TBool())
  case If(cond, thenExpr, elseExpr) => typecheck(cond) match {
    case TBool() => typecheckBinOp(thenExpr, elseExpr) match {
        case TBool() => TBool()
        case TInt() => TInt()
        case TErr(msg) => TErr(msg)
    }
    case TInt() => TErr("Expected bool, but got int")
    case TErr(msg) => TErr(msg)
  }
  case NumLit(n) => TInt()
  case Plus(lhs, rhs) => typecheckBinOpWithExpected(lhs, rhs, TInt())
  case Mult(lhs, rhs) => typecheckBinOpWithExpected(lhs, rhs, TInt())
}

