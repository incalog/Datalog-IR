@main def main(endNode: Int, step: Int): Set[String] = {
  val generate = new GenerateProgram()
  val defs: DefList = generate.prog(0, 2, 1)
  //val defs: DefList = generate.prog()

  val main: Def = defs.head()
  val prog: Prog = new Prog(defs)

  val resolving = new NameAnalysis(prog)
  prog.accept(resolving)

  val depending = new DependencyAnalysis()
  main.accept(depending)

  val depResult = depending.dependencies(main)
  for (dep <- depResult) yield dep.name
}