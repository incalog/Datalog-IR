module WhileLang

// Mark: - Lattice

class Sign {
  def joined(that: Sign): Sign = this
  def add(that: Sign): Sign = this
  def sub(that: Sign): Sign = this
  def mul(that: Sign): Sign = this
  def gt(that: Sign): Sign = this
  def stringValue(): String = "Sign"
}

case class Bot extends Sign {
  override def joined(that: Sign): Sign = that
  override def stringValue(): String = "Bot"
}

case class Top extends Sign {
  override def joined(that: Sign): Sign = this
  override def stringValue(): String = "Top"
}

case class Pos extends Sign {
  override def joined(that: Sign): Sign = {
    if (that.isInstanceOf[Pos] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }
  override def add(that: Sign): Sign = {
    if (that.isInstanceOf[Pos] || that.isInstanceOf[Zero] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }
  override def sub(that: Sign): Sign = {
    if (that.isInstanceOf[Neg] || that.isInstanceOf[Zero] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }
  override def mul(that: Sign): Sign = {
    if (that.isInstanceOf[Neg] || that.isInstanceOf[Zero] || that.isInstanceOf[Pos])
      return that
    else
      return new Top()
  }
  override def stringValue(): String = "Pos"
}

case class Neg extends Sign {
  override def joined(that: Sign): Sign = {
    if (that.isInstanceOf[Neg] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }

  override def add(that: Sign): Sign = {
    if (that.isInstanceOf[Neg] || that.isInstanceOf[Zero] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }

  override def sub(that: Sign): Sign = {
    if (that.isInstanceOf[Pos] || that.isInstanceOf[Zero] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }

  override def mul(that: Sign): Sign = {
    if (that.isInstanceOf[Neg])
      return new Pos()
    else if (that.isInstanceOf[Pos] || that.isInstanceOf[Bot])
      return this
    else if (that.isInstanceOf[Zero])
      return that
    else
      return new Top()
  }

  override def stringValue(): String = "Neg"
}

case class Zero extends Sign {
  override def joined(that: Sign): Sign = {
    if (that.isInstanceOf[Zero] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }
  override def add(that: Sign): Sign = that
  override def sub(that: Sign): Sign = {
    if (that.isInstanceOf[Neg])
      return new Pos()
    else if (that.isInstanceOf[Pos])
      return new Neg()
    else if (that.isInstanceOf[Zero] || that.isInstanceOf[Bot])
      return this
    else
      return new Top()
  }
  override def mul(that: Sign): Sign = this
  override def stringValue(): String = "Zero"
}

// Mark: - Expression

class Exp {
    // abstract
    def accept(v: Visitor): Unit = { }
    def aevalSign(p: ValueManager, s: Stm): Sign = new Bot()
    def stringValue(): String = "Exp"
}

class Var(val name: String) extends Exp {
    override def accept(v: Visitor): Unit = v.visitVar(this)
    override def aevalSign(p: ValueManager, s: Stm): Sign = p.get(s, this.name)
    override def stringValue(): String = "Var(" + this.name + ")"
}

class Num(val num: Int) extends Exp {
    override def accept(v: Visitor): Unit = v.visitNum(this)

    override def aevalSign(p: ValueManager, s: Stm): Sign = {
        if (this.num == 0)
            return new Zero()
        else if (this.num > 0)
            return new Pos()
        else
            return new Neg()
    }

    override def stringValue(): String = {
        val n: Int = this.num
        "Num(" + n.toString() + ")"
    }
}

class BinOp(val left: Exp, val right: Exp) extends Exp {
  override def accept(v: Visitor): Unit = {
      this.left.accept(v)
      this.right.accept(v)
      this.binOpAccept(v)
  }
  // abstract
  def binOpAccept(v: Visitor): Unit = { }

  override def aevalSign(p: ValueManager, s: Stm): Sign = {
    this.binOpConst(this.left.aevalSign(p, s), this.right.aevalSign(p, s))
  }
  // abstract
  def binOpConst(c1: Sign, c2: Sign): Sign = c1
}

class Add(val left: Exp, val right: Exp) extends BinOp(left, right) {
  override def binOpAccept(v: Visitor): Unit = v.visitAdd(this)
  override def binOpConst(c1: Sign, c2: Sign): Sign = c1.add(c2)
  override def stringValue(): String = "Add(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
}

class Sub(val left: Exp, val right: Exp) extends BinOp(left, right) {
  override def binOpAccept(v: Visitor): Unit = v.visitSub(this)
  override def binOpConst(c1: Sign, c2: Sign): Sign = c1.sub(c2)
  override def stringValue(): String = "Sub(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
}

class Mul(val left: Exp, val right: Exp) extends BinOp(left, right) {
  override def binOpAccept(v: Visitor): Unit = v.visitMul(this)
  override def binOpConst(c1: Sign, c2: Sign): Sign = c1.mul(c2)
  override def stringValue(): String = "Mul(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
}

class GT(val left: Exp, val right: Exp) extends BinOp(left, right) {
  override def binOpAccept(v: Visitor): Unit = v.visitGT(this)
  override def binOpConst(c1: Sign, c2: Sign): Sign = c1.gt(c2)
  override def stringValue(): String = "GT(" + this.left.stringValue() + ", " + this.right.stringValue() + ")"
}

// Mark: - Statements

class Stm {
    // abstract
    def accept(v: Visitor): Unit = { }
    def first(): Stm = this
    //def last(): Set[Stm] = Set(this)
    def last(): Stm = this
    def stringValue(): String = "Stm"
    // Default: Preserve all variables
    def transfer(from: Stm, manager: ValueManager): Unit = manager.transferAll(from, this)
}

class Assign(val name: String, val rhs: Exp) extends Stm {
  override def accept(v: Visitor): Unit = {
      this.rhs.accept(v)
      v.visitAssign(this)
  }
  override def stringValue(): String = "Assign(" + this.name + ", " + this.rhs.stringValue() + ")"
  override def transfer(from: Stm, manager: ValueManager): Unit = {
      manager.transferAll(from, this)
      manager.put(this, this.name, this.rhs.aevalSign(manager, from))
  }
}

class Skip extends Stm {
  override def accept(v: Visitor): Unit = v.visitSkip(this)
  override def stringValue(): String = "Skip"
  override def transfer(from: Stm, manager: ValueManager): Unit = manager.transferAll(from, this)
}

class Sequence(val s1: Stm, val s2: Stm) extends Stm {
  override def accept(v: Visitor): Unit = {
    this.s1.accept(v)
    this.s2.accept(v)
    v.visitSequence(this)
  }
  override def first(): Stm = this.s1.first()
  //override def last(): Set[Stm] = this.s2.last()
  override def last(): Stm = this.s2.last()
  override def stringValue(): String = "Sequence(" + this.s1.stringValue() + ", " + this.s2.stringValue() + ")"
  override def transfer(from: Stm, manager: ValueManager): Unit = {
    // Does not occur
  }
}

