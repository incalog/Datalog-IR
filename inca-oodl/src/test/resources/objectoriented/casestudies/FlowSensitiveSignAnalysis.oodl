class While(val cnd: Exp, val body: Stm) extends Stm {
  override def accept(v: Visitor): Unit = {
    this.cnd.accept(v)
    this.body.accept(v)
    v.visitWhile(this)
  }

  override def stringValue(): String = "While(" + this.cnd.stringValue() + ", " + this.body.stringValue() + ")"
  override def transfer(from: Stm, manager: ValueManager): Unit = {
    manager.transferAll(from, this)
    manager.transferAll(from, this.body.first())

    fix manager.transferAll(this.body.last(), this)
    fix manager.transferAll(this.body.last(), this.body.first())
    /*for (l2 <- this.body.last()) yield
      manager.transferAll(l2, this)
    for (l <- this.body.last()) yield
      manager.transferAll(l, this.body.first())*/

    return
  }
}

class ValDef(val name: String, val rhs: Exp) extends Stm {
  override def accept(v: Visitor): Unit = {
    this.rhs.accept(v)
    v.visitValDef(this)
  }

  override def stringValue(): String = "ValDef(" + this.name + ", " + this.rhs.stringValue() + ")"

  override def transfer(from: Stm, manager: ValueManager): Unit = {
    manager.transferAll(from, this)
    manager.put(this, this.name, this.rhs.aevalSign(manager, from))
  }
}

class VarDef(val name: String, val rhs: Exp) extends Stm {
  override def accept(v: Visitor): Unit = {
    this.rhs.accept(v)
    v.visitVarDef(this)
  }

  override def stringValue(): String = "VarDef(" + this.name + ", " + this.rhs.stringValue() + ")"
  override def transfer(from: Stm, manager: ValueManager): Unit = {
    manager.transferAll(from, this)
    manager.put(this, this.name, this.rhs.aevalSign(manager, from))
  }
}

// Mark: - CFG

class Visitor {
    // Exp
    def visitVar(e: Var): Unit = { }
    def visitNum(e: Num): Unit = { }
    def visitAdd(e: Add): Unit = { }
    def visitSub(e: Sub): Unit = { }
    def visitMul(e: Mul): Unit = {}
    def visitGT(e: GT): Unit = {}

    // Stm
    def visitAssign(s: Assign): Unit = { }
    def visitSkip(s: Skip): Unit = { }
    def visitSequence(s: Sequence): Unit = { }
    //def visitIf(s: If): Unit = { }
    def visitWhile(s: While): Unit = { }
    def visitValDef(s: ValDef): Unit = { }
    def visitVarDef(s: VarDef): Unit = { }
}

class CfgVisitor extends Visitor {
  var cfg: mono.Set[(Stm, Stm)] = new mono.Set[(Stm, Stm)]()

  def addPath(from: Stm, to: Stm): Unit = {
    this.cfg += (from, to)
  }

  override def visitSequence(s: Sequence): Unit = {
    val to: Stm = s.s2.first()
    this.addPath(s.s1.last(), to)
    /*for (from <- s.s1.last())
        yield this.addPath(from, to)*/
    return
  }

  /*override def visitIf(s: If): Unit = {
    this.cfg += (s, s.thn.first())
    this.cfg += (s, s.els.first())
  }*/

  override def visitWhile(s: While): Unit = {
    this.addPath(s, s.body.first())
    this.addPath(s.body.last(), s)
    /*for (from <- s.body.last())
        yield this.addPath(from, s)*/
    return
  }
}

// Mark: - Sign Analysis

class ValueManager {
    def get(s: Stm, v: String): Sign = new Bot()
    def put(s: Stm, v: String, m: Sign): Unit = { }
    def transferAll(from: Stm, to: Stm): Unit = { }
}

class MSign extends mono.Type[Sign, Sign, Sign] {
  def init: Sign = new Bot()
  def +=(state: Sign, v: Sign): Sign = state.joined(v)
  def result(state: Sign): Sign = state
}

class FSSignAnalysis(val head: Stm, val cfg: mono.Set[(Stm, Stm)], val varNames: Set[String]) extends ValueManager {
    val after: mono.Map[Stm, mono.Map[String, MSign]] = new mono.Map[Stm, mono.Map[String, MSign]]()

    override def get(s: Stm, v: String): Sign = this.after.get(s, v)

    override def put(s: Stm, v: String, m: Sign): Unit = {
      this.after += (s, (v, m))
    }

    def run(): Unit = {
      val start: Stm = new Skip()
      for (v <- this.varNames) yield
        this.put(start, v, new Bot())
      this.head.transfer(start, this)
      this.iterate()
      return
    }

    def iterate(): Unit = {
      for (e <- this.cfg)
          yield e._2.transfer(e._1, this)
      return
    }

    override def transferAll(from: Stm, to: Stm): Unit = {
      for (y <- this.varNames) yield
          this.put(to, y, this.get(from, y))
      return
    }
}


class Examples {
    /*def factorial(): Stm =
        new Sequence(new VarDef("n", new Num(5)),
            new Sequence(new VarDef("acc", new Num(1)),
                new While(
                    new GT(new Var("n"), new Num(1)),
                    new Sequence(
                        new Assign("acc", new Mul(new Var("acc"), new Var("n"))),
                        new Assign("n", new Sub(new Var("n"), new Num(1)))
                    )
                )
            )
        )

    def assignments(): Stm =
        new Sequence(new VarDef("m", new Num(3)),
            new Sequence(new Assign("m", new Num(2)),
                new Sequence(
                    new VarDef("n", new Num(5)),
                    new ValDef("acc", new Num(1))
                )
            )
        )*/

    //TODO: Functions are faste then values. Why ?
    def simpleAssignments(): Stm =
        new Sequence(
            new ValDef("n", new Num(5)),
            new ValDef("acc", new Num(1))
        )
}

@main
def main(): Set[(String, String, String)] = {
  // TODO: Automatically get all vars
  val varNames: Set[String] = Set("n", "acc")

  val examples: Examples = new Examples()
  val prog: Stm = examples.simpleAssignments()

  // Calculate CFG
  val cfgVisitor = new CfgVisitor()
  prog.accept(cfgVisitor)

  // Do sign anaylsis
  val signAna: FSSignAnalysis = new FSSignAnalysis(prog.first(), cfgVisitor.cfg, varNames)
  signAna.run()

  val firstRes = for (v <- varNames)
    yield (prog.first().stringValue(), v, signAna.after.get(prog.first(), v).stringValue())

  val tailRes = for (s <- cfgVisitor.cfg; v <- varNames)
    yield (s._2.stringValue(), v, signAna.after.get(s._2, v).stringValue())

  firstRes ++ tailRes
}

