module TypeCast

class A
class B extends A
class C1 extends B
class C2 extends B

@main
def main(): Boolean = {
    val a: A = new A()
    val b: B = new B()
    val c1: C1 = new C1()
    val c2: C2 = new C2()

    // cast to supertype should always work
    a.asInstanceOf[A]
    b.asInstanceOf[A]
    b.asInstanceOf[B]
    c1.asInstanceOf[A]
    c1.asInstanceOf[B]
    c1.asInstanceOf[C1]
    c2.asInstanceOf[A]
    c2.asInstanceOf[B]
    c2.asInstanceOf[C2]

    // some more test
    val aFromC2: A = c2.asInstanceOf[A]
    val c2FromA: C2 = aFromC2.asInstanceOf[C2]
    val bFromA: B = aFromC2.asInstanceOf[B]

    // if any of the cast fails we will never reach this part
    return true
}