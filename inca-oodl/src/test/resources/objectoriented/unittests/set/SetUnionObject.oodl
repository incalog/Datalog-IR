module SetUnionObjectTest

class Num(val value: Int)

@main def main(): Set[Int] = {
  val n1 = new Num(1)
  val n2 = new Num(2)
  val n3 = new Num(3)
  val n4 = new Num(4)
  val a: Set[Num] = Set(n1, n2)
  val b: Set[Num] = Set(n3, n4)
  val union: Set[Num] = a ++ b
  for (n <- union) yield n.value
}