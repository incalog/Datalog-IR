module SetTest

class Num(var value: Int)

class Integer(value: Int) extends Num(value)

class A {
  def bounded(as: Set[Num]): Set[Integer] = {
    return for (a <- as if a.value < 11) yield a.asInstanceOf[Integer]
  }
}

@main def main(): Set[Int] = {
  val a: A = new A()
  val i1 = new Integer(10)
  val i2 = new Integer(5)
  val i3 = new Integer(11)
  return for (v <- a.bounded(Set(i1, i2, i3))) yield v.value
}