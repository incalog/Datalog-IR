module SetTest

class Num(value: Int)

class A {
  def getValue(nums: Set[Num]): Set[Int] = {
    return for (n <- nums if n.value < 3) yield n.value
  }
}

@main def main(): Set[Int] = {
    val n1 = new Num(1)
    val n2 = new Num(2)
    val n3 = new Num(3)
    return new A().getValue(Set(n1, n2, n3))
}