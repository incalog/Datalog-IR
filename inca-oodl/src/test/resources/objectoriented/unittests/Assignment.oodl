module VarAssignment

class A(var v: Int)

@main
def main(p: Int): Boolean = {
  val a: A = new A(3)
  var b: A = a
  a.v = 4

  var x = 10
  val xIs10: Boolean = (x == 10)

  x = 5
  // For some reason inlining af is not possible in a boolean expression
  val av = a.v
  val bv = b.v
  return xIs10 && (x == 5) && (av == bv) && (av == 4)
}